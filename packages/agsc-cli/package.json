{
    "name": "agsc-cli",
    "version": "1.0.0-rc.6",
    "description": "`agsc` \u2014 the short command name for the AgenticSystemCore engine. This package is an alias: it installs `agentic-system-core` at the exact same version and forwards every verb to it.",
