        "agsc": "bin/agsc.js"
    },
    "files": [
        "bin",
        "README.md",
        "NOTICE"
    ],
    "engines": {
        "node": ">=22.13.0"
    },
    "dependencies": {
        "agentic-system-core": "1.0.0-rc.6"
    },
    "keywords": [
        "agentic",
        "agentic-memory",
        "knowledge-web",
        "ontologies",
        "agsc"
    ],
    "author": "Andrei N. Besleaga",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/andreibesleaga/agentic-system-core.git",
        "directory": "packages/agsc-cli"
    },
    "homepage": "https://agenticsystemcore.com",
    "bugs": {
        "url": "https://github.com/andreibesleaga/agentic-system-core/issues"
    }
}
