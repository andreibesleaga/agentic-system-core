#!/usr/bin/env node
// The claims lint of the benchmark kit (docs/BENCHMARKS.md, "How results may be
// described"). It fails a results page, a README table or a results file that
// words a measurement as a ranking, or prints a number a reader cannot trace.
//
//   lint-claims [--json] [--results <file>]... [--help] <file>...
//
// Text files (Markdown, HTML, plain text). Only the claims regions are read when
// a file marks any — the lines between `<!-- claims:start -->` and
// `<!-- claims:end -->` — so a README is held to the rule where it reports
// results and nowhere else; a file with no marker is read whole. In what is read,
// each of these words is a finding (AGSC-E405): "first", "unique", a hundred per
// cent written as a number, "#1", "SOTA", "beat(s)", "win(s)".
//
// Results files (JSON, `{ "rows": [...] }`). Every row must name its `model`, its
// `date` (YYYY-MM-DD), its sample size `n` (a positive integer), its `metric`, its
// `value` and a confidence interval `ci: [low, high]` with low ≤ high. A row that
// compares with another system (`system` other than "agentic-system-core") must
// carry both configurations in `configs`, one per system. Each missing member is
// a finding (AGSC-E202).
//
// Exit 0 pass, 1 findings, 2 usage.
'use strict';
const fs = require('fs');

const HELP = `lint-claims [--json] [--results <file>]... [--help] <file>...

  Fails text that words a measurement as a ranking, and results rows a reader
  cannot trace (model, date, n, metric, value, confidence interval; both
  configurations for a cross-system row).

  <file>            a Markdown, HTML or text file; only its claims regions
                    (<!-- claims:start --> ... <!-- claims:end -->) are read
                    when it marks any, otherwise the whole file
  --results <file>  a results file, { "rows": [...] }; may be given more than once
  --json            emit the envelope on stdout
  --help            this text

  Exit 0 pass, 1 findings, 2 usage.
`;

const OWN_SYSTEM = 'agentic-system-core';
const START = '<!-- claims:start -->';
const END = '<!-- claims:end -->';

/** The forbidden wording: [label, pattern]. Each pattern is global and case-blind. */
const WORDING = [
  ['"first"', /\bfirst\b/giu],
  ['"unique"', /\bunique\b/giu],
  ['a hundred per cent', /(?<![\w.])100\s?%/gu],
  ['"#1"', /#1\b/gu],
  ['"SOTA"', /\bSOTA\b/giu],
  ['"beat(s)"', /\bbeats?\b/giu],
  ['"win(s)"', /\bwins?\b/giu],
];

const DATE = /^\d{4}-\d{2}-\d{2}$/u;

function finding(code, file, line, col, message) {
  return { code, col, file, line, message, severity: 'error' };
}

/**
 * The lines of `text` that are read, as [lineNumber, line] pairs, plus a finding
 * for a claims region that is opened and never closed.
 */
function readLines(file, text) {
  const lines = text.split('\n');
  if (!lines.some((l) => l.includes(START))) return { findings: [], lines: lines.map((l, i) => [i + 1, l]) };
  const kept = [];
  let openedAt = 0;
  lines.forEach((line, i) => {
    if (line.includes(START)) openedAt = i + 1;
    else if (line.includes(END)) openedAt = 0;
    else if (openedAt > 0) kept.push([i + 1, line]);
  });
  const findings = openedAt > 0
    ? [finding('AGSC-E202', file, openedAt, 1, `the claims region opened here has no ${END}`)]
    : [];
  return { findings, lines: kept };
}

/** Forbidden wording in one text file. */
function lintText(file, text) {
  const { findings, lines } = readLines(file, text);
  for (const [number, line] of lines) {
    for (const [label, pattern] of WORDING) {
      for (const match of line.matchAll(pattern)) {
        findings.push(finding('AGSC-E405', file, number, match.index + 1,
          `${label} words a measurement as a ranking; state the measured difference with its model, date, n and interval`));
      }
    }
  }
  return findings;
}

/** The members one row is missing, as messages. */
function rowProblems(row) {
  const problems = [];
  if (typeof row.model !== 'string' || row.model === '') problems.push('names no model');
  if (typeof row.date !== 'string' || !DATE.test(row.date)) problems.push('carries no date (YYYY-MM-DD)');
  if (!Number.isInteger(row.n) || row.n < 1) problems.push('carries no sample size n');
  if (typeof row.metric !== 'string' || row.metric === '') problems.push('names no metric');
  if (typeof row.value !== 'number') problems.push('carries no numeric value');
  const ci = row.ci;
  if (!Array.isArray(ci) || ci.length !== 2 || !ci.every((x) => typeof x === 'number') || ci[0] > ci[1]) {
    problems.push('carries no confidence interval [low, high]');
  }
  if (row.system !== undefined && row.system !== OWN_SYSTEM) {
    const configs = row.configs || {};
    for (const system of [OWN_SYSTEM, row.system]) {
      if (!configs[system]) problems.push(`compares with ${row.system} but publishes no configuration for ${system}`);
    }
  }
  return problems;
}

/** Untraceable rows in one results file. */
function lintResults(file, text) {
  let data;
  try {
    data = JSON.parse(text);
  } catch (e) {
    return [finding('AGSC-E202', file, 1, 1, `not JSON: ${e.message}`)];
  }
  if (!data || !Array.isArray(data.rows)) return [finding('AGSC-E202', file, 1, 1, 'holds no rows[] array')];
  return data.rows.flatMap((row, i) => rowProblems(row || {})
    .map((problem) => finding('AGSC-E202', file, 1, 1, `row ${i} ${problem}`)));
}

/** The arguments, or a usage message. */
function parse(argv) {
  const options = { help: false, json: false, results: [], texts: [] };
  for (let i = 0; i < argv.length; i += 1) {
    const arg = argv[i];
    if (arg === '--help' || arg === '-h') options.help = true;
    else if (arg === '--json') options.json = true;
    else if (arg === '--results') {
      i += 1;
      if (argv[i] === undefined) return { error: '--results needs a file (AGSC-E003)' };
      options.results.push(argv[i]);
    } else if (arg.startsWith('-')) return { error: `unknown flag ${arg} (AGSC-E002)` };
    else options.texts.push(arg);
  }
  if (!options.help && options.texts.length + options.results.length === 0) {
    return { error: 'nothing to lint: name a file or a --results file (AGSC-E003)' };
  }
  return { options };
}

/** Every input read and linted; an unreadable one is itself a finding. */
function lintAll(options) {
  const inputs = [...options.texts.map((f) => [f, lintText]), ...options.results.map((f) => [f, lintResults])];
  let read = 0;
  const findings = inputs.flatMap(([file, lint]) => {
    let text;
    try {
      text = fs.readFileSync(file, 'utf8');
    } catch {
      return [finding('AGSC-E901', file, 1, 1, 'cannot be read')];
    }
    read += 1;
    return lint(file, text);
  });
  return { findings, read };
}

/**
 * @param {string[]} argv
 * @param {{out:(s:string)=>void, err:(s:string)=>void}} [io]
 * @returns {number} exit code: 0 pass, 1 findings, 2 usage
 */
function run(argv, io) {
  const out = (io && io.out) || ((s) => process.stdout.write(s));
  const err = (io && io.err) || ((s) => process.stderr.write(s));
  const parsed = parse(argv);
  if (parsed.error) { err(`lint-claims: ${parsed.error}\n${HELP}`); return 2; }
  if (parsed.options.help) { out(HELP); return 0; }

  const { findings, read } = lintAll(parsed.options);
  const status = findings.length === 0 ? 'pass' : 'fail';
  if (parsed.options.json) {
    out(`${JSON.stringify({
      counts: { error: findings.length, warn: 0 },
      findings,
      inputs_read: read,
      schema: 'agsc.lint-claims.v1',
      status,
      verb: 'lint-claims',
    }, null, 2)}\n`);
  } else {
    for (const f of findings) err(`${f.file}:${f.line}:${f.col} ${f.code} ${f.message}\n`);
    out(`lint-claims ${status}: ${read} input file(s) read, ${findings.length} error(s)\n`);
  }
  return status === 'pass' ? 0 : 1;
}

/* c8 ignore next */
if (require.main === module) process.exit(run(process.argv.slice(2)));

module.exports = { HELP, WORDING, lintResults, lintText, run };
