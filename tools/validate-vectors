#!/usr/bin/env node
'use strict';
// tools/validate-vectors — the conformance-vector validator of AGSC-09-90.
//
// INDEPENDENT BY CONSTRUCTION: Node built-ins only, no import from `src/`, no
// dependency. AGSC-09-90 requires each validator to be runnable standalone so that
// an outside party can check the normative artefacts without trusting this engine;
// a validator that imported the engine it validates would prove nothing.
//
// Checks (each a Finding; any error exits 1):
//   AGSC-E202  a required member of AGSC-09-04 is missing
//   AGSC-E203  `area` outside the closed list of twenty-five (AGSC-09-04);
//              `level` outside required|optional|withdrawn (AGSC-09-05);
//              an `AGSC-E<nnn>` code that spec/09 section 9.4 does not register
//   AGSC-E204  a malformed `id` (`<prefix>-<nnnn>`) or `rule` (`AGSC-nn-nn[a]`)
//   AGSC-E108  encoding: CRLF, a byte-order mark, no single trailing LF, or non-NFC
//              text outside the AGSC-09-06 exemption (an input string whose non-NFC
//              form is the subject of the case)
//   AGSC-E601  object members not in JCS order (AGSC-09-06), except the
//              `input.value` subtree, which is the subject of the jcs vectors
//   AGSC-E201  a `rule` that no spec/*.md defines; a duplicate `id`; a `withdrawn`
//              vector without `reason` or whose `expected` is not {"withdrawn":true}
//   AGSC-E207  (warning) a `note` on a vector that is not marked unreleased
//
// A declared area with no vector file is an INFORMATIONAL count, never a failure
// (AGSC-09-90). An EMPTY vector set, on the other hand, is a failure: a checker that
// reports `pass` over zero files protects nothing.
//
//   validate-vectors [--json] [--quiet] [--plain] [--help] [<dir>]
//
// Exit 0 pass, 1 fail, 2 usage. `run(argv, io)` is exported so a test drives the
// tool in process and observes both streams and the exit code.

const fs = require('node:fs');
const path = require('node:path');

const ROOT = path.resolve(__dirname, '..');

/** AGSC-09-04: the closed list of twenty-five areas, and no others. */
const AREAS = Object.freeze([
  'frontmatter', 'slug', 'links', 'jcs', 'graph', 'lint', 'cli', 'bundle', 'prov',
  'ledger', 'compose', 'build', 'discovery', 'adopt', 'import', 'export', 'skills',
  'adapters', 'channels', 'harness', 'run', 'conform', 'boundary', 'chunks', 'boards',
]);
const REQUIRED_MEMBERS = Object.freeze(['area', 'description', 'expected', 'id', 'input', 'level', 'rule']);
const LEVELS = Object.freeze(['required', 'optional', 'withdrawn']);
/** AGSC-09-06: the two files whose non-NFC input is the subject of the case. */
const NFC_EXEMPT = Object.freeze(['jcs-0005', 'lint-0022']);

const HELP = `validate-vectors [--json] [--quiet] [--plain] [--help] [<dir>]

  Checks every vector file of <dir> against AGSC-09-04/09-05/09-06: the required
  members, the closed area and level lists, the file encoding, JCS member order,
  rule-id and error-code resolution against spec/.

  --json    emit the AGSC-09-11 diagnostics envelope on stdout
  --quiet   emit nothing; the exit code is the result
  --help    this text

  <dir> defaults to tests/vectors/ of the distribution this tool ships in.
  Exit 0 pass, 1 fail, 2 usage.
`;

// ---------------------------------------------------------------------------
// JCS (RFC 8785), the sliver this tool needs: NFC member names, UTF-16 order.
// ---------------------------------------------------------------------------
function canonicalize(value) {
  if (value === null) return 'null';
  if (typeof value === 'boolean') return value ? 'true' : 'false';
  if (typeof value === 'number') return value === 0 ? '0' : String(value);
  if (typeof value === 'string') return JSON.stringify(value);
  if (Array.isArray(value)) return `[${value.map(canonicalize).join(',')}]`;
  const names = Object.keys(value).map((k) => k.normalize('NFC')).sort();
  return `{${names.map((n) => `${JSON.stringify(n)}:${canonicalize(value[n])}`).join(',')}}`;
}

function finding(code, file, message, severity = 'error', line = 1) {
  return { code, col: 1, file, line, message, severity };
}

/** AGSC-09-10: order by (file, line, col, code), compared code-point-wise. */
function compareCodePoint(a, b) {
  const ia = a[Symbol.iterator]();
  const ib = b[Symbol.iterator]();
  for (;;) {
    const x = ia.next();
    const y = ib.next();
    if (x.done && y.done) return 0;
    if (x.done) return -1;
    if (y.done) return 1;
    const cx = x.value.codePointAt(0);
    const cy = y.value.codePointAt(0);
    if (cx !== cy) return cx < cy ? -1 : 1;
  }
}

function walk(dir) {
  return fs.readdirSync(dir, { withFileTypes: true }).flatMap((e) => (e.isDirectory()
    ? walk(path.join(dir, e.name))
    : [path.join(dir, e.name)]));
}

/** Every object in the tree whose member order is not JCS order (AGSC-09-06). */
function orderFaults(node, pointer, out) {
  if (Array.isArray(node)) {
    node.forEach((v, i) => orderFaults(v, `${pointer}/${i}`, out));
    return;
  }
  if (node === null || typeof node !== 'object') return;
  const names = Object.keys(node);
  const sorted = names.map((k) => k.normalize('NFC')).slice().sort();
  if (JSON.stringify(names) !== JSON.stringify(sorted)) out.push(pointer === '' ? '/' : pointer);
  for (const key of names) {
    // AGSC-09-06 exemption: `input.value` carries the order that IS the case.
    if (pointer === '/input' && key === 'value') continue;
    orderFaults(node[key], `${pointer}/${key}`, out);
  }
}

function collectCodes(node, out) {
  if (typeof node === 'string') {
    for (const m of node.matchAll(/AGSC-E\d{3}/gu)) out.add(m[0]);
    return;
  }
  if (Array.isArray(node)) {
    node.forEach((v) => collectCodes(v, out));
    return;
  }
  if (node !== null && typeof node === 'object') {
    for (const k of Object.keys(node)) {
      collectCodes(k, out);
      collectCodes(node[k], out);
    }
  }
}

/**
 * @param {string[]} argv
 * @param {{out:(s:string)=>void, err:(s:string)=>void}} [io]
 * @returns {number} exit code: 0 pass, 1 fail, 2 usage
 */
function run(argv, io) {
  const out = (io && io.out) || ((s) => process.stdout.write(s));
  const err = (io && io.err) || ((s) => process.stderr.write(s));
  const usage = (message) => { err(`validate-vectors: ${message}\n${HELP}`); return 2; };
  const flags = new Set();
  let dir = path.join(ROOT, 'tests', 'vectors');
  for (const arg of argv) {
    if (arg === '--help' || arg === '-h') { out(HELP); return 0; }
    if (arg === '--json' || arg === '--quiet' || arg === '--plain') flags.add(arg);
    else if (arg.startsWith('--')) return usage(`unknown flag ${arg} (AGSC-E002)`);
    else dir = path.resolve(arg);
  }
  // AGSC-09-90 as amended at rc.6: "A validator MUST FAIL, with
  // `AGSC-E901`, when the inputs its contract names are absent". A failure is exit 1
  // and the AGSC-09-11 envelope — not exit 2 and a usage block, which AGSC-09-08
  // reserves for an unknown verb, an unknown flag or a missing argument, and which a
  // caller reading the envelope cannot see at all. The directory is reported as
  // absent here; an empty one is reported by the `files.length === 0` branch below,
  // and both are the same fault to a reader: nothing was looked at.
  const absentDir = !fs.existsSync(dir);

  const specDir = path.join(ROOT, 'spec');
  const specText = fs.readdirSync(specDir).filter((f) => f.endsWith('.md')).sort()
    .map((f) => fs.readFileSync(path.join(specDir, f), 'utf8')).join('\n');
  const ruleIds = new Set((specText.match(/\*\*AGSC-\d{2}-\d{2,3}[a-z]?\*\*/gu) || []).map((s) => s.slice(2, -2)));
  const conformance = fs.readFileSync(path.join(specDir, '09-conformance.md'), 'utf8');
  const registered = new Set((conformance.match(/^\| `AGSC-E\d{3}`/gmu) || [])
    .map((s) => (s.match(/AGSC-E\d{3}/u) || [''])[0]));
  const declaredSpecVersion = (fs.readFileSync(path.join(specDir, '00-overview.md'), 'utf8')
    .match(/1\.0\.0-rc\.\d+/u) || ['unknown'])[0];

  const json = absentDir ? [] : walk(dir).filter((f) => f.endsWith('.json')).sort();
  // a vector tree is `<area>/<prefix>-<nnnn>[-<words>].json`
  // (AGSC-09-04). When NOT ONE file of the directory has that shape, the directory is
  // not a vector tree — a published site, say, whose `/skills/index.json` sits in a
  // folder that happens to share an area's name — and judging its files as vectors
  // would report faults about files this tool has no contract for. It is refused
  // with AGSC-E901, as AGSC-09-90 requires for an input "that carries nothing it can
  // validate". Inside a real vector tree every JSON file is judged, so a misplaced or
  // misnamed vector is still reported.
  const isVectorPath = (absolute) => {
    const parts = path.relative(dir, absolute).split(path.sep);
    return parts.length === 2 && AREAS.includes(parts[0])
      && /^[a-z]+-\d{4}(-[A-Za-z0-9-]+)?\.json$/u.test(parts[1]);
  };
  const vectorTree = json.some(isVectorPath);
  const files = vectorTree ? json : [];
  const findings = [];
  // zero vectors read is a failure, not a clean run.
  if (!absentDir && json.length > 0 && !vectorTree) {
    findings.push(finding('AGSC-E901', path.relative(ROOT, dir).split(path.sep).join('/') || 'tests/vectors',
      `${dir} is not a vector directory: none of its ${json.length} JSON file(s) is an`
        + ' <area>/<prefix>-<nnnn>.json vector, so none was judged (AGSC-09-04, AGSC-09-90)'));
  } else if (files.length === 0) {
    findings.push(finding('AGSC-E901', path.relative(ROOT, dir).split(path.sep).join('/') || 'tests/vectors',
      absentDir
        ? `no such directory: ${dir}: there is nothing to validate (AGSC-09-90)`
        : `no vector file under ${dir}: there is nothing to validate (AGSC-09-90)`));
  }
  if (ruleIds.size === 0) {
    findings.push(finding('AGSC-E901', 'spec/',
      'spec/ declares no rule, so every rule-id resolution below is vacuous (AGSC-09-91)'));
  }
  const seenIds = new Map();
  const areasPresent = new Set();

  for (const absolute of files) {
    const file = path.relative(ROOT, absolute).split(path.sep).join('/');
    const raw = fs.readFileSync(absolute, 'utf8');

    if (raw.charCodeAt(0) === 0xfeff) findings.push(finding('AGSC-E108', file, 'byte-order mark (AGSC-09-06)'));
    if (raw.includes('\r')) findings.push(finding('AGSC-E108', file, 'CR or CRLF line endings (AGSC-09-06)'));
    if (!raw.endsWith('\n') || raw.endsWith('\n\n')) {
      findings.push(finding('AGSC-E108', file, 'the file must end with exactly one LF (AGSC-09-06)'));
    }

    let vector;
    try {
      vector = JSON.parse(raw);
    } catch (e) {
      findings.push(finding('AGSC-E201', file, `not valid JSON: ${e.message}`));
      continue;
    }

    const id = typeof vector.id === 'string' ? vector.id : '(no id)';
    if (raw.normalize('NFC') !== raw && !NFC_EXEMPT.includes(id)) {
      findings.push(finding('AGSC-E108', file,
        'the file is not NFC and is not one of the AGSC-09-06 exemptions'));
    }

    for (const member of REQUIRED_MEMBERS) {
      if (!Object.prototype.hasOwnProperty.call(vector, member)) {
        findings.push(finding('AGSC-E202', file, `required member "${member}" is missing (AGSC-09-04)`));
      }
    }
    if (typeof vector.id === 'string') {
      if (!/^[a-z]+-\d{4}$/u.test(vector.id)) {
        findings.push(finding('AGSC-E204', file, `id "${vector.id}" is not <area-prefix>-<nnnn> (AGSC-09-04)`));
      }
      if (seenIds.has(vector.id)) {
        findings.push(finding('AGSC-E201', file, `duplicate id "${vector.id}", first seen in ${seenIds.get(vector.id)}`));
      } else seenIds.set(vector.id, file);
    }
    if (typeof vector.area === 'string') {
      areasPresent.add(vector.area);
      if (!AREAS.includes(vector.area)) {
        findings.push(finding('AGSC-E203', file, `area "${vector.area}" is outside the closed list of ${AREAS.length} (AGSC-09-04)`));
      }
      const folder = file.split('/').slice(-2)[0];
      if (folder !== vector.area) {
        findings.push(finding('AGSC-E205', file, `area "${vector.area}" disagrees with the folder "${folder}" (AGSC-09-04)`));
      }
    }
    if (typeof vector.level === 'string' && !LEVELS.includes(vector.level)) {
      findings.push(finding('AGSC-E203', file, `level "${vector.level}" is not required|optional|withdrawn (AGSC-09-05)`));
    }
    if (typeof vector.rule === 'string') {
      if (!/^AGSC-\d{2}-\d{2,3}[a-z]?$/u.test(vector.rule)) {
        findings.push(finding('AGSC-E204', file, `rule "${vector.rule}" is not an AGSC-nn-nn id (AGSC-09-05)`));
      } else if (!ruleIds.has(vector.rule)) {
        findings.push(finding('AGSC-E201', file, `rule "${vector.rule}" is defined nowhere in spec/ (AGSC-09-05)`));
      }
    }
    if (vector.level === 'withdrawn') {
      if (typeof vector.reason !== 'string' || vector.reason === '') {
        findings.push(finding('AGSC-E202', file, 'a withdrawn vector MUST carry `reason` (AGSC-09-05)'));
      }
      if (canonicalize(vector.expected) !== '{"withdrawn":true}') {
        findings.push(finding('AGSC-E201', file,
          'a withdrawn vector\'s `expected` MUST be reduced to {"withdrawn": true} (AGSC-09-05)'));
      }
    }
    if (vector.options && vector.options.spec_version !== undefined
        && vector.options.spec_version !== declaredSpecVersion) {
      findings.push(finding('AGSC-E201', file,
        `options.spec_version "${vector.options.spec_version}" differs from the spec/00 declaration "${declaredSpecVersion}" (AGSC-09-91)`));
    }

    const order = [];
    orderFaults(vector, '', order);
    for (const pointer of order) {
      findings.push(finding('AGSC-E601', file, `object members at ${pointer} are not in JCS order (AGSC-09-06)`));
    }

    const codes = new Set();
    collectCodes(vector.expected, codes);
    for (const code of [...codes].sort()) {
      if (!registered.has(code)) {
        findings.push(finding('AGSC-E203', file, `error code ${code} is not registered in spec/09 section 9.4 (AGSC-09-15)`));
      }
    }
  }

  findings.sort((a, b) => compareCodePoint(a.file, b.file) || a.line - b.line || a.col - b.col
    || compareCodePoint(a.code, b.code));
  const counts = {
    error: findings.filter((f) => f.severity === 'error').length,
    warn: findings.filter((f) => f.severity === 'warn').length,
  };
  const emptyAreas = AREAS.filter((a) => !areasPresent.has(a));
  const version = JSON.parse(fs.readFileSync(path.join(ROOT, 'package.json'), 'utf8')).version;
  const envelope = {
    counts,
    findings,
    schema: 'agsc.diagnostics.v1',
    spec_version: declaredSpecVersion,
    status: counts.error === 0 ? 'pass' : 'fail',
    verb: 'validate-vectors',
    version,
  };

  if (flags.has('--json')) {
    out(`${canonicalize(envelope)}\n`);
    for (const f of findings) err(`${canonicalize(f)}\n`);
  } else if (!flags.has('--quiet')) {
    for (const f of findings) {
      err(`${f.severity}: ${f.file}:${f.line}:${f.col} ${f.code} ${f.message}\n`);
    }
    out(`validate-vectors: ${files.length} input file(s) read, ${files.length} vectors, ${counts.error} error, ${counts.warn} warn; `
      + `declared areas with no vector file (informational, AGSC-09-90): ${emptyAreas.length ? emptyAreas.join(' ') : 'none'}\n`);
  }
  return counts.error === 0 ? 0 : 1;
}

/* c8 ignore next */
if (require.main === module) process.exit(run(process.argv.slice(2)));

module.exports = { HELP, canonicalize, compareCodePoint, run };
