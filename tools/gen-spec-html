#!/usr/bin/env node
'use strict';
// tools/gen-spec-html — the specification-page generator of AGSC-09-90 and PRD-054:
// "spec/ → `/specs/` pages".
//
// INDEPENDENT BY CONSTRUCTION: no import from `src/` (AGSC-09-90). Markdown is
// rendered with `markdown-it`, the library the engine pins, configured exactly as
// AGSC-02-20's subset requires — `html:false`, `linkify:false`, `typographer:false`
// — so no authored byte can inject markup and no rendering depends on a locale.
//
//   gen-spec-html [--json] [--quiet] [--help] [--out <dir>] [--check <dir> [--text]] [<root>]
//
// With neither --out nor --check the tool renders every page in memory and reports
// what it would write. --out writes `<dir>/index.html` and `<dir>/<section>/index.html`
// for each `spec/<nn>-<section>.md`. --check compares an existing directory byte for
// byte and reports drift, which is how a published `/specs/` tree is kept honest.
// A chapter page is looked for at `/specs/<name>/` and, failing that, at the
// numbered form `/specs/<nn>-<name>/` a publisher may use instead (AGSC-06-01 names
// `/specs/` and pins no chapter route). `--check <dir> --text` is for a publisher
// that renders the same chapters in its own page design: instead of the bytes it
// compares what the pages SAY — the plain text of every rule, found by its anchor,
// and the number of table rows on each chapter — so a changed, dropped or added
// word in a rule is drift and a different page shell is not.
//
// Exit 0 pass, 1 fail, 2 usage. Deterministic: no clock, no network, LF, sorted
// output; the same inputs give the same bytes on every machine (AGSC-04-01).
//
// Findings:
//   AGSC-E109  a Markdown construct outside the subset these pages may carry: raw
//              HTML in a spec file (AGSC-02-20)
//   AGSC-E201  a rule id appearing twice in one page, so its anchor is ambiguous
//   AGSC-E602  a page on disk differs from this rendering (AGSC-04-02)
//   AGSC-E901  spec/ or a checked page is missing

const fs = require('node:fs');
const path = require('node:path');

const DEFAULT_ROOT = path.resolve(__dirname, '..');
const HELP = `gen-spec-html [--json] [--quiet] [--help] [--out <dir>] [--check <dir> [--text]] [<root>]

  Renders spec/*.md into the /specs/ pages of PRD-054, one directory per section
  plus an index, deterministically and with an anchor on every rule id.

  --out <dir>    write the rendered pages into <dir>
  --check <dir>  compare an existing tree with this rendering, byte for byte;
                 a chapter may sit at <dir>/<name>/ or at <dir>/<nn>-<name>/
  --text         with --check: compare the text of every rule and the table rows,
                 not the page bytes (a publisher's own page design)
  --json         emit the AGSC-09-11 diagnostics envelope on stdout
  --quiet        emit nothing; the exit code is the result
  --help         this text

  Exit 0 pass, 1 fail, 2 usage.
`;

const RULE_ANCHOR = /<strong>(AGSC-\d{2}-\d{2,3}[a-z]?)<\/strong>/gu;

// --------------------------------------------------------------------------
// JCS (RFC 8785), the sliver this tool needs for its envelope.
// --------------------------------------------------------------------------
function canonicalize(value) {
  if (value === null) return 'null';
  if (typeof value === 'boolean') return value ? 'true' : 'false';
  if (typeof value === 'number') return value === 0 ? '0' : String(value);
  if (typeof value === 'string') return JSON.stringify(value);
  if (Array.isArray(value)) return `[${value.map(canonicalize).join(',')}]`;
  const names = Object.keys(value).map((k) => k.normalize('NFC')).sort();
  return `{${names.map((n) => `${JSON.stringify(n)}:${canonicalize(value[n])}`).join(',')}}`;
}

/** AGSC-09-10: order by (file, line, col, code), compared code-point-wise. */
function compareCodePoint(a, b) {
  const ia = a[Symbol.iterator]();
  const ib = b[Symbol.iterator]();
  for (;;) {
    const x = ia.next();
    const y = ib.next();
    if (x.done && y.done) return 0;
    if (x.done) return -1;
    if (y.done) return 1;
    const cx = x.value.codePointAt(0);
    const cy = y.value.codePointAt(0);
    if (cx !== cy) return cx < cy ? -1 : 1;
  }
}

function finding(code, file, message, severity = 'error', line = 1) {
  return { code, col: 1, file, line, message, severity };
}

const escape = (s) => s.replace(/&/gu, '&amp;').replace(/</gu, '&lt;')
  .replace(/>/gu, '&gt;').replace(/"/gu, '&quot;');

/** The section name of `spec/<nn>-<section>.md`. */
function sectionOf(name) {
  const match = /^(\d{2})-(.+)\.md$/u.exec(name);
  return match ? { number: match[1], slug: match[2] } : null;
}

/** One page, wrapped in the same deterministic shell as every other. */
function page(title, specVersion, body, navigation) {
  return [
    '<!DOCTYPE html>',
    '<html lang="en">',
    '<head>',
    '<meta charset="utf-8">',
    '<meta name="viewport" content="width=device-width, initial-scale=1">',
    `<title>${escape(title)}</title>`,
    `<meta name="agsc-spec-version" content="${escape(specVersion)}">`,
    '</head>',
    '<body>',
    '<nav>',
    navigation,
    '</nav>',
    '<main>',
    body.replace(/\n+$/u, ''),
    '</main>',
    '</body>',
    '</html>',
    '',
  ].join('\n');
}

/**
 * Render every specification page.
 * @returns {{files: Map<string,string>, findings: Array, rules: number}}
 */
function render(root, texts) {
  const findings = [];
  const MarkdownIt = require('markdown-it');
  const markdown = new MarkdownIt({ html: false, linkify: false, typographer: false });
  const specVersion = ((texts.get('00-overview.md') || '')
    .match(/\d+\.\d+\.\d+(?:-[a-z]+\.\d+)?/u) || ['unknown'])[0];

  const sections = [...texts.keys()].sort().map((name) => ({ name, ...sectionOf(name) }));
  const navigation = ['<ul>', ...sections.map((s) => `<li><a href="/specs/${escape(s.slug)}/">${escape(s.number)} ${escape(s.slug)}</a></li>`), '</ul>'].join('\n');

  const files = new Map();
  let rules = 0;
  for (const section of sections) {
    const file = `spec/${section.name}`;
    const text = texts.get(section.name);
    if (/^\s*<[a-zA-Z!/]/mu.test(text)) {
      findings.push(finding('AGSC-E109', file, 'raw HTML in a specification file (AGSC-02-20)'));
    }
    const heading = (text.match(/^#\s+(.*)$/mu) || [null, section.slug])[1];
    let body = markdown.render(text);
    const seen = new Set();
    body = body.replace(RULE_ANCHOR, (whole, id) => {
      if (seen.has(id)) {
        findings.push(finding('AGSC-E201', file, `rule id ${id} appears twice on this page; its anchor would be ambiguous`));
        return whole;
      }
      seen.add(id);
      return `<strong id="${id}"><a href="#${id}">${id}</a></strong>`;
    });
    rules += seen.size;
    files.set(`${section.slug}/index.html`, page(heading, specVersion, body, navigation));
  }
  const index = [
    `<h1>AgenticSystemCore ${escape(specVersion)}</h1>`,
    '<ol>',
    ...sections.map((s) => `<li><a href="/specs/${escape(s.slug)}/">${escape(s.number)} — ${escape(s.slug)}</a></li>`),
    '</ol>',
  ].join('\n');
  files.set('index.html', page(`AgenticSystemCore ${specVersion}`, specVersion, index, navigation));
  return { files, findings, rules, sections, specVersion };
}

// --------------------------------------------------------------------------
// --text: what a page SAYS, independent of the markup around it.
// --------------------------------------------------------------------------

const ENTITIES = Object.freeze({ amp: '&', apos: "'", gt: '>', lt: '<', nbsp: ' ', quot: '"' });

/**
 * The item numbers an ordered list shows, written out as text (`<li>` → `<li>2. `),
 * so a page that shows `1.` `2.` as literal text and one that shows them through an
 * `<ol>` compare equal — the reader sees the same numbers on both.
 */
function numberOrderedItems(fragment) {
  const stack = [];
  return String(fragment).replace(/<(\/?)(ol|ul|li)\b([^>]*)>/giu, (tag, close, name, attrs) => {
    const lower = name.toLowerCase();
    if (lower === 'li') {
      if (close !== '' || stack.length === 0 || stack[stack.length - 1] === null) return tag;
      stack[stack.length - 1] += 1;
      return `${tag}${stack[stack.length - 1]}. `;
    }
    if (close !== '') { stack.pop(); return tag; }
    const start = /\bstart="(\d+)"/u.exec(attrs);
    stack.push(lower === 'ol' ? (start ? Number(start[1]) - 1 : 0) : null);
    return tag;
  });
}

/** The visible text of an HTML fragment: tags dropped, entities decoded, spaces collapsed. */
function plainText(fragment) {
  return numberOrderedItems(fragment)
    .replace(/<[^>]*>/gu, ' ')
    .replace(/&(#x[0-9a-fA-F]+|#[0-9]+|[a-z]+);/gu, (all, name) => {
      if (name[0] === '#') {
        const cp = name[1] === 'x' ? parseInt(name.slice(2), 16) : parseInt(name.slice(1), 10);
        return Number.isFinite(cp) && cp <= 0x10ffff ? String.fromCodePoint(cp) : all;
      }
      return ENTITIES[name] === undefined ? all : ENTITIES[name];
    })
    .replace(/\s+/gu, ' ')
    .replace(/ ([.,;:)\]])/gu, '$1')
    .replace(/([([]) /gu, '$1')
    .trim();
}

/**
 * The text of the list item that carries `id="<rule>"` — on this tool's pages the id
 * sits on the `<strong>` inside the `<li>`, on a publisher's page it may sit on the
 * `<li>` itself. Nested lists inside the item are part of it. `null` when the page
 * carries no such anchor.
 */
function ruleText(html, id) {
  const at = html.indexOf(`id="${id}"`);
  if (at === -1) return null;
  const start = html.lastIndexOf('<li', at);
  if (start === -1) return null;
  const tag = /<(\/?)li\b[^>]*>/giu;
  tag.lastIndex = start;
  let depth = 0;
  for (let m = tag.exec(html); m !== null; m = tag.exec(html)) {
    depth += m[1] === '/' ? -1 : 1;
    if (depth === 0) return plainText(html.slice(start, m.index));
  }
  return plainText(html.slice(start));
}

/** The number of table rows a page carries. */
function tableRows(html) {
  return (String(html).match(/<tr[\s>]/gu) || []).length;
}

/** The rule ids this tool anchored on one of its own pages, in page order. */
function anchoredRules(html) {
  return [...String(html).matchAll(/<strong id="(AGSC-\d{2}-\d{2,3}[a-z]?)">/gu)].map((m) => m[1]);
}

/**
 * --text for one chapter: every rule this rendering anchors must be anchored on the
 * checked page with the same words, and the table-row count must be equal.
 * @returns {Array<string>} the differences, one message each.
 */
function textDrift(mine, theirs) {
  const out = [];
  for (const id of anchoredRules(mine)) {
    const expected = ruleText(mine, id);
    const found = ruleText(theirs, id);
    if (found === null) out.push(`rule ${id} has no anchor on this page`);
    // Words are compared, not the spaces a renderer puts around an inline tag
    // (`<code>x</code>'s` against `<code>x</code> 's`): a spacing difference is
    // markup, a changed, dropped or added character is wording.
    else if (found.replace(/\s+/gu, '') !== expected.replace(/\s+/gu, '')) out.push(`the text of rule ${id} differs from spec/ (${JSON.stringify(found.slice(0, 80))}…)`);
  }
  const rows = tableRows(mine);
  const theirRows = tableRows(theirs);
  if (rows !== theirRows) out.push(`the page carries ${theirRows} table row(s) and spec/ renders ${rows}`);
  return out;
}

function envelopeOf(findings, declared, version) {
  findings.sort((a, b) => compareCodePoint(a.file, b.file) || a.line - b.line || a.col - b.col
    || compareCodePoint(a.code, b.code) || compareCodePoint(a.message, b.message));
  const counts = {
    error: findings.filter((f) => f.severity === 'error').length,
    warn: findings.filter((f) => f.severity === 'warn').length,
  };
  return {
    counts,
    findings,
    schema: 'agsc.diagnostics.v1',
    spec_version: declared,
    status: counts.error === 0 ? 'pass' : 'fail',
    verb: 'gen-spec-html',
    version,
  };
}

function packageVersion(root) {
  try { return JSON.parse(fs.readFileSync(path.join(root, 'package.json'), 'utf8')).version; } catch { return '0.0.0'; }
}

/**
 * @param {string[]} argv
 * @param {{out:(s:string)=>void, err:(s:string)=>void}} io
 * @returns {number} exit code: 0 pass, 1 fail, 2 usage
 */
function run(argv, io) {
  const out = (io && io.out) || ((s) => process.stdout.write(s));
  const err = (io && io.err) || ((s) => process.stderr.write(s));
  const usage = (message) => { err(`gen-spec-html: ${message}\n${HELP}`); return 2; };

  const flags = new Set();
  let root = DEFAULT_ROOT;
  let sawRoot = false;
  let outDir = null;
  let checkDir = null;
  for (let i = 0; i < argv.length; i += 1) {
    const arg = argv[i];
    if (arg === '--help' || arg === '-h') { out(HELP); return 0; }
    if (arg === '--json' || arg === '--quiet' || arg === '--text') flags.add(arg);
    else if (arg === '--out') { outDir = argv[++i]; if (!outDir) return usage('--out needs a directory (AGSC-E003)'); } else if (arg === '--check') { checkDir = argv[++i]; if (!checkDir) return usage('--check needs a directory (AGSC-E003)'); } else if (arg.startsWith('-')) return usage(`unknown flag ${arg} (AGSC-E002)`);
    else if (sawRoot) return usage(`unexpected argument ${arg} (AGSC-E002)`);
    else { root = path.resolve(arg); sawRoot = true; }
  }
  if (flags.has('--text') && !checkDir) return usage('--text compares a tree and needs --check <dir> (AGSC-E003)');
  const specDir = path.join(root, 'spec');
  // AGSC-09-90: "A validator MUST FAIL, with
  // `AGSC-E901`, when the inputs its contract names are absent". A failure is exit
  // 1 and the AGSC-09-11 envelope — not exit 2 and a usage block, which AGSC-09-08
  // reserves for an unknown verb, an unknown flag or a missing argument, and which
  // a caller reading the envelope cannot see at all.
  const absent = (message) => {
    const bad = envelopeOf([finding('AGSC-E901', 'spec/', message)], 'unknown', packageVersion(root));
    if (flags.has('--json')) out(`${canonicalize(bad)}\n`);
    else if (!flags.has('--quiet')) {
      for (const f of bad.findings) err(`${f.severity}: ${f.file}:${f.line}:${f.col} ${f.code} ${f.message}\n`);
      out(`gen-spec-html: 0 input file(s) read, 0 sections, 0 pages, 0 rule anchors, `
        + `${bad.counts.error} error, ${bad.counts.warn} warn\n`);
    }
    return 1;
  };
  if (!fs.existsSync(specDir)) {
    return absent(`no spec/ directory under ${root}: there is nothing to render (AGSC-09-91)`);
  }

  const texts = new Map();
  for (const name of fs.readdirSync(specDir).filter((f) => /^\d{2}-.*\.md$/u.test(f)).sort()) {
    texts.set(name, fs.readFileSync(path.join(specDir, name), 'utf8'));
  }
  if (texts.size === 0) {
    return absent(`no spec/<nn>-<name>.md files under ${specDir}: there is nothing to render (AGSC-09-91)`);
  }

  const rendered = render(root, texts);
  const findings = rendered.findings;
  // an input that is present but EMPTY is not a clean run. A spec/ that
  // declares no version and carries no rule anchor renders empty pages, and the
  // earlier code reported `pass` over them.
  if (rendered.specVersion === 'unknown') {
    findings.push(finding('AGSC-E901', 'spec/00-overview.md',
      'the overview declares no spec_version: the rendered pages would carry none (AGSC-09-91)'));
  }
  if (rendered.rules === 0) {
    findings.push(finding('AGSC-E901', 'spec/',
      `${texts.size} specification file(s) were read and not one rule anchor was rendered (AGSC-09-91)`));
  }

  if (outDir) {
    const target = path.resolve(outDir);
    for (const name of [...rendered.files.keys()].sort(compareCodePoint)) {
      const where = path.join(target, name);
      fs.mkdirSync(path.dirname(where), { recursive: true });
      fs.writeFileSync(where, rendered.files.get(name));
    }
  }
  if (checkDir) {
    const target = path.resolve(checkDir);
    const numbered = new Map(rendered.sections.map((s) => [`${s.slug}/index.html`, `${s.number}-${s.slug}/index.html`]));
    for (const name of [...rendered.files.keys()].sort(compareCodePoint)) {
      // the named route first, then the numbered one a publisher may use.
      const alternative = numbered.get(name);
      const found = [name, alternative].filter(Boolean).find((n) => fs.existsSync(path.join(target, n)));
      if (found === undefined) {
        findings.push(finding('AGSC-E901', `specs/${name}`, 'the page is absent from the tree being checked'));
        continue;
      }
      let theirs = fs.readFileSync(path.join(target, found), 'utf8');
      if (flags.has('--text')) {
        // A publisher may serve a chapter in parts — `<chapter>/page-2/index.html`
        // and on — when one page would exceed the budget of AGSC-06-21; what the
        // chapter SAYS is the parts together, so the text check reads them as one
        // page. (Table rows are counted across the parts together, so a box the
        // publisher repeats on every part must carry no table.)
        const dir = path.dirname(path.join(target, found));
        const parts = fs.readdirSync(dir).filter((d) => /^page-\d+$/u.test(d))
          .sort((a, b) => Number(a.slice(5)) - Number(b.slice(5)));
        for (const part of parts) {
          const file = path.join(dir, part, 'index.html');
          if (fs.existsSync(file)) theirs += fs.readFileSync(file, 'utf8');
        }
      }
      if (!flags.has('--text')) {
        if (theirs !== rendered.files.get(name)) {
          findings.push(finding('AGSC-E602', `specs/${found}`, 'the page on disk differs from this rendering (AGSC-04-02)'));
        }
      } else if (name !== 'index.html') {
        for (const message of textDrift(rendered.files.get(name), theirs)) {
          findings.push(finding('AGSC-E602', `specs/${found}`, message));
        }
      }
    }
  }

  const envelope = envelopeOf(findings, rendered.specVersion, packageVersion(root));
  if (flags.has('--json')) {
    out(`${canonicalize(envelope)}\n`);
  } else if (!flags.has('--quiet')) {
    for (const f of envelope.findings) {
      err(`${f.severity}: ${f.file}:${f.line}:${f.col} ${f.code} ${f.message}\n`);
    }
    out(`gen-spec-html: ${texts.size} input file(s) read, ${texts.size} sections, ${rendered.files.size} pages, ${rendered.rules} rule anchors, `
      + `${envelope.counts.error} error, ${envelope.counts.warn} warn`
      + `${outDir ? `; wrote into ${outDir}` : ''}`
      + `${checkDir ? `; checked ${checkDir} ${flags.has('--text') ? 'compared by rule text and table rows' : 'byte for byte'}` : ''}\n`);
  }
  return envelope.status === 'pass' ? 0 : 1;
}

/* c8 ignore next */
if (require.main === module) process.exit(run(process.argv.slice(2)));

module.exports = {
  HELP, anchoredRules, canonicalize, compareCodePoint, numberOrderedItems, page, plainText, render, ruleText, run, sectionOf,
  tableRows, textDrift,
};
