 ['2002::', 16], ['3fff::', 20], ['5f00::', 16], ['fc00::', 7], ['fe80::', 10], ['fec0::', 10], ['ff00::', 8]]
  .forEach(([a, p]) => BLOCK6.addSubnet(a, p, 'ipv6'));
const LOOP4 = new net.BlockList();
