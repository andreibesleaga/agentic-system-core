    if (one('access-control-allow-credentials') !== undefined) out.push(['AGSC-E201', 'Access-Control-Allow-Credentials is sent; no public artefact carries it (AGSC-11-03)']);
  }
  if (one('etag') === undefined) out.push(['AGSC-E202', 'no ETag: every public artefact is sent with one (AGSC-11-05)']);
  const cache = tokens(one('cache-control'));
  if (noCache && !cache.includes('no-cache')) out.push(['AGSC-E202', `Cache-Control is ${JSON.stringify(one('cache-control') || '')}, not no-cache (AGSC-11-05)`]);
  if (cache.includes('immutable')) out.push(['AGSC-E201', 'Cache-Control carries immutable, which no 1.0 route may (AGSC-11-05)']);
  return out;
}

/** AGSC-09-93: one fetched response, if it is the document or a same-origin public artefact. */
function checkHeaders(got, isDocument, run) {
  if (!got || !got.headers || run.seen.has(got.url)) return; // a file has no response headers
  const u = new URL(got.url);
  if (u.origin !== run.anchor.origin || !(isDocument || PUBLIC_ARTEFACT.some((re) => re.test(u.pathname)))) return;
  run.seen.add(got.url);
  const severity = run.level >= 2 ? 'error' : 'warn';
  const scope = { cors: isDocument || !run.gated, noCache: isDocument || NO_CACHE.includes(u.pathname) };
  for (const [code, message] of headerShortfalls(got.headers, scope)) run.F(code, `${got.url}: ${message}`, severity);
}

/**
 * AGSC-06-08: the document's bytes, its JSON and its outer shape, then its one link
 * context and that context's anchor. Returns `{ anchor, ctx }`, or null when nothing
 * further can be checked.
 */
function parseDocument(src, level, F, dev) {
  const text = src.bytes.toString('utf8');
  if (!Buffer.from(text, 'utf8').equals(src.bytes)) { F('AGSC-E201', 'document is not valid UTF-8'); return null; }
  let doc;
  try { doc = parseIJson(text); } catch (e) { F('AGSC-E201', `not I-JSON: ${e.message}`); return null; }
  if (level >= 2 && text !== jcs(doc) + '\n') F('AGSC-E601', 'document is not JCS-canonical with exactly one trailing LF (AGSC-04-04, AGSC-06-08)');
  if (!doc || typeof doc !== 'object' || Array.isArray(doc)) { F('AGSC-E201', 'document is not a JSON object'); return null; }
  const top = KEYS.get(doc);
  if (top.length !== 1 || top[0] !== 'linkset') { F('AGSC-E201', `"linkset" must be the sole top-level member; found ${JSON.stringify(top)} (AGSC-06-08, RFC 9264 §4.2.1)`); if (!Array.isArray(doc.linkset)) return null; }
  if (!Array.isArray(doc.linkset) || doc.linkset.length !== 1) { F('AGSC-E201', 'linkset must be an array holding exactly one link context object (AGSC-06-08)'); if (!Array.isArray(doc.linkset) || !doc.linkset.length) return null; }
  const ctx = doc.linkset[0];
  if (!ctx || typeof ctx !== 'object' || Array.isArray(ctx)) { F('AGSC-E201', 'link context is not an object'); return null; }
  let anchor;
  try { anchor = new URL(ctx.anchor); if (anchor.protocol !== 'https:' && !(dev && anchor.protocol === 'http:')) throw 0; if (!ctx.anchor.endsWith('/')) throw 0; } catch { F('AGSC-E201', `anchor must be the absolute https Bundle IRI ending in "/" (AGSC-05-03); got ${JSON.stringify(ctx.anchor)}`); return null; }
  // AGSC-06-08: a document whose anchor is not on the origin it was retrieved from
  // (after redirects) is not that node's discovery document (RFC 9264 §9, RFC 8615
  // §4.3). A file read from disk has no such origin and is not judged here.
  if (anchor && src.kind === 'url' && src.retrievedFrom && new URL(src.retrievedFrom).origin !== anchor.origin) {
    F('AGSC-E907', `anchor ${ctx.anchor} is not on the origin the document was retrieved from (${new URL(src.retrievedFrom).origin}); it is not that node's discovery document (AGSC-06-08)`);
  }
  const sorted = [...KEYS.get(ctx)].sort();
  if (JSON.stringify(KEYS.get(ctx)) !== JSON.stringify(sorted)) F('AGSC-E201', 'link context members are not ordered as JSON member names (AGSC-06-08, AGSC-04-05)');
  return { anchor, ctx };
}

/**
 * AGSC-11-20 and AGSC-10-04: what a restricted node omits, the one access link it
 * carries, and the ledger link a public Level ≥ 2 node carries.
 */
function checkGate(ctx, anchorLink, gated, level, F) {
  if (gated) {
    for (const a of RESTRICTED_OMITTED) {
      if (anchorLink[a] !== undefined) F('AGSC-E210', `a restricted node must omit "${a}": per-type population, the fingerprint, the content version and the ledger head are content facts (AGSC-11-20)`);
    }
    if (Array.isArray(ctx[REL + 'ledger']) && ctx[REL + 'ledger'].length) F('AGSC-E210', 'a restricted node publishes no rel#ledger link (AGSC-11-20)');
    // AGSC-11-20: exactly one rel#access link, at every Level (a restricted node
    // asserts conformance for its Level-0 view). A value that is not a non-empty
    // array is already AGSC-E201 (RFC 9264 §4.2.2), so only absence and a count
    // above one are judged here, each once for the relation.
    const access = ctx[REL + 'access'];
    const where = 'a restricted node carries exactly one rel#access link, naming where a reader obtains credentials';
    if (access === undefined) F('AGSC-E202', `${where}; this one carries none (AGSC-11-20)`);
    else if (Array.isArray(access) && access.length > 1) F('AGSC-E210', `${where}; this one carries ${access.length} (AGSC-11-20)`);
  } else if (level >= 2 && !(Array.isArray(ctx[REL + 'ledger']) && ctx[REL + 'ledger'].length)) {
    // AGSC-10-04 / AGSC-09-93: the derived ledger is part of Level 2, so a public
    // node claiming it publishes `/ledger.jsonl` and links it.
    F('AGSC-E202', 'no rel#ledger link: a Level ≥ 2 node publishes /ledger.jsonl and links it (AGSC-10-04, AGSC-09-93)');
  }
}

/**
 * The version the document declares (`agsc-spec-version`), whether it is a newer MINOR
 * of this checker's MAJOR, and the content version it publishes. Returns `{ declared, newer }`.
 */
function checkVersion(anchorLink, F) {
  // AGSC-00-23 / AGSC-E210: a node may not publish bytes carrying a member of a
  // version its own `agsc-spec-version` does not define. Checked for the members
  // this specification knows how to look for — today, the content version, which
  // arrived at 1.0 and whose value must match AGSC-04-25's grammar.
  const declared = Array.isArray(anchorLink['agsc-spec-version']) ? String(anchorLink['agsc-spec-version'][0]) : null;
  const declaredMajor = declared === null ? null : (/^(\d+)\./.exec(declared) || [null, null])[1];
  // AGSC-00-21 / AGSC-09-93: a document of the validator's MAJOR and a newer MINOR
  // may use a relation or an attribute this version does not define. It is ignored,
  // with the warning AGSC-E506 naming the newer version, and never reported as
  // AGSC-E209 or AGSC-E202. Another MAJOR has no such tolerance.
  const mm = (v) => { const m = /^(\d+)\.(\d+)(?:\.|$)/.exec(String(v)); return m ? [Number(m[1]), Number(m[2])] : null; };
  const theirs = declared === null ? null : mm(declared);
  const mine = mm(SPEC_VERSION);
  const newer = theirs !== null && mine !== null && theirs[0] === mine[0] && theirs[1] > mine[1];
  if (Array.isArray(anchorLink['agsc-bundle-version'])) {
    const value = anchorLink['agsc-bundle-version'];
    if (value.length !== 1) F('AGSC-E210', 'agsc-bundle-version carries exactly one value (AGSC-06-08, AGSC-04-25)');
    else if (!VERSION_GRAMMAR.test(String(value[0]))) F('AGSC-E204', `agsc-bundle-version ${JSON.stringify(String(value[0]))} is outside the grammar of AGSC-04-25`);
    // The attribute is defined from specification MAJOR 1 (AGSC-04-25), so a node
    // publishing it while declaring an EARLIER MAJOR publishes bytes its own
    // declaration does not define. A later MAJOR is outside what this checker can
    // judge: it cannot know what that version defines, so it states no E210 for it
    // (the document's unknown relations are still AGSC-E209, AGSC-09-93).
    if (declaredMajor !== null && Number(declaredMajor) < 1) {
      F('AGSC-E210', `the node publishes agsc-bundle-version while declaring agsc-spec-version ${JSON.stringify(declared)}, which does not define it (AGSC-00-23, AGSC-04-25)`);
    }
  }
  return { declared, newer };
}

/** AGSC-06-10, RFC 9264 §4.2.4: the value form of each attribute of one target; a newer MINOR's attribute is ignored with a warning. */
function checkAttributes(rel, t, { declared, newer }, F) {
  for (const k of KEYS.get(t)) {
    if (k === 'href') continue;
    const v = t[k];
    if (newer && !KNOWN_ATTRS.has(k)) { F('AGSC-E506', `relation ${rel}: target attribute ${k} is not defined by this version; the document declares the newer ${declared}, so it is ignored (AGSC-00-21, AGSC-09-93)`, 'warn'); continue; }
    if (RFC8288_STRING_ATTRS.has(k)) { if (typeof v !== 'string') F('AGSC-E201', `relation ${rel}: target attribute ${k} must be a string (RFC 9264 §4.2.4.1)`); } else if (k === 'title*') { if (!Array.isArray(v)) F('AGSC-E201', `relation ${rel}: title* must be an array (RFC 9264 §4.2.4.2)`); } else if (!Array.isArray(v) || !v.length || !v.every((s) => typeof s === 'string')) F('AGSC-E201', `relation ${rel}: target attribute ${k} must be a non-empty array of strings (AGSC-06-10)`);
  }
}

/**
 * AGSC-06-08, AGSC-06-08a, AGSC-11-20: one target's digest — its form, and at Level ≥ 2
 * (or from a file) the bytes it names — or, where it is missing, whether Level ≥ 2
 * requires it.
 */
async function checkDigest(t, h, rel, ext, doc) {
  const { anchor, ctx, F, gated, headerChecks, level, src } = doc;
  const sameOrigin = h.origin === anchor.origin;
  const artefact = sameOrigin && !h.pathname.endsWith('/') && rel !== 'license' && rel !== 'service-doc' && ext !== 'surface' && ext !== 'peer'
    // AGSC-06-08: the optional signature link "affects no
    // digest, no claim and no walk", so its target is never an artefact that needs one.
    && ext !== 'signature';
  const open = sameOrigin && OPEN_WHEN_RESTRICTED.some((p) => h.pathname.endsWith(p));
  // AGSC-11-20: a restricted node publishes no digest of a target it gates.
  if (gated && t.digest !== undefined && !open) F('AGSC-E210', `relation ${rel}: a restricted node must omit the digest of ${t.href}, a target it does not serve unauthenticated (AGSC-11-20)`);
  if (t.digest === undefined) {
    if (level >= 2 && artefact && !(gated && !OPEN_WHEN_RESTRICTED.some((p) => h.pathname.endsWith(p)))) F('AGSC-E202', `relation ${rel}: artefact link ${t.href} carries no digest (required at Level ≥ 2, AGSC-06-08a)`);
    return;
  }
  if (!Array.isArray(t.digest) || t.digest.length !== 1 || !/^sha-256=:[A-Za-z0-9+/]{43}=:$/.test(t.digest[0])) { F('AGSC-E204', `relation ${rel}: digest must be one "sha-256=:<base64>:" string (AGSC-06-08, RFC 9530, RFC 9651)`); return; }
  if (level < 2 && src.kind !== 'file') return;
  try {
    const got = await src.resolve(t.href, ctx.anchor);
    if (got) {
      const d = 'sha-256=:' + crypto.createHash('sha256').update(got.bytes).digest('base64') + ':';
      if (d !== t.digest[0]) F('AGSC-E201', `relation ${rel}: digest does not match the bytes of ${t.href}`);
      headerChecks(got, false);
    }
  } catch (e) { F(e.code || 'AGSC-E907', `relation ${rel}: ${e.message}`); }
}

/** AGSC-11-16: one rel#surface target's declaration; an llms-txt or chunks target must resolve. */
async function checkSurface(t, h, doc) {
  const { ctx, F, headerChecks, src } = doc;
  const s = t['agsc-surface'], acc = t['agsc-access'], ver = t['agsc-surface-version'];
  const name = Array.isArray(s) && s.length === 1 ? s[0] : null;
  if (!name) F('AGSC-E210', `rel#surface ${t.href}: agsc-surface must carry exactly one value (AGSC-11-16)`);
  else if (!SURFACES.has(name) && !/^x-[a-z0-9]+(-[a-z0-9]+)+$/.test(name)) F('AGSC-E210', `rel#surface ${t.href}: unknown surface ${JSON.stringify(name)} (AGSC-11-16; a reader treats it as not served, AGSC-11-02)`, 'warn');
  if (!(Array.isArray(acc) && acc.length === 1)) F('AGSC-E210', `rel#surface ${t.href}: agsc-access must carry exactly one value (AGSC-11-16)`);
  else if (!ACCESS.has(acc[0])) F('AGSC-E210', `rel#surface ${t.href}: unknown access class ${JSON.stringify(acc[0])} (read as credential, AGSC-11-02)`, 'warn');
  if (name && SURFACE_NEEDS_VERSION.has(name) && !(Array.isArray(ver) && ver.length === 1)) F('AGSC-E210', `rel#surface ${t.href}: agsc-surface-version is required for ${name} (AGSC-11-16)`);
  if (name && (name === 'llms-txt' || name === 'chunks') && ver !== undefined) F('AGSC-E210', `rel#surface ${t.href}: agsc-surface-version must be absent for ${name} (AGSC-11-16)`);
  if (name === 'llms-txt' && h.pathname !== '/llms.txt' && !h.pathname.endsWith('/llms.txt')) F('AGSC-E210', `rel#surface llms-txt must target /llms.txt (AGSC-11-16)`);
  if (name === 'llms-txt' || name === 'chunks') {
    try { headerChecks(await src.resolve(t.href, ctx.anchor), false); } catch (e) { F('AGSC-E210', `rel#surface ${name}: target does not resolve: ${e.message}`); }
  }
}

/**
 * One target of one relation (AGSC-06-08, AGSC-06-10, AGSC-06-35): its form, its order
 * after `prev`, its attributes, its digest and what its relation declares. Returns the
 * href the next target is ordered against.
 */
async function checkTarget(t, prev, rel, ext, doc) {
  const { anchorLink, F, level, gated, result } = doc;
  if (!t || typeof t !== 'object' || Array.isArray(t) || typeof t.href !== 'string') { F('AGSC-E201', `relation ${rel}: every target is an object with a string href`); return prev; }
  let h; try { h = new URL(t.href); } catch { F('AGSC-E201', `relation ${rel}: href ${JSON.stringify(t.href)} is not absolute (AGSC-06-10)`); return prev; }
  if (prev !== null && !(prev < t.href)) F('AGSC-E201', `relation ${rel}: targets are not ordered by href code point (AGSC-06-10)`);
  checkAttributes(rel, t, doc.version, F);
  // AGSC-06-08 / AGSC-04-15: `agsc-bundle-hash` is the SHA-256 of `graph.nq`, so
  // where both are published it equals the digest of the rel#graph link to it.
  if (ext === 'graph' && /\/graph\.nq$/.test(h.pathname) && Array.isArray(t.digest) && Array.isArray(anchorLink['agsc-bundle-hash'])
    && String(anchorLink['agsc-bundle-hash'][0]) !== String(t.digest[0])) F('AGSC-E210', `agsc-bundle-hash ${JSON.stringify(String(anchorLink['agsc-bundle-hash'][0]))} is not the digest of ${t.href}, the bundle hash of AGSC-04-15 (AGSC-06-08)`);
  await checkDigest(t, h, rel, ext, doc);
  // AGSC-06-08a requires every `agsc-*` attribute at Level ≥ 2 — EXCEPT the four
  // AGSC-11-20 forbids a gated node to publish, which are checked above instead.
  if (level >= 2 && rel === 'describedby' && /\/graph\.jsonld$/.test(h.pathname)) for (const a of LEVEL2_ATTRS) if (t[a] === undefined && !(gated && RESTRICTED_OMITTED.includes(a))) F('AGSC-E202', `describedby ${t.href}: ${a} is required at Level ≥ 2 (AGSC-06-08)`);
  if (level >= 2 && !gated && ext === 'ledger' && t['agsc-ledger-head'] === undefined) F('AGSC-E202', 'rel#ledger: agsc-ledger-head is required at Level ≥ 2 (AGSC-06-08)');
  if (RELATED_ONLY.has(rel) && typeof t.type !== 'string') F('AGSC-E209', `related-system link ${rel} ${t.href} must carry type (AGSC-06-35)`);
  if (ext === 'peer') result.peers.push(t.href);
  if (ext === 'surface') await checkSurface(t, h, doc);
  return t.href;
}

/** AGSC-06-10, AGSC-06-35: every relation of the link context, and each of its targets in order. */
async function checkRelations(doc) {
  const { ctx, F, version } = doc;
  for (const rel of KEYS.get(ctx).filter((k) => k !== 'anchor')) {
    const ext = rel.startsWith(REL) ? rel.slice(REL.length) : null;
    if (!(REGISTERED.has(rel) || (ext !== null && EXTENSIONS.has(ext)))) {
      if (version.newer) { F('AGSC-E506', `relation ${JSON.stringify(rel)} is not defined by this version; the document declares the newer ${version.declared}, so it is ignored (AGSC-00-21, AGSC-09-93)`, 'warn'); continue; }
      F('AGSC-E209', `relation ${JSON.stringify(rel)} is neither a registered name of AGSC-06-10/06-35 nor a …/rel#<name> extension URI`);
    }
    const arr = ctx[rel];
    if (!Array.isArray(arr) || !arr.length) { F('AGSC-E201', `relation ${rel}: value must be a non-empty array of target objects (RFC 9264 §4.2.2)`); continue; }
    let prev = null;
    for (const t of arr) prev = await checkTarget(t, prev, rel, ext, doc);
  }
}

/**
 * AGSC-09-93: one discovery document, one group of checks after another — the media
 * type, the document (`parseDocument`), the response headers (`checkHeaders`), what a
 * restricted node omits (`checkGate`), the declared version (`checkVersion`), and the
 * relations and their targets (`checkRelations`). Returns the anchor and the peers
 * for the mutual check of AGSC-10-12, or null when the document cannot be read.
 */
async function check(src, level, findings, session) {
  const F = (code, message, severity = 'error') => findings.push({ code, col: 1, file: src.name, line: 1, message, severity });
  const shortfall = mediaTypeShortfall(mediaTypeOk(src.headers));
  if (shortfall) F('AGSC-E201', shortfall);
  const parsed = parseDocument(src, level, F, session.dev);
  if (!parsed) return null;
  const { anchor, ctx } = parsed;
  const result = { anchor: ctx.anchor, peers: [], ctx };
  // AGSC-11-20: a gated node's own declaration decides which attributes are
  // REQUIRED and which are FORBIDDEN, so it is read once, before the links.
  const describedby = Array.isArray(ctx.describedby) ? ctx.describedby : [];
  const anchorLink = describedby.find((t) => t && typeof t.href === 'string' && /\/graph\.jsonld$/.test(t.href)) || {};
  const gated = Array.isArray(anchorLink['agsc-visibility'])
    && anchorLink['agsc-visibility'].map(String).includes('restricted');
  // AGSC-09-93 (amended 2026-10-06): given a URL, the headers of the rules on
  // cross-origin reading and caching, on the document and on every same-origin
  // public artefact this run fetches. A file has no response headers.
  const headerRun = { anchor, F, gated, level, seen: new Set() };
  const headerChecks = (got, isDocument) => checkHeaders(got, isDocument, headerRun);
  headerChecks({ headers: src.headers, url: src.retrievedFrom }, true);
  checkGate(ctx, anchorLink, gated, level, F);
  const version = checkVersion(anchorLink, F);
  await checkRelations({ anchor, anchorLink, ctx, F, gated, headerChecks, level, result, src, version });
  return result;
}

// ---------------------------------------------------------------- main
/**
 * One run of the command. `argv` holds the arguments after the script's name; `io`
 * may hand in `out` and `err` (each a function of a string; the process's streams by
 * default) and the deadline `timer` (`{ set(callback, ms), clear(handle) }`; the
 * platform's by default). Resolves to the exit code: 0 pass, 1 fail, 2 usage.
 */
async function run(argv, io = {}) {
  const out = io.out || ((s) => process.stdout.write(s));
  const err = io.err || ((s) => process.stderr.write(s));
  const { opts, fault, help } = parseArgs(argv);
  if (help) { out(fs.readFileSync(__filename, 'utf8').split('\n').slice(1, 10).map((l) => l.replace(/^\/\/ ?/, '')).join('\n') + '\n'); return 0; }
  if (fault) {
    const [code, message] = fault;
    const env = envelope([{ code, col: 1, file: '', line: 1, message, severity: 'error' }]);
    if (opts.json) out(jcs(env) + '\n'); else err(`${code} ${message}\n`);
    return 2;
  }
  const session = { dev: opts.dev, reads: 0, timer: io.timer || PLATFORM_TIMER };
  const findings = [];
  const one = async (target, level) => {
    try { const src = await load(target, session); return { src, r: await check(src, level, findings, session) }; } catch (e) { findings.push({ code: e.code && /^AGSC-E\d{3}$/.test(e.code) ? e.code : 'AGSC-E907', col: 1, file: target, line: 1, message: e.message, severity: 'error' }); return null; }
  };
  const a = await one(opts.target, opts.level);
  if (opts.peer) {
    const b = await one(opts.peer, opts.level);
    const canon = (r) => new URL(`.well-known/${WELLKNOWN_SUFFIX}`, r.anchor).href;
    if (a && a.r && b && b.r) {
      if (!a.r.peers.includes(canon(b.r))) findings.push({ code: 'AGSC-E907', col: 1, file: opts.target, line: 1, message: `resolved, not mutual: no rel#peer names ${canon(b.r)} (AGSC-10-12)`, severity: 'error' });
      if (!b.r.peers.includes(canon(a.r))) findings.push({ code: 'AGSC-E907', col: 1, file: opts.peer, line: 1, message: `resolved, not mutual: no rel#peer names ${canon(a.r)} (AGSC-10-12)`, severity: 'error' });
    } else if (!findings.length) findings.push({ code: 'AGSC-E907', col: 1, file: opts.peer, line: 1, message: 'peer check could not run: a document is invalid', severity: 'error' });
  }
  const env = envelope(findings);
  if (opts.json) out(jcs(env) + '\n');
  else {
    for (const f of env.findings) err(`${f.file}:${f.line}:${f.col} ${f.severity} ${f.code} ${f.message}\n`);
    out(`validate-wellknown ${env.status} (level ${opts.level}): ${session.reads} input file(s) read, ${env.counts.error} error(s), ${env.counts.warn} warning(s)\n`);
  }
  return env.status === 'pass' ? 0 : 1;
}

if (require.main === module) run(process.argv.slice(2)).then((code) => process.exit(code));

module.exports = { mediaTypeOk, run };
