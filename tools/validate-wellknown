// ---------------------------------------------------------------- source abstraction
const isUrl = s => /^[a-z][a-z0-9+.-]*:\/\//i.test(s);
/**: how many documents this run actually read, printed with the verdict so
 *  that "nothing is wrong" can be told apart from "nothing was looked at". */
const READS = { count: 0 };
async function load(target) {
  READS.count += 1;
  if (isUrl(target)) {
    const r = await fetchUrl(target);
    return { kind: 'url', name: target, bytes: r.body, headers: r.headers,
      resolve: async href => { READS.count += 1; return (await fetchUrl(href)).body; } };
  }
  const file = path.resolve(target);
  if (!fs.existsSync(file) || !fs.statSync(file).isFile()) throw new TransportError('AGSC-E901', `file not found: ${target}`);
  if (fs.statSync(file).size > MAX_BYTES) throw new TransportError('AGSC-E904', 'file exceeds 1 MiB');
  const wk = path.dirname(file);
  const siteRoot = path.basename(wk) === '.well-known' ? path.dirname(wk) : null;
  return { kind: 'file', name: target, bytes: fs.readFileSync(file), headers: null, siteRoot,
    resolve: async (href, anchor) => {
      if (!siteRoot) throw new TransportError('AGSC-E901', 'file is not inside a .well-known/ directory; targets cannot be resolved');
      const h = new URL(href), a = new URL(anchor);
      if (h.origin !== a.origin) return null; // cross-origin target: not checkable offline
      let p = decodeURIComponent(h.pathname);
      if (p.endsWith('/')) p += 'index.html';
      const f = path.resolve(siteRoot, '.' + p);
      if (!f.startsWith(siteRoot + path.sep)) throw new TransportError('AGSC-E902', `path escapes the site root: ${href}`);
      if (!fs.existsSync(f)) throw new TransportError('AGSC-E901', `target not found on disk: ${p}`);
      READS.count += 1;
      return fs.readFileSync(f);
    } };
}

// ---------------------------------------------------------------- checks
function mediaTypeOk(headers) {
  if (!headers) return { checked: false };
  const ct = String(headers['content-type'] || '');
  const essence = ct.split(';')[0].trim().toLowerCase();
  const params = {};
  for (const m of ct.matchAll(/;\s*([A-Za-z0-9!#$&^_.+-]+)\s*=\s*("(?:[^"\\]|\\.)*"|[^;]*)/g)) {
    let v = m[2].trim(); if (v.startsWith('"')) v = v.slice(1, -1).replace(/\\(.)/g, '$1');
    params[m[1].toLowerCase()] = v;
  }
  const byParam = essence === 'application/linkset+json' && (params.profile || '').split(/\s+/).includes(PROFILE);
  const links = [].concat(headers.link || []).join(',');
  const byLink = links.split(/,(?=\s*<)/).some(l => {
    const m = /^\s*<([^>]*)>(.*)$/.exec(l); if (!m) return false;
    const rel = /;\s*rel\s*=\s*(?:"([^"]*)"|([^;\s]+))/i.exec(m[2]);
    return m[1] === PROFILE && rel && (rel[1] || rel[2]).split(/\s+/).includes('profile');
  });
  return { checked: true, essence, ok: byParam || byLink, byParam, byLink };
}

async function check(src, level, findings) {
  const F = (code, message, severity = 'error') => findings.push({ code, col: 1, file: src.name, line: 1, message, severity });
  const mt = mediaTypeOk(src.headers);
  if (mt.checked && !mt.ok) F('AGSC-E201', `media type is "${mt.essence}" and no profile is carried: need application/linkset+json with profile="${PROFILE}", or a Link header with rel="profile" (AGSC-06-07)`);
  if (mt.checked && mt.ok && mt.essence !== 'application/linkset+json') F('AGSC-E201', `media type "${mt.essence}" is not application/linkset+json (AGSC-06-07)`);
