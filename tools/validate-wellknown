// ---------------------------------------------------------------- transport (AGSC-11-07/08/09)
// Two lists: Node checks an IPv4 address against IPv6 rules as ::ffff:a.b.c.d, so one shared
// list would refuse every IPv4 address through the ::ffff:0:0/96 rule.
const BLOCK4 = new net.BlockList(), BLOCK6 = new net.BlockList();
