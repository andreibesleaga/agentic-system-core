    if (u.protocol !== 'https:' && !(isHttp && opts.dev)) return reject(new TransportError('AGSC-E905', `scheme not allowed: ${u.protocol}`));
    const literal = u.hostname.replace(/^\[|\]$/g, '');
    if (net.isIP(literal)) { // the platform resolver is bypassed for literals, so classify here
      if (refused(literal, net.isIP(literal))) return reject(new TransportError('AGSC-E905', `address refused: ${literal}`));
      if (isHttp && !isLoop(literal, net.isIP(literal))) return reject(new TransportError('AGSC-E905', 'http is allowed only to loopback under --dev'));
    }
    const lookup = (host, o, cb) => dns.lookup(host, { all: true, verbatim: true }, (err, list) => {
      if (err) return cb(err);
