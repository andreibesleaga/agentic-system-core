    else if (x.startsWith('-')) usage('AGSC-E002', `unknown flag ${x}`);
    else if (!opts.target) opts.target = x;
    else usage('AGSC-E002', `unexpected argument ${x}`);
  }
  if (!opts.target) usage('AGSC-E003', 'missing <url|file>');
}

// ---------------------------------------------------------------- output
function jcs(v) {
  if (v === null || typeof v !== 'object') return JSON.stringify(v);
  if (Array.isArray(v)) return '[' + v.map(jcs).join(',') + ']';
  return '{' + Object.keys(v).sort().map(k => JSON.stringify(k) + ':' + jcs(v[k])).join(',') + '}';
}
function envelope(findings) {
  const cmp = (a, b) => a < b ? -1 : a > b ? 1 : 0;
  findings.sort((a, b) => cmp(a.file, b.file) || a.line - b.line || a.col - b.col || cmp(a.code, b.code) || cmp(a.message, b.message));
  const error = findings.filter(f => f.severity === 'error').length;
  return { counts: { error, warn: findings.length - error }, findings, schema: 'agsc.diagnostics.v1',
    spec_version: SPEC_VERSION, status: error ? 'fail' : 'pass', verb: 'validate-wellknown', version: TOOL_VERSION };
}

// ---------------------------------------------------------------- strict JSON (I-JSON: no duplicate names, no lone surrogates)
const KEYS = new WeakMap(); // object -> member names in document order
