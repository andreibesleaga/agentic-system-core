  try { return (fs.readFileSync(path.join(__dirname, '..', 'spec', '00-overview.md'), 'utf8').match(/1\.0\.0-[a-z]+\.\d+|\d+\.\d+\.\d+/) || ['unknown'])[0]; }
  catch { return 'unknown'; }
})();

const WELLKNOWN_SUFFIX = 'knowledge-linkset'; // single point of substitution, AGSC-06-07 (D82 Q4)
const PROFILE = 'https://w3id.org/agentic-system-core/profile/agentic-knowledge';
const REL = 'https://w3id.org/agentic-system-core/rel#';
const REGISTERED = new Set(['alternate', 'author', 'cite-as', 'collection', 'describedby', 'item', 'license',
  'related', 'service-desc', 'service-doc', 'service-meta']); // AGSC-06-10 + AGSC-06-35 (cite-as: rc.6)
const RELATED_ONLY = new Set(['related', 'service-desc', 'service-meta', 'collection', 'item', 'cite-as']);
const EXTENSIONS = new Set(['graph', 'ontology', 'context', 'now', 'skills', 'ledger', 'peer',
  'surface', 'contribute', 'access', 'signature']); // signature: rc.6,
const RFC8288_STRING_ATTRS = new Set(['type', 'title', 'media']); // RFC 9264 §4.2.4.2
const LEVEL2_ATTRS = ['agsc-bundle-hash', 'agsc-bundle-version', 'agsc-counts', 'agsc-generated-at', 'agsc-spec-version'];
// AGSC-11-20: the four a `restricted` node MUST omit although it is Level ≥ 2 —
// per-type population, the fingerprint, the content version (whose untagged forms
// carry the commit count and the commit hash of the content branch) and the ledger
// head are all content facts. Presence is AGSC-E210 (AGSC-09-93).
const RESTRICTED_OMITTED = ['agsc-bundle-hash', 'agsc-bundle-version', 'agsc-counts', 'agsc-ledger-head'];
// AGSC-04-25's grammar: one line, ASCII, safe unescaped in a link-set attribute.
const VERSION_GRAMMAR = /^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$/;
const SURFACES = new Set(['llms-txt', 'chunks', 'mcp', 'webmcp', 'a2a-card', 'solid', 'responder']);
const SURFACE_NEEDS_VERSION = new Set(['mcp', 'webmcp', 'a2a-card', 'solid', 'responder']);
const ACCESS = new Set(['none', 'consent', 'credential']);
const MAX_BYTES = 1048576;       // 1 MiB fetch cap (AR2)
const REDIRECT_LIMIT = 3;        // federation.redirect_limit default (AGSC-11-06/09)
const TIMEOUT_MS = 10000;        // federation.timeout_ms default (AGSC-11-06)

// ---------------------------------------------------------------- arguments
function usage(code, message) {
  const env = envelope([{ code, col: 1, file: '', line: 1, message, severity: 'error' }]);
  if (opts.json) process.stdout.write(jcs(env) + '\n'); else process.stderr.write(`${code} ${message}\n`);
  process.exit(2);
}
const opts = { json: false, dev: false, level: 0, target: null, peer: null };
{
  const a = process.argv.slice(2);
  opts.json = a.includes('--json');
  for (let i = 0; i < a.length; i++) {
    const x = a[i];
    if (x === '--json') continue;
    else if (x === '--dev') opts.dev = true;
    else if (x === '--level') { const v = a[++i]; if (!/^[0-3]$/.test(v || '')) usage('AGSC-E003', '--level needs 0, 1, 2 or 3'); opts.level = Number(v); }
