    else if (x === '--level') { const v = a[++i]; if (!/^[0-3]$/.test(v || '')) return fault('AGSC-E003', '--level needs 0, 1, 2 or 3'); opts.level = Number(v); } else if (x === '--peer') { const v = a[++i]; if (!v) return fault('AGSC-E003', '--peer needs a url or file'); opts.peer = v; } else if (x === '-h' || x === '--help') return { opts, help: true };
