async function fetchUrl(url) {
  let current = url;
  for (let hop = 0; ; hop++) {
    const r = await fetchOnce(current);
    if ([301, 302, 303, 307, 308].includes(r.status) && r.headers.location) {
      if (hop >= REDIRECT_LIMIT) throw new TransportError('AGSC-E905', `more than ${REDIRECT_LIMIT} redirects`);
      current = new URL(r.headers.location, current).href;
