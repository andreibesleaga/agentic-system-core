      const bad = list.find(x => refused(x.address, x.family));
      if (bad) return cb(new TransportError('AGSC-E905', `address refused: ${bad.address}`));
      if (isHttp && !list.every(x => isLoop(x.address, x.family))) return cb(new TransportError('AGSC-E905', 'http is allowed only to loopback under --dev'));
