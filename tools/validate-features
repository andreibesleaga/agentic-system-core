#!/usr/bin/env node
'use strict';
// tools/validate-features — the scenario validator of AGSC-09-90 and PRD-054:
// "Gherkin parse + @PRD tag ↔ PRD-id closure".
//
// INDEPENDENT BY CONSTRUCTION: Node built-ins only, no import from `src/`
// (AGSC-09-90). The Gherkin dialect parsed here is the one `features/README.md`
// declares the pack uses — Feature, Background, Scenario, Scenario Outline,
// Examples, Given/When/Then/And/But, tags, doc strings and data tables — and no
// more, so a file that reaches for a construct the pack does not use is reported
// rather than silently accepted.
//
//   validate-features [--json] [--quiet] [--strict-matrix] [--help] [<root>|<dir>]
//
// Exit 0 pass, 1 fail, 2 usage. Deterministic: no clock, no network, findings
// sorted by (file, line, col, code) per AGSC-09-10.
//
// Checks (each a Finding; any error exits 1):
//   AGSC-E108  encoding: a byte-order mark, a CR, no single trailing LF, or non-NFC
//              text (AGSC-01-14)
//   AGSC-E201  no `Feature:`, or more than one; a step outside every Scenario and
//              Background; an `Examples:` outside a Scenario Outline; a table row
//              whose column count differs from its header's; an unterminated doc
//              string; a `<placeholder>` no Examples header declares; a tag naming
//              a PRD or NFR id `docs/PRD.md` does not define (the closure PRD-054
//              requires)
//   AGSC-E202  a Feature with no Scenario; a Scenario with no step; a Scenario
//              Outline with no `Examples:`
//   AGSC-E207  (warning) the coverage table of `features/README.md` and a file's own
//              tags disagree
//   AGSC-E901  the features directory is missing; `--strict-matrix` on a pack with
//              no `features/MATRIX.md`
//
// The actor and the matrix. Every scenario carries `@human` or `@agent` (on itself,
// its Feature, its Rule, or every one of its Examples blocks); a scenario without
// one is AGSC-E202 — an error once the pack carries `features/MATRIX.md`, a warning
// before. A `@matrix-<row>` tag naming a row the matrix does not define is
// AGSC-E201. `features/MATRIX.md` holds two kinds of Markdown table, told apart by
// the first header cell: persona rows (`Row`: an id such as H1 or A12; `Who`;
// `Feature file`; `Target`; optional `Reason`) and surfaces (`Surface`; `Target`;
// `Scenario`; optional `Reason`). A Target names statuses: B (runs offline), C
// (runs where its conditional need is present), `G→<change>[, <change>…]` (a
// scenario written now whose pending file of class `gap` names the change in
// `closes_in`), P (a pending half that needs a forge, a model or an outside
// service), U (unit tests only) and rec (no scenario by design) — both with a
// reason, in the Reason cell or after "reason:" in the Target cell — and 1.1. The
// matrix checks, warnings by default and errors with `--strict-matrix`:
//   AGSC-E202  a B or C row that no running scenario tagged `@matrix-<row>` covers;
//              a B or C surface whose Scenario cell names no feature stem
//              (`persona-x`), or one with no feature file or no running scenario;
//              a U or rec cell with no reason; a G cell no gap file answers (for a
//              row: a gap file whose scenario is tagged with the row; for a
//              surface: a gap file of a feature the surface names); a persona of
//              the `docs/PRD.md` tables (a row whose first cell is `P<n>`) that no
//              feature file declares (`As P<n>` in its description, or its row of
//              the `features/README.md` coverage table)
//              a B surface named "CLI verbs" while a verb of the AGSC-09-07 set (read
//              from `spec/09-conformance.md`) appears, as `agsc <verb>` or
//              `agentic-system-core <verb>`, in the steps of no running scenario
//   AGSC-E201  a gap file under `tests/acceptance/pending/` that answers no G cell
//   AGSC-E203  a Target that names no status
// "Running" means the scenario has no pending file, or one of class `conditional`.
//
// PRD ids that no scenario tags are an informational count, never a failure: the
// pack covers the persona walkthroughs, not every requirement.

const fs = require('node:fs');
const path = require('node:path');

const DEFAULT_ROOT = path.resolve(__dirname, '..');
const HELP = `validate-features [--json] [--quiet] [--strict-matrix] [--help] [<root>|<dir>]

  Parses every features/*.feature file, closes its @PRD tags against the
  requirement ids of docs/PRD.md (PRD-054), checks that every scenario names its
  actor (@human or @agent), and checks features/MATRIX.md against the scenarios
  and the pending files of tests/acceptance/pending/; beside spec/, a "CLI verbs"
  surface marked B must run every verb of AGSC-09-07 in some scenario.

  --json           emit the AGSC-09-11 diagnostics envelope on stdout
  --quiet          emit nothing; the exit code is the result
  --strict-matrix  report the matrix findings as errors, not warnings
  --help           this text

  Exit 0 pass, 1 fail, 2 usage.
`;

const STEP = /^\s*(Given|When|Then|And|But|\*)\s+\S/u;
const TAG_LINE = /^\s*@\S/u;
const ID_TAG = /@((?:PRD|NFR)-\d{2,3})/gu;
const ACTORS = Object.freeze(['@agent', '@human']);
const MATRIX_TAG = /^@matrix-(.+)$/u;
const MATRIX_FILE = 'features/MATRIX.md';
const PENDING_DIR = 'tests/acceptance/pending';
const CHANGE = '[A-Z][A-Za-z0-9]*(?:-[A-Za-z0-9]+)*';

// --------------------------------------------------------------------------
// JCS (RFC 8785), the sliver this tool needs: NFC member names, UTF-16 order.
// --------------------------------------------------------------------------
function canonicalize(value) {
  if (value === null) return 'null';
  if (typeof value === 'boolean') return value ? 'true' : 'false';
  if (typeof value === 'number') return value === 0 ? '0' : String(value);
  if (typeof value === 'string') return JSON.stringify(value);
  if (Array.isArray(value)) return `[${value.map(canonicalize).join(',')}]`;
  const names = Object.keys(value).map((k) => k.normalize('NFC')).sort();
  return `{${names.map((n) => `${JSON.stringify(n)}:${canonicalize(value[n])}`).join(',')}}`;
}

/** AGSC-09-10: order by (file, line, col, code), compared code-point-wise. */
function compareCodePoint(a, b) {
  const ia = a[Symbol.iterator]();
  const ib = b[Symbol.iterator]();
  for (;;) {
    const x = ia.next();
    const y = ib.next();
    if (x.done && y.done) return 0;
    if (x.done) return -1;
    if (y.done) return 1;
    const cx = x.value.codePointAt(0);
    const cy = y.value.codePointAt(0);
    if (cx !== cy) return cx < cy ? -1 : 1;
  }
}

function finding(code, file, line, message, severity = 'error') {
  return { code, col: 1, file, line, message, severity };
}

/**
 * Parse one .feature file in the pack's dialect.
 * @returns {{features:number, scenarios:Array, tags:Set<string>, findings:Array}}
 */
function parseFeature(text, file) {
  const findings = [];
  const lines = text.split('\n');
  const tags = new Set();
  const scenarios = [];
  let features = 0;
  let current = null;            // the open Scenario / Scenario Outline / Background
  let docString = null;          // the fence that opened an unterminated doc string
  let pendingTags = [];
  let featureTags = [];          // the tags of the Feature, inherited by every scenario
  let ruleTags = [];             // the tags of the open Rule, inherited by its scenarios
  let headerColumns = null;      // the column count of the table currently open
  let examplesHeader = null;     // the Examples header names of the open Outline
  let backgroundSteps = [];      // the step texts of the Background, run before every scenario

  const closeScenario = () => {
    if (!current) return;
    if (current.steps === 0) {
      findings.push(finding('AGSC-E202', file, current.line,
        `${current.keyword} "${current.name}" carries no step`));
    }
    if (current.outline && !current.examples) {
      findings.push(finding('AGSC-E202', file, current.line,
        `Scenario Outline "${current.name}" carries no Examples:`));
    }
    if (current.keyword === 'Background') backgroundSteps = current.stepTexts;
    else scenarios.push({ ...current, stepTexts: [...backgroundSteps, ...current.stepTexts] });
    current = null;
  };

  lines.forEach((raw, index) => {
    const line = raw.replace(/\t/gu, '  ');
    const n = index + 1;
    const trimmed = line.trim();

    if (docString !== null) {
      if (trimmed === docString) docString = null;
      return;
    }
    if (/^("""|```)$/u.test(trimmed)) { docString = trimmed; return; }
    if (trimmed === '' || trimmed.startsWith('#')) { headerColumns = null; return; }

    if (TAG_LINE.test(line)) {
      headerColumns = null;
      pendingTags = trimmed.split(/\s+/u).filter((t) => t.startsWith('@'));
      for (const tag of pendingTags) tags.add(tag);
      return;
    }
    const keyword = /^(Feature|Background|Rule|Scenario Outline|Scenario Template|Scenario|Example|Examples|Scenarios):\s*(.*)$/u.exec(trimmed);
    if (keyword) {
      headerColumns = null;
      const name = keyword[2];
      if (keyword[1] === 'Feature') {
        closeScenario();
        features += 1;
        if (features > 1) findings.push(finding('AGSC-E201', file, n, 'a second Feature: in one file'));
        featureTags = pendingTags;
        pendingTags = [];
        return;
      }
      if (keyword[1] === 'Rule') {
        // A Rule groups scenarios; it is not one, and it carries no steps.
        closeScenario();
        ruleTags = pendingTags;
        pendingTags = [];
        return;
      }
      if (keyword[1] === 'Examples' || keyword[1] === 'Scenarios') {
        if (!current || !current.outline) {
          findings.push(finding('AGSC-E201', file, n, 'Examples: outside a Scenario Outline'));
        } else {
          current.examples = true;
          current.examplesTags.push(pendingTags);
        }
        examplesHeader = null;
        pendingTags = [];
        return;
      }
      closeScenario();
      if (features === 0) findings.push(finding('AGSC-E201', file, n, `${keyword[1]}: before any Feature:`));
      current = {
        examples: false,
        examplesTags: [],
        inherited: [...featureTags, ...ruleTags],
        keyword: keyword[1],
        line: n,
        name,
        outline: keyword[1] === 'Scenario Outline' || keyword[1] === 'Scenario Template',
        placeholders: new Set(),
        stepTexts: [],
        steps: 0,
        tags: pendingTags.slice(),
      };
      examplesHeader = null;
      pendingTags = [];
      return;
    }
    if (trimmed.startsWith('|')) {
      if (!/\|\s*$/u.test(trimmed)) {
        findings.push(finding('AGSC-E201', file, n, 'a table row does not close with "|"'));
        return;
      }
      const columns = trimmed.split('|').slice(1, -1).length;
      if (headerColumns === null) {
        headerColumns = columns;
        if (current && current.outline && current.examples && examplesHeader === null) {
          examplesHeader = new Set(trimmed.split('|').slice(1, -1).map((c) => c.trim()));
          for (const placeholder of current.placeholders) {
            if (!examplesHeader.has(placeholder)) {
              findings.push(finding('AGSC-E201', file, n,
                `the Examples header declares no column <${placeholder}>, which a step of "${current.name}" uses`));
            }
          }
        }
      } else if (columns !== headerColumns) {
        findings.push(finding('AGSC-E201', file, n,
          `the row has ${columns} columns and its header has ${headerColumns}`));
      }
      return;
    }
    headerColumns = null;
    if (STEP.test(line)) {
      if (!current) {
        findings.push(finding('AGSC-E201', file, n, 'a step outside every Scenario and Background'));
        return;
      }
      current.steps += 1;
      current.stepTexts.push(trimmed);
      for (const m of trimmed.matchAll(/<([^<>]+)>/gu)) current.placeholders.add(m[1].trim());
      return;
    }
    // Free description text under Feature: or a Scenario: is legal Gherkin.
  });

  if (docString !== null) findings.push(finding('AGSC-E201', file, lines.length, 'an unterminated doc string'));
  closeScenario();
  if (features === 0) findings.push(finding('AGSC-E201', file, 1, 'the file declares no Feature:'));
  else if (scenarios.length === 0) findings.push(finding('AGSC-E202', file, 1, 'the Feature carries no Scenario'));
  return { features, findings, scenarios, tags };
}

/**
 * The `File -> PRD ids covered` rows of features/README.md, if it is there. The
 * table writes runs in the abbreviated form the pack uses — `PRD-002, 011, 013` —
 * so a bare number continues the prefix that opened the run; a parenthetical aside
 * is prose about another file and is not this file's coverage.
 */
function readmeCoverage(text) {
  const table = new Map();
  for (const line of text.split('\n')) {
    const row = /^\|\s*`([^`]+\.feature)`\s*\|(.*)\|\s*$/u.exec(line);
    if (!row) continue;
    const cells = row[2].split('|');
    const cell = (cells[cells.length - 1] || '').replace(/\([^()]*\)/gu, '').replace(/\*/gu, '');
    const ids = new Set();
    let prefix = null;
    for (const token of cell.split(/[,\s]+/u)) {
      const full = /^((?:PRD|NFR))-(\d{2,3})$/u.exec(token);
      if (full) { prefix = full[1]; ids.add(`${full[1]}-${full[2]}`); continue; }
      const bare = /^(\d{2,3})$/u.exec(token);
      if (bare && prefix) ids.add(`${prefix}-${bare[1]}`);
    }
    if (ids.size) table.set(row[1], ids);
  }
  return table;
}

/** The scenario's own tags with the ones it inherits from its Feature and Rule. */
function effectiveTags(scenario) {
  return new Set([...scenario.inherited, ...scenario.tags]);
}

/** Does the scenario name its actor — itself, by inheritance, or on every Examples block? */
function hasActor(scenario) {
  const own = effectiveTags(scenario);
  if (ACTORS.some((a) => own.has(a))) return true;
  return scenario.examplesTags.length > 0
    && scenario.examplesTags.every((tags) => ACTORS.some((a) => tags.includes(a)));
}

/**
 * The PRD personas each row of the features/README.md coverage table declares for
 * its file: the `P<n>` ids at the start of the cell after the file name.
 * @returns {Map<string, Set<string>>} file name → persona ids
 */
function readmePersonas(text) {
  const table = new Map();
  for (const line of text.split('\n')) {
    const row = /^\|\s*`([^`]+\.feature)`\s*\|([^|]*)\|/u.exec(line);
    if (!row) continue;
    const ids = row[2].match(/\bP\d{1,2}\b/gu);
    if (ids) table.set(row[1], new Set(ids));
  }
  return table;
}

/**
 * The statuses of one Target cell. The part after "reason:" is the reason; the G
 * cells carry their change ids, a comma continuing the list (`G→E3, E5`).
 * @returns {{status:Set<string>, gaps:string[], reason:string}}
 */
function parseTarget(text) {
  const cut = text.search(/reason:/iu);
  let head = cut >= 0 ? text.slice(0, cut) : text;
  const reason = cut >= 0 ? text.slice(cut + 'reason:'.length).trim() : '';
  const gaps = [];
  const g = new RegExp(`G\\s*(?:→|->)\\s*(${CHANGE}(?:\\s*,\\s*${CHANGE})*)`, 'gu');
  head = head.replace(g, (_, list) => {
    gaps.push(...list.split(',').map((x) => x.trim()));
    return ' ';
  });
  const status = new Set(gaps.length ? ['G'] : []);
  for (const m of head.matchAll(/(?<![\w.])(B|C|P|U|rec|1\.1)(?![\w.])/gu)) status.add(m[1]);
  return { gaps, reason, status };
}

/** A reason cell that says nothing ("", "—", "-") is no reason. */
function cleanReason(text) {
  const t = (text || '').trim();
  return /^[—–-]*$/u.test(t) ? '' : t;
}

/**
 * The persona rows and the surfaces of features/MATRIX.md (see the header comment
 * for the table format), and the problems of the file's own form.
 * @returns {{rows:Array, surfaces:Array, problems:Array<{code:string,line:number,message:string}>}}
 */
function readMatrix(text) {
  const rows = [];
  const surfaces = [];
  const problems = [];
  let header = null;
  let kind = null;
  let target = -1;
  text.split('\n').forEach((raw, index) => {
    const line = raw.trim();
    if (!line.startsWith('|')) { header = null; return; }
    const cells = line.replace(/^\||\|$/gu, '').split('|').map((c) => c.trim().replace(/`/gu, ''));
    if (header === null) {
      header = cells.map((c) => c.toLowerCase());
      kind = { row: 'row', surface: 'surface' }[header[0]] || null;
      target = header.findIndex((h) => h.startsWith('target'));
      if (kind && target < 0) {
        problems.push({ code: 'AGSC-E202', line: index + 1, message: 'a table of features/MATRIX.md has no Target column' });
        kind = null;
      }
      return;
    }
    if (!kind || /^:?-+:?$/u.test(cells[0])) return;
    const column = (re) => {
      const k = header.findIndex((h) => re.test(h));
      return k >= 0 ? (cells[k] || '') : '';
    };
    const parsed = parseTarget(cells[target] || '');
    const entry = {
      gaps: parsed.gaps,
      line: index + 1,
      reason: cleanReason(column(/^reason/u)) || parsed.reason,
      status: parsed.status,
      stems: [...new Set(column(/^(feature|scenario)/u).match(/persona-[0-9a-z]+/gu) || [])],
      target: cells[target] || '',
    };
    if (kind === 'surface') { surfaces.push({ label: cells[0], ...entry }); return; }
    if (!/^[A-Z]\d+$/u.test(cells[0])) {
      problems.push({ code: 'AGSC-E204', line: index + 1, message: `the row id "${cells[0]}" is not a capital letter and a number` });
      return;
    }
    rows.push({ id: cells[0], ...entry });
  });
  return { problems, rows, surfaces };
}

/**
 * The pending files of the acceptance runner: `<feature-stem>--<slug>.json`, each
 * naming its scenario. Only what the matrix needs is read here; the runner holds
 * the other rules of these files.
 * @returns {Map<string, {file:string, class:string, closes_in?:string, stem:string}>} keyed `<stem>#<scenario>`
 */
function readPendingFiles(root) {
  const dir = path.join(root, ...PENDING_DIR.split('/'));
  const out = new Map();
  if (!fs.existsSync(dir)) return out;
  for (const name of fs.readdirSync(dir).filter((f) => f.endsWith('.json')).sort(compareCodePoint)) {
    let entry;
    try { entry = JSON.parse(fs.readFileSync(path.join(dir, name), 'utf8')); } catch { continue; }
    const cut = name.indexOf('--');
    if (cut < 1 || !entry || typeof entry.scenario !== 'string') continue;
    const stem = name.slice(0, cut);
    out.set(`${stem}#${entry.scenario}`, { ...entry, file: `${PENDING_DIR}/${name}`, stem });
  }
  return out;
}

/**
 * The matrix findings: coverage of every B/C row and surface, the reasons of U and
 * rec, the G cells against the gap files both ways, and the PRD personas.
 * @param {{rows:Array, surfaces:Array}} matrix
 * @param {Array<{stem:string, file:string, name:string, tags:Set<string>, runs:boolean}>} scenarios
 * @param {Map} pending
 * @param {{prdPersonas:string[], declared:Set<string>, severity:string}} context
 */
function matrixFindings(matrix, scenarios, pending, context) {
  const out = [];
  const add = (code, file, line, message) => out.push(finding(code, file, line, message, context.severity));
  const stems = new Set(scenarios.map((s) => s.stem));
  const runsTagged = (id) => scenarios.some((s) => s.runs && s.tags.has(`@matrix-${id}`));
  const gaps = [...pending.values()].filter((p) => p.class === 'gap');
  const scenarioOf = (p) => scenarios.find((s) => s.stem === p.stem && s.name === p.scenario);
  const reasonNeeded = (entry, what) => {
    for (const s of ['U', 'rec']) {
      if (entry.status.has(s) && !entry.reason) add('AGSC-E202', MATRIX_FILE, entry.line, `${what} is marked ${s} and records no reason`);
    }
  };
  for (const row of matrix.rows) {
    if (row.status.size === 0) add('AGSC-E203', MATRIX_FILE, row.line, `row ${row.id}: the target "${row.target}" names no status (B, C, G→…, P, U, rec, 1.1)`);
    if ((row.status.has('B') || row.status.has('C')) && !runsTagged(row.id)) {
      add('AGSC-E202', MATRIX_FILE, row.line, `row ${row.id} is covered by no scenario that runs (no scenario tagged @matrix-${row.id} runs, here or where its need is present)`);
    }
    reasonNeeded(row, `row ${row.id}`);
    for (const change of row.gaps) {
      const answered = gaps.some((p) => p.closes_in === change && (scenarioOf(p) || { tags: new Set() }).tags.has(`@matrix-${row.id}`));
      if (!answered) add('AGSC-E202', MATRIX_FILE, row.line, `row ${row.id} waits for ${change} and no gap file names it (class gap, closes_in ${change}, its scenario tagged @matrix-${row.id})`);
    }
  }
  for (const surface of matrix.surfaces) {
    const what = `surface "${surface.label}"`;
    if (surface.status.size === 0) add('AGSC-E203', MATRIX_FILE, surface.line, `${what}: the target "${surface.target}" names no status (B, C, G→…, P, U, rec, 1.1)`);
    if (surface.status.has('B') || surface.status.has('C')) {
      if (surface.stems.length === 0) add('AGSC-E202', MATRIX_FILE, surface.line, `${what} names no feature (persona-x) in its Scenario cell`);
      for (const stem of surface.stems) {
        const own = [...stems].filter((s) => s === stem || s.startsWith(`${stem}-`));
        if (own.length === 0) add('AGSC-E202', MATRIX_FILE, surface.line, `${what} names ${stem}, which has no feature file`);
        else if (!scenarios.some((s) => own.includes(s.stem) && s.runs)) add('AGSC-E202', MATRIX_FILE, surface.line, `${what} names ${stem}, which has no scenario that runs`);
      }
    }
    reasonNeeded(surface, what);
    for (const change of surface.gaps) {
      const answered = gaps.some((p) => p.closes_in === change && surface.stems.some((stem) => p.stem === stem || p.stem.startsWith(`${stem}-`)));
      if (!answered) add('AGSC-E202', MATRIX_FILE, surface.line, `${what} waits for ${change} and no gap file of ${surface.stems.join(', ') || 'its features'} names it`);
    }
  }
  for (const p of gaps) {
    const rowIds = [...((scenarioOf(p) || { tags: new Set() }).tags)].map((t) => MATRIX_TAG.exec(t)).filter(Boolean).map((m) => m[1]);
    const byRow = matrix.rows.some((r) => rowIds.includes(r.id) && r.gaps.includes(p.closes_in));
    const bySurface = matrix.surfaces.some((s) => s.gaps.includes(p.closes_in) && s.stems.some((stem) => p.stem === stem || p.stem.startsWith(`${stem}-`)));
    if (byRow || bySurface) continue;
    const name = path.posix.basename(p.file);
    add('AGSC-E201', p.file, 1, rowIds.length
      ? `${name} closes in ${p.closes_in} and no row it tags (${rowIds.join(', ')}) waits for ${p.closes_in}, nor any surface of ${p.stem}`
      : `${name} closes in ${p.closes_in} and its scenario carries no @matrix- tag, and no surface of ${p.stem} waits for ${p.closes_in}`);
  }
  for (const id of context.prdPersonas) {
    if (!context.declared.has(id)) add('AGSC-E202', 'docs/PRD.md', 1, `persona ${id} of docs/PRD.md has no feature file (none says "As ${id}" or lists it in the features/README.md table)`);
  }
  return out;
}

/**
 * The verb set of AGSC-09-07 as `spec/09-conformance.md` states it: the code spans
 * of the list after "The verb set is exactly …:". Empty when the text holds no list.
 * @returns {string[]}
 */
function cliVerbs(text) {
  const rule = /\*\*AGSC-09-07\*\*[^\n]*?The verb set is exactly[^:\n]*:((?:\s*`[a-z][a-z-]*`,?)+)/u.exec(text);
  return rule ? [...rule[1].matchAll(/`([a-z][a-z-]*)`/gu)].map((m) => m[1]) : [];
}

/**
 * A surface named "CLI verbs" with status B claims every verb: each verb of the
 * AGSC-09-07 set must appear as `agsc <verb>` or `agentic-system-core <verb>` in the
 * steps of a scenario that runs. Checked only where the pack sits beside the
 * specification (`spec/09-conformance.md` under the root).
 * @param {{surfaces:Array}} matrix
 * @param {Array<{runs:boolean, steps:string[]}>} scenarios
 * @param {string|null} specText
 * @param {string} severity
 */
function verbFindings(matrix, scenarios, specText, severity) {
  const out = [];
  if (specText === null) return out;
  const verbs = cliVerbs(specText);
  const running = scenarios.filter((s) => s.runs).flatMap((s) => s.steps);
  for (const surface of matrix.surfaces.filter((s) => /^CLI verbs\b/iu.test(s.label) && s.status.has('B'))) {
    const what = `surface "${surface.label}" claims every verb`;
    if (verbs.length === 0) {
      out.push(finding('AGSC-E202', MATRIX_FILE, surface.line, `${what}, and spec/09-conformance.md states no verb set to check (AGSC-09-07)`, severity));
      continue;
    }
    for (const verb of verbs) {
      const used = new RegExp(`(?:^|[^\\w-])(?:agsc|agentic-system-core) ${verb}(?![\\w-])`, 'u');
      if (running.some((step) => used.test(step))) continue;
      out.push(finding('AGSC-E202', MATRIX_FILE, surface.line,
        `${what}, and no scenario that runs has "agsc ${verb}" or "agentic-system-core ${verb}" in a step (AGSC-09-07)`, severity));
    }
  }
  return out;
}

function envelopeOf(findings, declared, version) {
  findings.sort((a, b) => compareCodePoint(a.file, b.file) || a.line - b.line || a.col - b.col
    || compareCodePoint(a.code, b.code) || compareCodePoint(a.message, b.message));
  const counts = {
    error: findings.filter((f) => f.severity === 'error').length,
    warn: findings.filter((f) => f.severity === 'warn').length,
  };
  return {
    counts,
    findings,
    schema: 'agsc.diagnostics.v1',
    spec_version: declared,
    status: counts.error === 0 ? 'pass' : 'fail',
    verb: 'validate-features',
    version,
  };
}

function specVersion(root) {
  try {
    return (fs.readFileSync(path.join(root, 'spec', '00-overview.md'), 'utf8')
      .match(/\d+\.\d+\.\d+(?:-[a-z]+\.\d+)?/u) || ['unknown'])[0];
  } catch { return 'unknown'; }
}

function packageVersion(root) {
  try { return JSON.parse(fs.readFileSync(path.join(root, 'package.json'), 'utf8')).version; } catch { return '0.0.0'; }
}

/**
 * @param {string[]} argv
 * @param {{out:(s:string)=>void, err:(s:string)=>void}} io
 * @returns {number} exit code: 0 pass, 1 fail, 2 usage
 */
function run(argv, io) {
  const out = (io && io.out) || ((s) => process.stdout.write(s));
  const err = (io && io.err) || ((s) => process.stderr.write(s));
  const usage = (message) => { err(`validate-features: ${message}\n${HELP}`); return 2; };

  const flags = new Set();
  let target = DEFAULT_ROOT;
  let sawTarget = false;
  for (const arg of argv) {
    if (arg === '--help' || arg === '-h') { out(HELP); return 0; }
    if (arg === '--json' || arg === '--quiet' || arg === '--strict-matrix') flags.add(arg);
    else if (arg.startsWith('-')) return usage(`unknown flag ${arg} (AGSC-E002)`);
    else if (sawTarget) return usage(`unexpected argument ${arg} (AGSC-E002)`);
    else { target = path.resolve(arg); sawTarget = true; }
  }
  const direct = fs.existsSync(path.join(target, 'features'))
    ? path.join(target, 'features')
    : target;
  if (!fs.existsSync(direct) || !fs.statSync(direct).isDirectory()) {
    return usage(`no features directory at ${direct} (AGSC-E901)`);
  }
  const root = path.basename(direct) === 'features' ? path.dirname(direct) : direct;

  const findings = [];
  const prdPath = path.join(root, 'docs', 'PRD.md');
  const prdText = fs.existsSync(prdPath) ? fs.readFileSync(prdPath, 'utf8') : null;
  const prdIds = new Set(prdText ? prdText.match(/(?:PRD|NFR)-\d{2,3}/gu) || [] : []);
  const readmePath = path.join(direct, 'README.md');
  const coverage = fs.existsSync(readmePath)
    ? readmeCoverage(fs.readFileSync(readmePath, 'utf8'))
    : new Map();

  const readmePersonasTable = fs.existsSync(readmePath)
    ? readmePersonas(fs.readFileSync(readmePath, 'utf8'))
    : new Map();
  const matrixPath = path.join(direct, 'MATRIX.md');
  const matrix = fs.existsSync(matrixPath) ? readMatrix(fs.readFileSync(matrixPath, 'utf8')) : null;
  const pending = readPendingFiles(root);
  const all = [];                // every scenario, with what the matrix needs of it
  const declared = new Set();    // the PRD personas some feature file declares

  const names = fs.readdirSync(direct).filter((f) => f.endsWith('.feature')).sort();
  // zero files read is not a clean pack. The directory resolution above
  // falls back to the argument itself, so a distribution with no `features/` would
  // otherwise report `pass` over an empty list — a gate that protects nothing.
  if (names.length === 0) {
    findings.push(finding('AGSC-E901', path.relative(root, direct).split(path.sep).join('/') || 'features',
      1, `no .feature file under ${direct}: there is nothing to validate (AGSC-09-90)`));
  }
  let scenarios = 0;
  const covered = new Set();
  for (const name of names) {
    const file = path.relative(root, path.join(direct, name)).split(path.sep).join('/');
    const raw = fs.readFileSync(path.join(direct, name), 'utf8');
    if (raw.charCodeAt(0) === 0xfeff) findings.push(finding('AGSC-E108', file, 1, 'byte-order mark (AGSC-01-14)'));
    if (raw.includes('\r')) findings.push(finding('AGSC-E108', file, 1, 'CR or CRLF line endings (AGSC-01-14)'));
    if (!raw.endsWith('\n') || raw.endsWith('\n\n')) {
      findings.push(finding('AGSC-E108', file, 1, 'the file must end with exactly one LF (AGSC-01-14)'));
    }
    if (raw.normalize('NFC') !== raw) findings.push(finding('AGSC-E108', file, 1, 'the file is not NFC (AGSC-01-14)'));

    const parsed = parseFeature(raw, file);
    findings.push(...parsed.findings);
    scenarios += parsed.scenarios.length;
    const stem = name.replace(/\.feature$/u, '');
    for (const s of parsed.scenarios) {
      const entry = pending.get(`${stem}#${s.name}`);
      all.push({ file, line: s.line, name: s.name, runs: !entry || entry.class === 'conditional', stem, steps: s.stepTexts, tags: effectiveTags(s) });
      if (!hasActor(s)) {
        findings.push(finding('AGSC-E202', file, s.line, `${s.keyword} "${s.name}" carries no actor tag (@human or @agent)`,
          matrix ? 'error' : 'warn'));
      }
    }
    for (const m of raw.matchAll(/^\s*As (P\d{1,2})\b/gmu)) declared.add(m[1]);
    for (const id of readmePersonasTable.get(name) || []) declared.add(id);

    const ids = new Set();
    for (const m of raw.matchAll(ID_TAG)) ids.add(m[1]);
    for (const id of [...ids].sort()) {
      covered.add(id);
      if (prdText && !prdIds.has(id)) {
        findings.push(finding('AGSC-E201', file, 1,
          `tag @${id} names a requirement docs/PRD.md does not define (PRD-054 closure)`));
      }
    }
    const declaredIds = coverage.get(name);
    if (declaredIds) {
      for (const id of [...declaredIds].sort()) {
        if (!ids.has(id)) {
          findings.push(finding('AGSC-E207', file, 1,
            `features/README.md lists ${id} for this file and no scenario tags it`, 'warn'));
        }
      }
      for (const id of [...ids].sort()) {
        if (!declaredIds.has(id)) {
          findings.push(finding('AGSC-E207', file, 1,
            `this file tags ${id} and the coverage table of features/README.md does not list it`, 'warn'));
        }
      }
    }
  }

  const rowIds = new Set(matrix ? matrix.rows.map((r) => r.id) : []);
  for (const s of all) {
    for (const tag of [...s.tags].sort(compareCodePoint)) {
      const m = MATRIX_TAG.exec(tag);
      if (m && !rowIds.has(m[1])) {
        findings.push(finding('AGSC-E201', s.file, s.line, `tag ${tag} names a row ${MATRIX_FILE} does not define`));
      }
    }
  }
  if (flags.has('--strict-matrix') && !matrix) {
    findings.push(finding('AGSC-E901', MATRIX_FILE, 1, `--strict-matrix needs ${MATRIX_FILE}, and the pack carries none`));
  }
  if (matrix) {
    const severity = flags.has('--strict-matrix') ? 'error' : 'warn';
    for (const p of matrix.problems) findings.push(finding(p.code, MATRIX_FILE, p.line, p.message, severity));
    const prdPersonas = prdText ? [...new Set([...prdText.matchAll(/^\|\s*(P\d{1,2})\s*\|/gmu)].map((m) => m[1]))] : [];
    findings.push(...matrixFindings(matrix, all, pending, { declared, prdPersonas, severity }));
    const specPath = path.join(root, 'spec', '09-conformance.md');
    findings.push(...verbFindings(matrix, all, fs.existsSync(specPath) ? fs.readFileSync(specPath, 'utf8') : null, severity));
  }

  const uncovered = prdText ? [...prdIds].filter((id) => !covered.has(id)).length : 0;
  const envelope = envelopeOf(findings, specVersion(root), packageVersion(root));
  if (flags.has('--json')) {
    out(`${canonicalize(envelope)}\n`);
  } else if (!flags.has('--quiet')) {
    for (const f of envelope.findings) {
      err(`${f.severity}: ${f.file}:${f.line}:${f.col} ${f.code} ${f.message}\n`);
    }
    out(`validate-features: ${names.length} input file(s) read, ${scenarios} scenarios, ${covered.size} requirement ids tagged, `
      + `${envelope.counts.error} error, ${envelope.counts.warn} warn; `
      + `requirement ids no scenario tags (informational): ${uncovered}`
      + `${matrix ? `; matrix: ${matrix.rows.length} rows, ${matrix.surfaces.length} surfaces, `
        + `${[...pending.values()].filter((p) => p.class === 'gap').length} gap files` : ''}\n`);
  }
  return envelope.status === 'pass' ? 0 : 1;
}

/* c8 ignore next */
if (require.main === module) process.exit(run(process.argv.slice(2)));

module.exports = {
  HELP, canonicalize, cliVerbs, compareCodePoint, parseFeature, parseTarget, readMatrix, readmeCoverage, readmePersonas, run,
};
