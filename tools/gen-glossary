#!/usr/bin/env node
// Generates docs/GLOSSARY.md — the ubiquitous language of the specification — from the
// definition itself: spec/00 §0.2 terms, the fourteen Link keys of AGSC-03-01, the 52
// ontology terms (label + comment) of ontology/agsc.ttl, and the closed boundary lists of
// spec/11. Never typed by hand (docs/ARCHITECTURE-DDD.md §3). Node stdlib only, zero
// dependencies; exit 0 after writing, exit 1 if a source is missing. [AGSC-09-90, DS-4]
'use strict';
const fs = require('fs'), path = require('path');
const root = path.resolve(__dirname, '..');
const read = p => fs.readFileSync(path.join(root, p), 'utf8');
const out = [];
out.push('# Glossary — the ubiquitous language, generated');
out.push('');
out.push('*Generated by `node tools/gen-glossary` from `spec/00` §0.2, `spec/03` AGSC-03-01, `spec/11` and `ontology/agsc.ttl`. Do not edit: change the source and regenerate. Rules win over this page.*');
out.push('');

// 1. spec/00 §0.2 terms — lines "- **AGSC-00-nn** **Term** — definition"
out.push('## 1. Terms of the specification (spec/00 §0.2)');
out.push('');
const s00 = read('spec/00-overview.md');
const sec = s00.slice(s00.indexOf('## 0.2 Terms'), s00.indexOf('## 0.3'));
for (const m of sec.matchAll(/^- \*\*(AGSC-00-\d{2}[a-z]?)\*\* (.*)$/gm)) {
  const text = m[2].replace(/\s*\[[^\]]*\]\s*$/, '');
  out.push(`- ${text} *(${m[1]})*`);
}
out.push('');

// 2. Link keys
out.push('## 2. The fourteen Link keys (AGSC-03-01)');
out.push('');
const s03 = read('spec/03-links.md');
const r0301 = (s03.match(/- \*\*AGSC-03-01\*\*[^\n]*/) || [''])[0];
const keys = [...new Set((r0301.match(/`[a-z-]+`/g) || []).map(k => k.slice(1, -1)))]
  .filter(k => !['none'].includes(k));
out.push(keys.map(k => '`' + k + '`').join(' · '));
out.push('');
out.push('Core nine carry composition semantics (spec/03 §3.5); the Mode-2 five (`implements`, `verifies`, `covers`, `blocked-by`, `decided-by`) are navigational and provenance edges. Inverses are computed, never authored (spec/03 §3.2).');
out.push('');

// 3. ontology terms
out.push('## 3. Vocabulary terms (ontology/agsc.ttl, CC0)');
out.push('');
const ttl = read('ontology/agsc.ttl');
const blocks = ttl.split(/\n\n+/).filter(b => /^asc:[A-Za-z0-9]+\n/.test(b));
const rows = [];
for (const b of blocks) {
  const term = b.match(/^asc:[A-Za-z0-9]+/)[0];
  const type = (b.match(/\n    a (owl:\w+)/) || ['', '?'])[1].replace('owl:', '');
  const label = (b.match(/rdfs:label "([^"]*)"/) || ['', ''])[1];
  const comment = (b.match(/rdfs:comment "([^"]*)"/) || ['', ''])[1];
  const range = (b.match(/rdfs:range (\S+)/) || ['', ''])[1].replace(/ \.$/, '');
  const domain = (b.match(/rdfs:domain (\S+)/) || ['', ''])[1];
  const sup = (b.match(/rdfs:subClassOf (\S+)/) || ['', ''])[1].replace(/ \.$/, '');
  rows.push({ term, type, label, comment, range, domain, sup });
}
out.push('| Term | Kind | Label | Domain → Range / Super-class | Definition |');
out.push('|---|---|---|---|---|');
for (const r of rows) {
  const dr = r.type === 'Class' ? (r.sup ? `⊑ \`${r.sup}\`` : '') : `${r.domain ? '`' + r.domain + '`' : '—'} → ${r.range ? '`' + r.range.replace(/\.$/, '') + '`' : '—'}`;
  out.push(`| \`${r.term}\` | ${r.type} | ${r.label} | ${dr} | ${r.comment.replace(/\|/g, '\\|')} |`);
}
out.push('');
out.push(`${rows.filter(r => r.type === 'Class').length} classes · ${rows.filter(r => r.type === 'ObjectProperty').length} object properties · ${rows.filter(r => r.type === 'DatatypeProperty').length} datatype properties (counts from the file, see \`tools/count-artifacts\`).`);
out.push('');

// 4. boundary lists
out.push('## 4. Boundary vocabulary (spec/11)');
out.push('');
const s11 = read('spec/11-boundary.md');
const pick = (id) => ((s11.match(new RegExp('- \\*\\*' + id + '\\*\\*[^\\n]*')) || [''])[0]);
const listAfter = (text, label) => { const m = text.match(new RegExp(label + '[^`]*((?:`[^`]+`[,/ or]*)+)')); return m ? [...m[1].matchAll(/`([^`]+)`/g)].map(x => x[1]) : []; };
const surf = listAfter(pick('AGSC-11-16'), 'agsc-surface` \\(one value from');
const acc = listAfter(pick('AGSC-11-16'), 'agsc-access` \\(one value:');
out.push(`- **Surface** — an agent-facing entry a node serves and declares: ${surf.map(x => '`' + x + '`').join(', ')} (AGSC-11-16).`);
out.push(`- **Access class** — what a reader needs before invoking a surface: ${acc.map(x => '`' + x + '`').join(', ')} (AGSC-11-16).`);
out.push('- **Visibility** — `public` or `restricted` (AGSC-11-20); the discovery document is readable at both.');
out.push('- **Contribute mode** — `pr`, `channel` or `form` (AGSC-11-14): where a proposal from anyone goes.');
out.push('- **Peer** — another node named by its canonical well-known URL (AGSC-11-06); checked mutually, never fetched at build.');
out.push('- **Walk** — a client-side traversal of peers bounded by `hop_limit`, `fan_out` and `max_requests` (AGSC-11-10).');
out.push('- **Origin marking** — every peer-derived result carries `trust: untrusted` and the peer Bundle IRI (AGSC-11-11).');
out.push('- **Tombstone** — the state of a node that stopped publishing: a valid link set with `agsc-tombstone` (AGSC-11-23).');
out.push('- **Retired** — an item status that keeps the IRI and page and leaves every export (AGSC-11-22).');
out.push('- **Plugin contract** — declare · pin · inherit · prove (AGSC-11-16…19).');
out.push('');
fs.writeFileSync(path.join(root, 'docs/GLOSSARY.md'), out.join('\n') + '\n');
console.log(`docs/GLOSSARY.md: ${rows.length} vocabulary terms, ${keys.length} link keys`);
