#!/usr/bin/env node
// tools/gen-ontology-questions — generates docs/ONTOLOGY-QUESTIONS.md, the ten questions
// of AGSC-05-34 with the SPARQL text that states each over graph.nq, from the one data
// file docs/ontology-questions.json. The same file feeds the query page examples
// (AGSC-06-39). Node stdlib only, deterministic.
//
//   gen-ontology-questions [--check] [--help]
//
// With no flag it writes the page. `--check` writes nothing and exits 1 when the committed
// page differs from what the data file generates. Exit 0 written or current, 1 stale or
// the data file missing, 2 usage.
'use strict';
const fs = require('fs'), path = require('path');

const HELP = `gen-ontology-questions [--check] [--help]

  Generates docs/ONTOLOGY-QUESTIONS.md from docs/ontology-questions.json.

  --check  write nothing; exit 1 when the page is not what the data file gives
  --help   this text

  Exit 0 written or current, 1 stale or the data file missing, 2 usage.
`;

const PAGE_START = [
  '# The ten questions of the graph, and the SPARQL that states them',
  '',
  '*Generated by `node tools/gen-ontology-questions` from `docs/ontology-questions.json`. Do not edit: change the data file and regenerate. Informative: the rule is AGSC-05-34, which wins over this page.*',
  '',
  'Each question is answered by a pure function of the published projection (`src/knowledge/questions.js`). The SPARQL below states the same question over `graph.nq` for a person who loads that file into a store; the engine does not run it. On a graph with a cycle, the queries that follow `+` paths (questions 1, 3, 6 and 8) also return the subject itself; drop it, as the function does. A store must treat a plain string literal and an `xsd:string` literal as the same term (RDF 1.1): Oxigraph does, and a store that does not (rdflib 7.6.0 does not) gives a different answer to question 9.',
  '',
];

function section(q) {
  return [
    `## ${q.number}. ${q.question}`,
    '',
    `- Subject: ${q.subject}.`,
    `- Answer: ${q.answer}.`,
    '',
    '```sparql',
    q.sparql,
    '```',
    '',
  ];
}

function generate(root) {
  const data = JSON.parse(fs.readFileSync(path.join(root, 'docs', 'ontology-questions.json'), 'utf8'));
  const prefixes = data.prefixes.map((p) => `PREFIX ${p}`);
  const lines = [...PAGE_START, 'Prefixes used by every query:', '', '```sparql', ...prefixes, '```', ''];
  for (const q of data.questions) lines.push(...section(q));
  return { count: data.questions.length, text: lines.join('\n') };
}

/**
 * @param {string[]} argv
 * @param {{out?:Function, err?:Function, root?:string}} [io]
 * @returns {number}
 */
function run(argv, io = {}) {
  const out = io.out || ((t) => process.stdout.write(t));
  const err = io.err || ((t) => process.stderr.write(t));
  const root = io.root || path.resolve(__dirname, '..');
  let check = false;
  for (const arg of argv) {
    if (arg === '--help' || arg === '-h') { out(HELP); return 0; }
    if (arg === '--check') { check = true; continue; }
    err(`gen-ontology-questions: unknown argument ${arg} (AGSC-E002)\n${HELP}`);
    return 2;
  }
  let generated;
  try { generated = generate(root); } catch (e) {
    err(`gen-ontology-questions: the data file is missing or unreadable: ${e.message} (AGSC-E901)\n`);
    return 1;
  }
  const target = path.join(root, 'docs', 'ONTOLOGY-QUESTIONS.md');
  if (check) {
    const current = fs.existsSync(target) ? fs.readFileSync(target, 'utf8') : null;
    if (current !== generated.text) {
      err('gen-ontology-questions: docs/ONTOLOGY-QUESTIONS.md is not what the data file generates; run node tools/gen-ontology-questions (AGSC-E202)\n');
      return 1;
    }
    out(`docs/ONTOLOGY-QUESTIONS.md: current (${generated.count} questions)\n`);
    return 0;
  }
  fs.writeFileSync(target, generated.text);
  out(`docs/ONTOLOGY-QUESTIONS.md: ${generated.count} questions\n`);
  return 0;
}

/* c8 ignore next */
if (require.main === module) process.exit(run(process.argv.slice(2)));

module.exports = { HELP, generate, run };
