#!/usr/bin/env node
'use strict';
// tools/validate-spec — the "specnits" validator of AGSC-09-90 and AGSC-09-91.
//
// INDEPENDENT BY CONSTRUCTION: Node built-ins only, no import from `src/`. A
// validator that imported the engine it validates would prove nothing (AGSC-09-90).
//
//   validate-spec [--json] [--quiet] [--help] [<root>]
//
// <root> is the distribution root that holds `spec/`; it defaults to the directory
// above this file. Exit 0 pass, 1 fail, 2 usage. Deterministic: no clock, no
// network, findings sorted by (file, line, col, code) per AGSC-09-10.
//
// Checks — the faults AGSC-09-91 names, plus the two carve-outs it states:
//   AGSC-E201  duplicate rule id; a rule id referenced but defined nowhere; a code
//              in more than one registry row; a code a rule ASSIGNS whose §9.4 row
//              does not name that rule; a registry row naming a rule id that does
//              not exist; a `spec_version` literal in spec/, tests/vectors/** or
//              docs/ differing from the spec/00 declaration; a rule id `<n>a` that
//              does not immediately follow rule `<n>`; a trace tag naming a PRD/NFR
//              id docs/PRD.md does not define; (warning) a registered code no rule
//              names at all
//   AGSC-E202  a MUST/SHOULD sentence with no rule id; a rule with no trace bracket
//   AGSC-E203  an error code used in spec/01-11 but absent from the §9.4 registry
//   AGSC-E901  a required input file is missing
//
// Carve-out (a), AGSC-09-91: a version literal on a line that is plainly a record of
// the past — carrying, before the literal, one of *at, since, amended, added,
// withdrawn, before, until, from* as a whole word — is not a fault. This is the
// behaviour of `tools/count-artifacts`, which the rule names as the reference.
// Carve-out (b), AGSC-09-91: a rule whose text includes a table, a fenced block or an
// ABNF block carries its trace bracket after that block; the bracket that follows the
// block is that rule's. A rule with no trace bracket anywhere is still a fault.
// The BCP 14 boilerplate of spec/00 is not a normative sentence — it is the sentence
// that defines the key words — so a line naming BCP 14, RFC 2119 or RFC 8174 is
// exempt from the MUST/SHOULD check.
//
// `D` ids cannot be resolved from a distribution: the decision register is not
// published. A trace tag naming `D<nn>` is therefore counted, never faulted;
// `PRD-<nnn>` and `NFR-<nn>` are resolved against `docs/PRD.md` when it is present.

const fs = require('node:fs');
const path = require('node:path');

const DEFAULT_ROOT = path.resolve(__dirname, '..');
const HELP = `validate-spec [--json] [--quiet] [--help] [<root>]

  Checks spec/*.md against AGSC-09-91: rule-id uniqueness and resolution, the
  MUST/SHOULD grammar, trace-bracket presence, error-code closure against the
  section 9.4 registry, and version-literal agreement with the spec/00 declaration.

  --json    emit the AGSC-09-11 diagnostics envelope on stdout
  --quiet   emit nothing; the exit code is the result
  --help    this text

  Exit 0 pass, 1 fail, 2 usage.
`;

/** RFC 2119/BCP 14 key words, in capitals only (AGSC-00-01). */
const NORMATIVE = /(?<![\w-])(MUST NOT|MUST|SHOULD NOT|SHOULD|SHALL NOT|SHALL|REQUIRED|RECOMMENDED)(?![\w-])/u;
/** AGSC-09-91 carve-out (a): the words that mark a line as a record of the past. */
const HISTORY_WORD = /(?<![\w-])(at|since|amended|added|withdrawn|before|until|from)(?![\w-])/iu;
const RULE_ID_G = /AGSC-\d{2}-\d{2,3}[a-z]?/gu;
const RULE_ID = /AGSC-\d{2}-\d{2,3}[a-z]?/u;
const RULE_BULLET = /^- \*\*(AGSC-\d{2}-\d{2,3}[a-z]?)\*\*/u;
const CODE_G = /AGSC-E\d{3}/gu;
/** The specification's own assigning constructions: `… is AGSC-Ennn`, `… are …`, `… → …`. */
const ASSIGNS_CODE = /(?:\bis\b|\bare\b|→)\s*\*{0,2}`?(AGSC-E\d{3})`?/gu;
const VERSION_LITERAL = /\d+\.\d+\.\d+-rc\.\d+/gu;

// --------------------------------------------------------------------------
// JCS (RFC 8785), the sliver this tool needs: NFC member names, UTF-16 order.
// --------------------------------------------------------------------------
function canonicalize(value) {
  if (value === null) return 'null';
  if (typeof value === 'boolean') return value ? 'true' : 'false';
  if (typeof value === 'number') return value === 0 ? '0' : String(value);
  if (typeof value === 'string') return JSON.stringify(value);
  if (Array.isArray(value)) return `[${value.map(canonicalize).join(',')}]`;
  const names = Object.keys(value).map((k) => k.normalize('NFC')).sort();
  return `{${names.map((n) => `${JSON.stringify(n)}:${canonicalize(value[n])}`).join(',')}}`;
}

/** AGSC-09-10: order by (file, line, col, code), compared code-point-wise. */
function compareCodePoint(a, b) {
  const ia = a[Symbol.iterator]();
  const ib = b[Symbol.iterator]();
  for (;;) {
    const x = ia.next();
    const y = ib.next();
    if (x.done && y.done) return 0;
    if (x.done) return -1;
    if (y.done) return 1;
    const cx = x.value.codePointAt(0);
    const cy = y.value.codePointAt(0);
    if (cx !== cy) return cx < cy ? -1 : 1;
  }
}

function finding(code, file, line, message, severity = 'error') {
  return { code, col: 1, file, line, message, severity };
}

function walk(dir) {
  return fs.readdirSync(dir, { withFileTypes: true }).flatMap((e) => (e.isDirectory()
    ? walk(path.join(dir, e.name))
    : [path.join(dir, e.name)]));
}

/**
 * Split one spec file into rule blocks. A block runs from its `- **AGSC-nn-nn**`
 * bullet to the line before the next rule bullet or the next heading, so that the
 * table, fenced block or ABNF block of carve-out (b) — and the trace bracket that
 * follows it — belong to the rule that opened the block.
 */
function ruleBlocks(text, file) {
  const blocks = [];
  let current = null;
  text.split('\n').forEach((line, index) => {
    const bullet = RULE_BULLET.exec(line);
    if (bullet) {
      current = { file, id: bullet[1], line: index + 1, lines: [line] };
      blocks.push(current);
      return;
    }
    if (/^#{1,6} /u.test(line)) { current = null; return; }
    if (current) current.lines.push(line);
  });
  for (const block of blocks) block.text = block.lines.join('\n');
  return blocks;
}

/**
 * The trace bracket of one line, or null. "Trailing brackets cite the requirement
 * each rule serves" (spec/00): the bracket ends the line, save for an italic
 * parenthetical note that a later release candidate appended after it.
 */
function traceBracket(line) {
  const stripped = line.replace(/(\s*\*\([^()]*(?:\([^()]*\)[^()]*)*\)\*)+\s*$/u, '');
  const match = /\[([^[\]]+)\]\s*$/u.exec(stripped);
  return match ? match[1] : null;
}

/** The 1-based line numbers of a file that sit inside a fenced block. */
function fencedLines(text) {
  const inside = new Set();
  let open = false;
  text.split('\n').forEach((line, index) => {
    if (/^\s*(```|~~~)/u.test(line)) { open = !open; inside.add(index + 1); return; }
    if (open) inside.add(index + 1);
  });
  return inside;
}

function envelopeOf(findings, declared, version) {
  findings.sort((a, b) => compareCodePoint(a.file, b.file) || a.line - b.line || a.col - b.col
    || compareCodePoint(a.code, b.code) || compareCodePoint(a.message, b.message));
  const counts = {
    error: findings.filter((f) => f.severity === 'error').length,
    warn: findings.filter((f) => f.severity === 'warn').length,
  };
  return {
    counts,
    findings,
    schema: 'agsc.diagnostics.v1',
    spec_version: declared,
    status: counts.error === 0 ? 'pass' : 'fail',
    verb: 'validate-spec',
    version,
  };
}

function packageVersion(root) {
  try { return JSON.parse(fs.readFileSync(path.join(root, 'package.json'), 'utf8')).version; }
  catch { return '0.0.0'; }
}

/**
 * @param {string[]} argv
 * @param {{out:(s:string)=>void, err:(s:string)=>void}} io
 * @returns {number} exit code: 0 pass, 1 fail, 2 usage
 */
function run(argv, io) {
  const out = (io && io.out) || ((s) => process.stdout.write(s));
  const err = (io && io.err) || ((s) => process.stderr.write(s));
  const usage = (message) => { err(`validate-spec: ${message}\n${HELP}`); return 2; };

  const flags = new Set();
  let root = DEFAULT_ROOT;
  let sawRoot = false;
  for (const arg of argv) {
    if (arg === '--help' || arg === '-h') { out(HELP); return 0; }
    if (arg === '--json' || arg === '--quiet') flags.add(arg);
    else if (arg.startsWith('-')) return usage(`unknown flag ${arg} (AGSC-E002)`);
    else if (sawRoot) return usage(`unexpected argument ${arg} (AGSC-E002)`);
    else { root = path.resolve(arg); sawRoot = true; }
  }
  const specDir = path.join(root, 'spec');
  if (!fs.existsSync(specDir)) return usage(`no spec/ directory under ${root} (AGSC-E901)`);

  const rel = (absolute) => path.relative(root, absolute).split(path.sep).join('/');
  const findings = [];
  let inputsRead = 0;
  const readInput = (absolute) => { inputsRead += 1; return fs.readFileSync(absolute, 'utf8'); };
  const specFiles = fs.readdirSync(specDir).filter((f) => /^\d{2}-.*\.md$/u.test(f)).sort();
  const texts = new Map();
  for (const name of specFiles) texts.set(name, readInput(path.join(specDir, name)));
  // FV29-10: a checker that answers `pass` over nothing protects nothing, and
  // AGSC-09-92 makes this tool a merge gate. An input that is present but EMPTY is
  // the case the earlier code could not see: `spec_version` came back "unknown",
  // no rule bullet matched, and the run reported a clean pass.
  if (specFiles.length === 0) {
    findings.push(finding('AGSC-E901', 'spec/', 1,
      `no numbered specification file under ${specDir}: there is nothing to validate (AGSC-09-91)`));
  }
  if (!texts.has('00-overview.md')) {
    findings.push(finding('AGSC-E901', 'spec/00-overview.md', 1,
      'the overview that declares spec_version is missing (AGSC-09-91)'));
  }
  if (!texts.has('09-conformance.md')) {
    findings.push(finding('AGSC-E901', 'spec/09-conformance.md', 1,
      'the conformance section that carries the section 9.4 registry is missing (AGSC-09-91)'));
  }
  const declared = ((texts.get('00-overview.md') || '').match(/\d+\.\d+\.\d+-rc\.\d+/u) || ['unknown'])[0];
  if (declared === 'unknown' && texts.has('00-overview.md')) {
    findings.push(finding('AGSC-E901', 'spec/00-overview.md', 1,
      'the overview declares no spec_version, so every version comparison below is vacuous'
      + ' — the file is empty or is not a specification overview (AGSC-09-91)'));
  }

  // ---- rule definitions ----------------------------------------------------
  const blocks = [];
  for (const name of specFiles) blocks.push(...ruleBlocks(texts.get(name), `spec/${name}`));
  const defined = new Map();
  const order = [];
  for (const block of blocks) {
    order.push(block.id);
    if (defined.has(block.id)) {
      const first = defined.get(block.id);
      findings.push(finding('AGSC-E201', block.file, block.line,
        `duplicate rule id ${block.id}, first defined at ${first.file}:${first.line} (AGSC-09-91)`));
    } else defined.set(block.id, block);
  }
  if (defined.size === 0 && specFiles.length > 0) {
    findings.push(finding('AGSC-E901', 'spec/', 1,
      `${specFiles.length} specification file(s) were read and not one rule bullet was found:`
      + ' the files are empty or are not this specification (AGSC-09-91)'));
  }

  // ---- a rule id `<n>a` that does not immediately follow `<n>` -------------
  order.forEach((id, index) => {
    const suffixed = /^(AGSC-\d{2}-\d{2,3})([a-z])$/u.exec(id);
    if (!suffixed) return;
    const previous = suffixed[2] === 'a'
      ? suffixed[1]
      : `${suffixed[1]}${String.fromCharCode(suffixed[2].charCodeAt(0) - 1)}`;
    if (order[index - 1] !== previous) {
      const block = defined.get(id);
      findings.push(finding('AGSC-E201', block.file, block.line,
        `rule ${id} does not immediately follow ${previous} (AGSC-09-91)`));
    }
  });

  // ---- a rule id referenced but defined nowhere ----------------------------
  for (const name of specFiles) {
    const file = `spec/${name}`;
    texts.get(name).split('\n').forEach((line, index) => {
      for (const match of line.matchAll(RULE_ID_G)) {
        if (!defined.has(match[0])) {
          findings.push(finding('AGSC-E201', file, index + 1,
            `rule id ${match[0]} is referenced here and defined nowhere in spec/ (AGSC-09-91)`));
        }
      }
    });
  }

  // ---- the section 9.4 registry -------------------------------------------
  const conformance = texts.get('09-conformance.md') || '';
  const registry = new Map();   // code -> { line, rules: Set }
  conformance.split('\n').forEach((line, index) => {
    const row = /^\|\s*`(AGSC-E\d{3})`\s*\|(.*)\|([^|]*)\|\s*$/u.exec(line);
    if (!row) return;
    const code = row[1];
    const rules = new Set(row[3].match(RULE_ID_G) || []);
    const gloss = row[2];
    const entry = registry.get(code);
    if (entry) {
      for (const r of rules) entry.rules.add(r);
      findings.push(finding('AGSC-E201', 'spec/09-conformance.md', index + 1,
        `error code ${code} appears in more than one registry row (AGSC-09-91)`));
    } else registry.set(code, { gloss, line: index + 1, rules });
  });
  for (const [code, entry] of registry) {
    for (const id of [...entry.rules].sort()) {
      if (!defined.has(id)) {
        findings.push(finding('AGSC-E201', 'spec/09-conformance.md', entry.line,
          `registry row ${code} names rule ${id}, which is defined nowhere (AGSC-09-91)`));
      }
    }
  }

  // ---- codes used in spec/01-11 -------------------------------------------
  // Two clauses of AGSC-09-91. (1) "an error code used in spec/01-11 but absent
  // from the section 9 registry" — an error. (2) "a code used in spec/01-11 whose
  // registry row does not name the rule that raises it" — checked only where a
  // rule ASSIGNS the code in the specification's own assigning constructions
  // (`… is AGSC-Ennn`, `… are AGSC-Ennn`, `… → AGSC-Ennn`), because a rule that
  // merely cites a code in a cross-reference does not raise it, and no reading of
  // prose can tell the two apart. The grouped-fault rows the rule keeps legal are
  // untouched: a row that names the assigning rule satisfies the check whatever
  // else it groups. A registered code that no rule names at all is reported as a
  // warning, since AGSC-09-91 makes only the other direction a failure.
  const namedBy = new Map();    // code -> Set of rule ids whose text carries it
  for (const block of blocks) {
    for (const code of [...new Set(block.text.match(CODE_G) || [])].sort()) {
      if (!namedBy.has(code)) namedBy.set(code, new Set());
      namedBy.get(code).add(block.id);
      if (!registry.has(code) && !block.file.startsWith('spec/00-')) {
        findings.push(finding('AGSC-E203', block.file, block.line,
          `rule ${block.id} uses ${code}, which the section 9.4 registry does not register (AGSC-09-91, AGSC-09-15)`));
      }
    }
    if (block.file.startsWith('spec/00-')) continue;
    for (const assigned of [...new Set([...block.text.matchAll(ASSIGNS_CODE)].map((m) => m[1]))].sort()) {
      const entry = registry.get(assigned);
      if (entry && !entry.rules.has(block.id)) {
        findings.push(finding('AGSC-E201', block.file, block.line,
          `rule ${block.id} assigns ${assigned} and the section 9.4 row for ${assigned} does not name it (AGSC-09-91)`));
      }
    }
  }
  for (const [code, entry] of registry) {
    if (/reserved|unassigned/u.test(entry.gloss)) continue;    // a row that says it is never raised
    if ((namedBy.get(code) || new Set()).size === 0) {
      findings.push(finding('AGSC-E201', 'spec/09-conformance.md', entry.line,
        `registry row ${code} is named by no rule of spec/00-11 (AGSC-09-91)`, 'warn'));
    }
  }

  // ---- a MUST/SHOULD sentence with no rule id ------------------------------
  for (const name of specFiles) {
    const file = `spec/${name}`;
    const text = texts.get(name);
    const fenced = fencedLines(text);
    const inRule = new Set();
    for (const block of ruleBlocks(text, file)) {
      for (let n = block.line; n < block.line + block.lines.length; n += 1) inRule.add(n);
    }
    text.split('\n').forEach((line, index) => {
      const n = index + 1;
      if (fenced.has(n) || inRule.has(n)) return;
      if (line.trim() === '' || /^#{1,6} /u.test(line) || /^\s*\|/u.test(line)) return;
      if (/BCP\s?14|RFC\s?2119|RFC\s?8174/u.test(line)) return;   // the key-word boilerplate
      if (!NORMATIVE.test(line)) return;
      if (RULE_ID.test(line)) return;
      findings.push(finding('AGSC-E202', file, n,
        'a normative sentence outside every rule carries no rule id (AGSC-09-91)'));
    });
  }

  // ---- the trace bracket, and the ids it names -----------------------------
  const prdPath = path.join(root, 'docs', 'PRD.md');
  const prdText = fs.existsSync(prdPath) ? readInput(prdPath) : null;
  const prdIds = new Set(prdText ? prdText.match(/(?:PRD|NFR)-\d{2,3}/gu) || [] : []);
  let decisionTags = 0;
  for (const block of blocks) {
    // A rule retired under AGSC-00-16 keeps its id and carries no trace.
    if (/\*\(retired at /u.test(block.text)) continue;
    const trace = block.lines.map(traceBracket).filter((b) => b !== null);
    if (trace.length === 0) {
      findings.push(finding('AGSC-E202', block.file, block.line,
        `rule ${block.id} carries no trace bracket (AGSC-09-91)`));
      continue;
    }
    const tail = trace[trace.length - 1];
    decisionTags += (tail.match(/(?<![\w-])D\d{1,3}(?![\w-])/gu) || []).length;
    if (!prdText) continue;
    for (const id of [...new Set(tail.match(/(?:PRD|NFR)-\d{2,3}/gu) || [])].sort()) {
      if (!prdIds.has(id)) {
        findings.push(finding('AGSC-E201', block.file, block.line,
          `rule ${block.id} traces to ${id}, which docs/PRD.md does not define (AGSC-09-91)`));
      }
    }
  }

  // ---- version literals, with carve-out (a) --------------------------------
  const textTargets = specFiles.map((name) => [`spec/${name}`, texts.get(name)]);
  const docsDir = path.join(root, 'docs');
  if (fs.existsSync(docsDir)) {
    for (const absolute of walk(docsDir).filter((f) => f.endsWith('.md')).sort()) {
      textTargets.push([rel(absolute), readInput(absolute)]);
    }
  }
  const vectorsDir = path.join(root, 'tests', 'vectors');
  if (fs.existsSync(vectorsDir)) {
    for (const absolute of walk(vectorsDir).filter((f) => f.endsWith('.json')).sort()) {
      textTargets.push([rel(absolute), readInput(absolute)]);
    }
  }
  for (const [file, text] of textTargets) {
    text.split('\n').forEach((line, index) => {
      for (const match of line.matchAll(VERSION_LITERAL)) {
        if (match[0] === declared) continue;
        if (HISTORY_WORD.test(line.slice(0, match.index))) continue;   // carve-out (a)
        findings.push(finding('AGSC-E201', file, index + 1,
          `version literal ${match[0]} differs from the spec/00 declaration ${declared} and is not on a historical-note line (AGSC-09-91)`));
      }
    });
  }

  // ---- envelope ------------------------------------------------------------
  const envelope = envelopeOf(findings, declared, packageVersion(root));
  if (flags.has('--json')) {
    out(`${canonicalize(envelope)}\n`);
  } else if (!flags.has('--quiet')) {
    for (const f of envelope.findings) {
      err(`${f.severity}: ${f.file}:${f.line}:${f.col} ${f.code} ${f.message}\n`);
    }
    out(`validate-spec: ${inputsRead} input file(s) read, ${specFiles.length} spec files, ${defined.size} rules, `
      + `${registry.size} registered codes, ${envelope.counts.error} error, ${envelope.counts.warn} warn; `
      + `decision tags (unresolvable from a distribution, informational): ${decisionTags}\n`);
  }
  return envelope.status === 'pass' ? 0 : 1;
}

/* c8 ignore next */
if (require.main === module) process.exit(run(process.argv.slice(2)));

module.exports = { HELP, canonicalize, compareCodePoint, fencedLines, ruleBlocks, run, traceBracket };
