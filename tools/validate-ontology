#!/usr/bin/env node
'use strict';
// tools/validate-ontology — the vocabulary validator of AGSC-09-90 and PRD-054:
// "Turtle well-formedness + OWL 2 RL-safe axiom allowlist + SKOS pitfalls S19/S32/S37".
//
// INDEPENDENT BY CONSTRUCTION: no import from `src/` (AGSC-09-90). It parses Turtle
// with `n3`, the library the engine pins for RDF; everything else is stdlib.
//
//   validate-ontology [--json] [--quiet] [--help] [<root>|<file.ttl>]
//
// The argument is the distribution root that holds `ontology/agsc.ttl`, or that file
// itself; it defaults to the directory above this file. Exit 0 pass, 1 fail, 2 usage.
// Deterministic: no clock, no network, findings sorted per AGSC-09-10.
//
// Checks (each a Finding; any error exits 1):
//   AGSC-E108  encoding: a byte-order mark, a CR, no single trailing LF, or non-NFC
//              text (AGSC-01-14)
//   AGSC-E201  the file is not well-formed Turtle; a SKOS integrity condition the
//              specification relies on is violated — S19/S20 (the domain and range
//              of `skos:semanticRelation` are `skos:Concept`, AGSC-05-20,
//              AGSC-05-26a), S32 (the range of `skos:member` is the union of
//              `skos:Concept` and `skos:Collection`, AGSC-05-18/05-19) or S37
//              (`skos:Collection` is disjoint with `skos:Concept` and
//              `skos:ConceptScheme`, AGSC-05-19); `asc:uses`, `asc:excludes` or
//              `asc:contradicts` carrying a super-property, a domain or a range
//              (AGSC-05-26a)
//   AGSC-E202  the ontology declares no `owl:versionIRI` (AGSC-05-25); a term marked
//              `owl:deprecated` with no `dcterms:isReplacedBy` (AGSC-05-25)
//   AGSC-E203  a predicate or a declared type outside the OWL 2 RL-safe set
//              (AGSC-05-22); a range or a term literal whose datatype is not one
//              of the OWL 2 RL datatypes (OWL 2 Profiles §4.2: `xsd:date` is not
//              on the list, and `owl:real` and `owl:rational` MUST NOT be used);
//              a class or an annotation property that the file uses and does not
//              declare (AGSC-05-25), without which an OWL 2 profile checker finds
//              the file outside the profile; an `asc:Item` class, which AGSC-05-13
//              forbids
//   AGSC-E204  a vocabulary IRI outside the persistent hash namespace of AGSC-05-02:
//              the only things the file may say about another vocabulary's entity
//              are the declarations of AGSC-05-25 — one `rdf:type` triple
//              (`owl:Class` or `owl:AnnotationProperty`) for an entity it uses
//   AGSC-E605  a blank node, which AGSC-05-08 forbids in this dataset
//   AGSC-E901  the ontology file is missing
//
// A SITE VOCABULARY (AGSC-05-38). A `.ttl` file named on the command line whose name is not
// `agsc.ttl` is a node's own vocabulary, the file `domain.vocabulary` names (AGSC-01-41), and
// is judged by the rules (a) to (g) of AGSC-05-38 instead: each violation is `AGSC-E420`. The
// namespaces of the contexts it may use (AGSC-08-32) are read from the `agsc.config.json` of
// the nearest folder above the file that has one, when that configuration names this file.
// The engine applies the same rules in `src/knowledge/domain.js`; this copy stays independent
// of it (AGSC-09-90), and `tests/tools/validate-ontology-parity.test.js` checks that the two
// give the same findings, code and message.
//
// The OWL 2 RL-safe set is stated positively: this vocabulary is blank-node-free
// (AGSC-05-08), so it can carry no class expression at all, and every construct that
// would take OWL 2 DL beyond RL — a restriction, a union, an intersection, a
// complement, an enumeration, a cardinality — needs one. What remains to police is
// the flat axiom vocabulary below, plus the two property characteristics OWL 2 RL
// excludes (`owl:ReflexiveProperty`, and `owl:disjointUnionOf` on a class), the
// datatypes, and the declarations. The literals on the ontology node itself are
// metadata AGSC-05-22 leaves out of its scope (its `xsd:date` values), so the
// datatype check reads ranges and the literals of terms only.

const fs = require('node:fs');
const path = require('node:path');

const DEFAULT_ROOT = path.resolve(__dirname, '..');
const HELP = `validate-ontology [--json] [--quiet] [--help] [<root>|<file.ttl>]

  Parses ontology/agsc.ttl and checks it against AGSC-05-02 (the persistent hash
  namespace), AGSC-05-08 (blank-node-free), AGSC-05-13 (no asc:Item), AGSC-05-22
  (OWL 2 RL: the axioms, the datatypes and the declarations), AGSC-05-25
  (versionIRI, deprecation and the declarations of the entities of other
  vocabularies) and AGSC-05-26a, together with the SKOS integrity conditions S19,
  S20, S32 and S37 those rules rely on.

  A .ttl file of any other name is a site vocabulary (the file domain.vocabulary
  names, AGSC-01-41) and is checked against the rules (a) to (g) of AGSC-05-38;
  each fault is AGSC-E420. The context namespaces come from the agsc.config.json
  of the nearest folder above the file, when it names the file.

  --json    emit the AGSC-09-11 diagnostics envelope on stdout
  --quiet   emit nothing; the exit code is the result
  --help    this text

  Exit 0 pass, 1 fail, 2 usage.
`;

const NS = 'https://w3id.org/agentic-system-core/ns#';
const ONTOLOGY_IRI = 'https://w3id.org/agentic-system-core/ns';
const RDF = 'http://www.w3.org/1999/02/22-rdf-syntax-ns#';
const RDFS = 'http://www.w3.org/2000/01/rdf-schema#';
const OWL = 'http://www.w3.org/2002/07/owl#';
const SKOS = 'http://www.w3.org/2004/02/skos/core#';
const DCTERMS = 'http://purl.org/dc/terms/';
const VANN = 'http://purl.org/vocab/vann/';
const VOAF = 'http://purl.org/vocommons/voaf#';
const XSD = 'http://www.w3.org/2001/XMLSchema#';
const PROV = 'http://www.w3.org/ns/prov#';

/** AGSC-05-22: the flat axiom and annotation vocabulary an RL-safe, blank-node-free
 *  vocabulary may use. Anything else is reported rather than silently accepted. */
const ALLOWED_PREDICATES = Object.freeze(new Set([
  `${RDF}type`,
  `${RDFS}comment`, `${RDFS}domain`, `${RDFS}isDefinedBy`, `${RDFS}label`, `${RDFS}range`,
  `${RDFS}seeAlso`, `${RDFS}subClassOf`, `${RDFS}subPropertyOf`,
  `${OWL}deprecated`, `${OWL}disjointWith`, `${OWL}equivalentClass`, `${OWL}equivalentProperty`,
  `${OWL}imports`, `${OWL}inverseOf`, `${OWL}propertyDisjointWith`, `${OWL}versionIRI`,
  `${OWL}versionInfo`,
  `${DCTERMS}created`, `${DCTERMS}description`, `${DCTERMS}isReplacedBy`, `${DCTERMS}license`,
  `${DCTERMS}modified`, `${DCTERMS}title`,
  // AGSC-05-25: the ontology node's registry metadata.
  `${DCTERMS}creator`, `${DCTERMS}issued`, `${DCTERMS}publisher`,
  `${VANN}preferredNamespacePrefix`, `${VANN}preferredNamespaceUri`,
  // AGSC-03-01 (1.1): the plain meaning of each relation, mirrored from the Meaning column.
  `${SKOS}definition`,
]));
/** The `rdf:type` objects OWL 2 RL admits for a term of a flat vocabulary. */
const ALLOWED_TYPES = Object.freeze(new Set([
  `${OWL}AnnotationProperty`, `${OWL}AsymmetricProperty`, `${OWL}Class`, `${OWL}DatatypeProperty`,
  `${OWL}FunctionalProperty`, `${OWL}InverseFunctionalProperty`, `${OWL}IrreflexiveProperty`,
  `${OWL}ObjectProperty`, `${OWL}Ontology`, `${OWL}SymmetricProperty`, `${OWL}TransitiveProperty`,
  `${VOAF}Vocabulary`, // AGSC-05-25: the ontology node only
]));
/** OWL 2 Profiles §4.2.1: the datatypes OWL 2 RL supports. `rdf:langString` is the
 *  RDF 1.1 name of a language-tagged `rdf:PlainLiteral`. */
const RL_DATATYPES = Object.freeze(new Set([
  `${RDF}PlainLiteral`, `${RDF}XMLLiteral`, `${RDF}langString`, `${RDFS}Literal`,
  ...['decimal', 'integer', 'nonNegativeInteger', 'nonPositiveInteger', 'positiveInteger',
    'negativeInteger', 'long', 'int', 'short', 'byte', 'unsignedLong', 'unsignedInt', 'unsignedShort',
    'unsignedByte', 'float', 'double', 'string', 'normalizedString', 'token', 'language', 'Name',
    'NCName', 'NMTOKEN', 'boolean', 'hexBinary', 'base64Binary', 'anyURI', 'dateTime',
    'dateTimeStamp'].map((local) => `${XSD}${local}`),
]));
/** An IRI in a datatype position: every XSD name and the datatypes of RDF, RDFS and OWL. */
const isDatatype = (iri) => iri.startsWith(XSD) || RL_DATATYPES.has(iri)
  || iri === `${OWL}real` || iri === `${OWL}rational`;
/** The predicates whose object is a class (a range is a class unless it is a datatype). */
const CLASS_POSITIONS = Object.freeze(new Set([
  `${RDFS}subClassOf`, `${RDFS}domain`, `${RDFS}range`, `${OWL}disjointWith`, `${OWL}equivalentClass`,
]));
/** The two declarations AGSC-05-25 lets the file make about another vocabulary's entity. */
const DECLARATIONS = Object.freeze(new Set([`${OWL}AnnotationProperty`, `${OWL}Class`]));

/** SKOS Reference S19/S20: every one of these has domain and range `skos:Concept`. */
const SEMANTIC_RELATIONS = Object.freeze(new Set([
  `${SKOS}broadMatch`, `${SKOS}broader`, `${SKOS}broaderTransitive`, `${SKOS}closeMatch`,
  `${SKOS}exactMatch`, `${SKOS}mappingRelation`, `${SKOS}narrowMatch`, `${SKOS}narrower`,
  `${SKOS}narrowerTransitive`, `${SKOS}related`, `${SKOS}relatedMatch`, `${SKOS}semanticRelation`,
]));
/** AGSC-05-26a: the three properties that carry no super-property, domain or range. */
const UNTYPED_PROPERTIES = Object.freeze(new Set([`${NS}contradicts`, `${NS}excludes`, `${NS}uses`]));

// --------------------------------------------------------------------------
// JCS (RFC 8785), the sliver this tool needs: NFC member names, UTF-16 order.
// --------------------------------------------------------------------------
function canonicalize(value) {
  if (value === null) return 'null';
  if (typeof value === 'boolean') return value ? 'true' : 'false';
  if (typeof value === 'number') return value === 0 ? '0' : String(value);
  if (typeof value === 'string') return JSON.stringify(value);
  if (Array.isArray(value)) return `[${value.map(canonicalize).join(',')}]`;
  const names = Object.keys(value).map((k) => k.normalize('NFC')).sort();
  return `{${names.map((n) => `${JSON.stringify(n)}:${canonicalize(value[n])}`).join(',')}}`;
}

/** AGSC-09-10: order by (file, line, col, code), compared code-point-wise. */
function compareCodePoint(a, b) {
  const ia = a[Symbol.iterator]();
  const ib = b[Symbol.iterator]();
  for (;;) {
    const x = ia.next();
    const y = ib.next();
    if (x.done && y.done) return 0;
    if (x.done) return -1;
    if (y.done) return 1;
    const cx = x.value.codePointAt(0);
    const cy = y.value.codePointAt(0);
    if (cx !== cy) return cx < cy ? -1 : 1;
  }
}

function finding(code, file, message, severity = 'error', line = 1) {
  return { code, col: 1, file, line, message, severity };
}

/** Every class reachable upward from `start` through `rdfs:subClassOf`. */
function ancestors(start, superClassOf) {
  const seen = new Set();
  const stack = [start];
  while (stack.length) {
    const current = stack.pop();
    for (const parent of superClassOf.get(current) || []) {
      if (seen.has(parent)) continue;
      seen.add(parent);
      stack.push(parent);
    }
  }
  return seen;
}

/**
 * AGSC-05-22 and AGSC-05-25, the parts an OWL 2 profile checker reads beyond the
 * axiom allow-list: the datatypes, the declarations, and the entities of other
 * vocabularies (declared, used, and described by nothing else).
 * @returns {string[]} the external IRIs that are well-formed declarations
 */
function profileFindings(quads, file, findings) {
  const typesOf = new Map();
  const bySubject = new Map();
  for (const quad of quads) {
    const s = quad.subject.value;
    if (!bySubject.has(s)) bySubject.set(s, []);
    bySubject.get(s).push(quad);
    if (quad.predicate.value === `${RDF}type`) {
      if (!typesOf.has(s)) typesOf.set(s, new Set());
      typesOf.get(s).add(quad.object.value);
    }
  }
  const declaredAs = (iri, type) => (typesOf.get(iri) || new Set()).has(type);
  const isProperty = (iri) => ['AnnotationProperty', 'DatatypeProperty', 'ObjectProperty'].some((t) => declaredAs(iri, `${OWL}${t}`));
  const used = new Set();
  const undeclared = new Map(); // IRI -> message
  for (const quad of quads) {
    const s = quad.subject.value;
    const p = quad.predicate.value;
    const o = quad.object;
    if (p === `${RDFS}range` && isDatatype(o.value) && !RL_DATATYPES.has(o.value)) {
      findings.push(finding('AGSC-E203', file,
        `the range <${o.value}> of <${s}> is not an OWL 2 RL datatype (OWL 2 Profiles §4.2, AGSC-05-22)`));
    } else if (p === `${RDFS}range` && declaredAs(s, `${OWL}DatatypeProperty`) && !isDatatype(o.value)) {
      findings.push(finding('AGSC-E203', file,
        `the datatype property <${s}> has the range <${o.value}>, which is not an OWL 2 RL datatype (AGSC-05-22)`));
    }
    if (o.termType === 'Literal' && s !== ONTOLOGY_IRI && !RL_DATATYPES.has(o.datatype.value)) {
      findings.push(finding('AGSC-E203', file,
        `a literal on <${s}> has the datatype <${o.datatype.value}>, which is not an OWL 2 RL datatype (OWL 2 Profiles §4.2, AGSC-05-22)`));
    }
    if (!p.startsWith(RDF) && !p.startsWith(RDFS) && !p.startsWith(OWL)) {
      used.add(p);
      if (!isProperty(p)) undeclared.set(p, `the annotation property <${p}> is used and not declared (owl:AnnotationProperty) in the file (AGSC-05-25)`);
    }
    const classPosition = (CLASS_POSITIONS.has(p) && !isDatatype(o.value))
      || (p === `${RDF}type` && !o.value.startsWith(OWL) && !o.value.startsWith(RDFS));
    if (classPosition && o.value !== `${OWL}Thing` && o.value !== `${OWL}Nothing`) {
      used.add(o.value);
      if (!declaredAs(o.value, `${OWL}Class`)) {
        undeclared.set(o.value, `<${o.value}> is used as a class and not declared (owl:Class) in the file (AGSC-05-22, AGSC-05-25)`);
      }
    }
  }
  for (const iri of [...undeclared.keys()].sort(compareCodePoint)) findings.push(finding('AGSC-E203', file, undeclared.get(iri)));
  return [...bySubject.keys()].filter((s) => s !== ONTOLOGY_IRI && !s.startsWith(NS)
    && used.has(s) && bySubject.get(s).length === 1
    && bySubject.get(s)[0].predicate.value === `${RDF}type` && DECLARATIONS.has(bySubject.get(s)[0].object.value));
}

// --------------------------------------------------------------------------
// AGSC-05-38: a site vocabulary. The same rules as `src/knowledge/domain.js#check`.
// --------------------------------------------------------------------------

/** (c): the predicates and types of AGSC-05-22, less `rdfs:domain`, `rdfs:range`,
 *  `owl:DatatypeProperty` and the ontology-only `voaf:Vocabulary`. */
const SITE_PREDICATES = new Set([...ALLOWED_PREDICATES].filter((p) => p !== `${RDFS}domain` && p !== `${RDFS}range`));
const SITE_TYPES = new Set([...ALLOWED_TYPES].filter((t) => t !== `${OWL}DatatypeProperty` && t !== `${VOAF}Vocabulary`));
const CHARACTERISTIC_TYPES = ['Symmetric', 'Asymmetric', 'Irreflexive', 'Transitive', 'Functional', 'InverseFunctional']
  .map((name) => `${OWL}${name}Property`);
const SITE_PROPERTY_TYPES = new Set([`${OWL}ObjectProperty`, `${OWL}AnnotationProperty`, `${OWL}DatatypeProperty`, ...CHARACTERISTIC_TYPES]);
/** (b): the namespaces no term of a site vocabulary is defined in. */
const SITE_FORBIDDEN = [NS, OWL, RDF, RDFS, SKOS, DCTERMS, PROV, XSD];
/** (e) and (f): the six item classes and the fourteen link properties (AGSC-01-02, AGSC-03-01). */
const SITE_ITEM_CLASSES = ['Concept', 'Lesson', 'Episode', 'Procedure', 'Cluster', 'Gate'].map((name) => `${NS}${name}`);
const SITE_LINK_PROPERTIES = [`${SKOS}related`, `${SKOS}broader`, `${SKOS}narrower`, `${NS}uses`,
  `${DCTERMS}requires`, `${NS}excludes`, `${PROV}wasDerivedFrom`, `${NS}contradicts`, `${DCTERMS}replaces`,
  `${NS}implements`, `${NS}verifies`, `${NS}covers`, `${NS}blockedBy`, `${NS}decidedBy`];
/** AGSC-05-25: the one type triple a site vocabulary states about another vocabulary's entity it names. */
const SITE_DECLARATIONS = new Set([...DECLARATIONS, `${OWL}ObjectProperty`]);
const SITE_CLASS_POSITIONS = new Set([`${RDFS}subClassOf`, `${OWL}disjointWith`, `${OWL}equivalentClass`]);

/** The site vocabulary's statements by named subject, its types, its two hierarchies and its ontologies. */
function siteIndex(quads) {
  const bySubject = new Map();
  const typeSets = new Map();
  const supers = { [`${RDFS}subClassOf`]: new Map(), [`${RDFS}subPropertyOf`]: new Map() };
  for (const quad of quads) {
    if (quad.subject.termType !== 'NamedNode') continue;
    const s = quad.subject.value;
    if (!bySubject.has(s)) bySubject.set(s, []);
    bySubject.get(s).push(quad);
    if (quad.object.termType !== 'NamedNode') continue;
    const target = quad.predicate.value === `${RDF}type` ? typeSets : supers[quad.predicate.value];
    if (target === undefined) continue;
    if (!target.has(s)) target.set(s, new Set());
    target.get(s).add(quad.object.value);
  }
  const typesOf = (iri) => typeSets.get(iri) || new Set();
  const ontologies = [...bySubject.keys()].filter((s) => typesOf(s).has(`${OWL}Ontology`)).sort(compareCodePoint);
  const namespace = ontologies.length === 1 && !/[#/]$/u.test(ontologies[0]) ? `${ontologies[0]}#` : null;
  return { bySubject, namespace, ontologies, subClassOf: supers[`${RDFS}subClassOf`], subPropertyOf: supers[`${RDFS}subPropertyOf`], typesOf };
}

/** (a) blank nodes and the one ontology; (c) and (g) per statement, with the declarations of AGSC-05-25. */
function siteStatementFaults(quads, index, fault) {
  const blanks = new Set(quads.flatMap((q) => [q.subject, q.object]).filter((t) => t.termType === 'BlankNode').map((t) => t.value));
  if (blanks.size > 0) fault('(a)', `the site vocabulary holds ${blanks.size} blank node(s); it is blank-node-free (AGSC-05-08)`);
  if (index.ontologies.length !== 1) fault('(a)', `the site vocabulary declares ${index.ontologies.length} owl:Ontology; it declares exactly one`);
  else if (index.namespace === null) fault('(a)', `the ontology IRI <${index.ontologies[0]}> ends in "#" or "/"; the site namespace is that IRI followed by "#"`);
  const undeclared = new Map();
  for (const [s, statements] of index.bySubject) {
    for (const { predicate, object } of statements) {
      const p = predicate.value;
      if (p === `${RDFS}domain` || p === `${RDFS}range`) fault('(g)', `<${s}> declares <${p}>; a property of the site vocabulary declares no domain and no range`);
      else if (!SITE_PREDICATES.has(p)) fault('(c)', `the predicate <${p}> on <${s}> is not one the site vocabulary may use`);
      if (p === `${RDF}type` && object.termType === 'NamedNode' && !SITE_TYPES.has(object.value)) fault('(c)', `<${s}> is declared a <${object.value}>, which the site vocabulary may not use`);
      if (object.termType === 'Literal' && !index.ontologies.includes(s) && !RL_DATATYPES.has(object.datatype.value)) {
        fault('(c)', `a literal on <${s}> has the datatype <${object.datatype.value}>, which is not an OWL 2 RL datatype`);
      }
      if (!p.startsWith(RDF) && !p.startsWith(RDFS) && !p.startsWith(OWL) && ![...index.typesOf(p)].some((t) => SITE_PROPERTY_TYPES.has(t))) {
        undeclared.set(p, `the annotation property <${p}> is used and not declared (owl:AnnotationProperty) in the file (AGSC-05-25)`);
      }
      if (SITE_CLASS_POSITIONS.has(p) && object.termType === 'NamedNode' && !index.typesOf(object.value).has(`${OWL}Class`)) {
        undeclared.set(object.value, `<${object.value}> is used as a class and not declared (owl:Class) in the file (AGSC-05-25)`);
      }
    }
  }
  for (const iri of [...undeclared.keys()].sort(compareCodePoint)) fault('(c)', undeclared.get(iri));
}

/**
 * (f): the other side of each `owl:inverseOf` is an object property the file defines, since the
 * engine materialises the inverse edge of a domain link (AGSC-03-27); a subject (b) refuses is
 * not judged twice. `own` is the test of (b), or with no site namespace only its forbidden part.
 */
function siteInverseFaults(index, own, fault) {
  const isOwnProperty = (term) => term.termType === 'NamedNode' && own(term.value) && index.typesOf(term.value).has(`${OWL}ObjectProperty`);
  for (const [s, statements] of index.bySubject) {
    for (const { predicate, object } of statements) {
      if (predicate.value !== `${OWL}inverseOf` || !own(s) || isOwnProperty(object)) continue;
      const named = object.termType === 'NamedNode' ? `<${object.value}>` : `the literal "${object.value}"`;
      fault('(f)', `<${s}> is declared the inverse of ${named}, which is not an object property the site vocabulary defines`);
    }
  }
}

/** (b), (d), (e) and (f) over every term the file defines (all subjects but the ontology and the declarations). */
function siteTermFaults(index, contextNamespaces, fault) {
  const allowed = [...(index.namespace === null ? [] : [index.namespace]), ...contextNamespaces];
  const forbidden = (iri) => SITE_FORBIDDEN.some((ns) => iri.startsWith(ns));
  const own = (iri) => allowed.some((ns) => iri.startsWith(ns)) && !forbidden(iri);
  const terms = [...index.bySubject.keys()].sort(compareCodePoint).filter((s) => {
    const statements = index.bySubject.get(s);
    const declaration = statements.length === 1 && statements[0].predicate.value === `${RDF}type`
      && SITE_DECLARATIONS.has(statements[0].object.value);
    return !index.ontologies.includes(s) && (own(s) || !declaration);
  });
  for (const term of terms) {
    if (forbidden(term) || (index.namespace !== null && !own(term))) {
      fault('(b)', `<${term}> is defined outside the site namespace and the namespaces of the declared contexts, or in a namespace it may not extend`);
      continue;
    }
    const types = index.typesOf(term);
    if (!index.bySubject.get(term).some((q) => q.predicate.value === `${RDFS}label`)) fault('(d)', `<${term}> has no rdfs:label`);
    const isClass = types.has(`${OWL}Class`);
    const isProperty = [...types].some((t) => SITE_PROPERTY_TYPES.has(t));
    if (!isClass && !isProperty) fault('(e), (f)', `<${term}> is neither a class nor a property; a site vocabulary defines classes and object properties`);
    if (isClass) {
      const itemClasses = [...ancestors(term, index.subClassOf)].filter((c) => SITE_ITEM_CLASSES.includes(c)).length;
      if (itemClasses !== 1) fault('(e)', `<${term}> is a subclass of ${itemClasses} of the six item classes; it is a subclass of exactly one`);
    }
    if (isProperty && !(types.has(`${OWL}ObjectProperty`)
        && [...ancestors(term, index.subPropertyOf)].some((p) => SITE_LINK_PROPERTIES.includes(p)))) {
      fault('(f)', `<${term}> is not an owl:ObjectProperty that is a sub-property of one of the fourteen link properties`);
    }
  }
  siteInverseFaults(index, index.namespace === null ? (iri) => !forbidden(iri) : own, fault);
  return {
    classes: terms.filter((t) => own(t) && index.typesOf(t).has(`${OWL}Class`)).length,
    properties: terms.filter((t) => own(t) && index.typesOf(t).has(`${OWL}ObjectProperty`)).length,
  };
}

/**
 * AGSC-05-38: the findings of a site vocabulary, each `AGSC-E420`, and what it holds.
 * @returns {{findings: object[], triples: number, classes: number, properties: number}}
 */
function siteVocabulary(raw, file, contextNamespaces) {
  const findings = [];
  const fault = (rule, message) => findings.push(finding('AGSC-E420', file, `${message} (AGSC-05-38 ${rule})`));
  if (raw.includes('\r')) fault('(a)', 'the site vocabulary has CR line endings; it uses LF');
  if (raw.normalize('NFC') !== raw) fault('(a)', 'the site vocabulary is not NFC');
  const { Parser } = require('n3');
  let quads;
  try { quads = new Parser({ format: 'text/turtle' }).parse(raw); } catch (e) {
    fault('(a)', `the site vocabulary is not well-formed Turtle: ${e.message}`);
    return { classes: 0, findings, properties: 0, triples: 0 };
  }
  const index = siteIndex(quads);
  siteStatementFaults(quads, index, fault);
  return { ...siteTermFaults(index, contextNamespaces, fault), findings, triples: quads.length };
}

/** The `domain` object of a configuration file; `{}` when it has none or is not JSON. */
function domainObjectOf(file) {
  try {
    const parsed = JSON.parse(fs.readFileSync(file, 'utf8'));
    return (parsed && parsed.domain) || {};
  } catch { return {}; }
}

/**
 * The Bundle a site vocabulary belongs to: the nearest folder above the file with an
 * `agsc.config.json`. When that configuration names the file in `domain.vocabulary`, its
 * `domain.contexts` give the context namespaces (AGSC-08-32); a configuration that is not
 * JSON, or that names another file, gives none. The file is named relative to that folder.
 */
function siteContextOf(absolute) {
  let dir = path.dirname(absolute);
  for (;;) {
    const candidate = path.join(dir, 'agsc.config.json');
    if (fs.existsSync(candidate)) {
      const domain = domainObjectOf(candidate);
      const names = typeof domain.vocabulary === 'string' && path.resolve(dir, domain.vocabulary) === absolute;
      const contexts = names && Array.isArray(domain.contexts) ? domain.contexts : [];
      return { file: path.relative(dir, absolute).split(path.sep).join('/'), namespaces: contexts.map((c) => c && c.namespace).filter((n) => typeof n === 'string') };
    }
    const parent = path.dirname(dir);
    if (parent === dir) return { file: path.basename(absolute), namespaces: [] };
    dir = parent;
  }
}

/** `validate-ontology <file.ttl>` for a site vocabulary: the envelope of the engine's own distribution. */
function runSite(absolute, flags, out, err) {
  const where = siteContextOf(absolute);
  const result = siteVocabulary(fs.readFileSync(absolute, 'utf8'), where.file, where.namespaces);
  const envelope = envelopeOf(result.findings, specVersion(DEFAULT_ROOT), packageVersion(DEFAULT_ROOT));
  if (flags.has('--json')) out(`${canonicalize(envelope)}\n`);
  else if (!flags.has('--quiet')) {
    for (const f of envelope.findings) err(`${f.severity}: ${f.file}:${f.line}:${f.col} ${f.code} ${f.message}\n`);
    out(`validate-ontology: 1 input file(s) read, site vocabulary, ${result.triples} triples, ${result.classes} classes, `
      + `${result.properties} properties, ${envelope.counts.error} error, ${envelope.counts.warn} warn\n`);
  }
  return envelope.status === 'pass' ? 0 : 1;
}

function envelopeOf(findings, declared, version) {
  findings.sort((a, b) => compareCodePoint(a.file, b.file) || a.line - b.line || a.col - b.col
    || compareCodePoint(a.code, b.code) || compareCodePoint(a.message, b.message));
  const counts = {
    error: findings.filter((f) => f.severity === 'error').length,
    warn: findings.filter((f) => f.severity === 'warn').length,
  };
  return {
    counts,
    findings,
    schema: 'agsc.diagnostics.v1',
    spec_version: declared,
    status: counts.error === 0 ? 'pass' : 'fail',
    verb: 'validate-ontology',
    version,
  };
}

function specVersion(root) {
  try {
    return (fs.readFileSync(path.join(root, 'spec', '00-overview.md'), 'utf8')
      .match(/\d+\.\d+\.\d+(?:-[a-z]+\.\d+)?/u) || ['unknown'])[0];
  } catch { return 'unknown'; }
}

function packageVersion(root) {
  try { return JSON.parse(fs.readFileSync(path.join(root, 'package.json'), 'utf8')).version; } catch { return '0.0.0'; }
}

/**
 * @param {string[]} argv
 * @param {{out:(s:string)=>void, err:(s:string)=>void}} io
 * @returns {number} exit code: 0 pass, 1 fail, 2 usage
 */
function run(argv, io) {
  const out = (io && io.out) || ((s) => process.stdout.write(s));
  const err = (io && io.err) || ((s) => process.stderr.write(s));
  const usage = (message) => { err(`validate-ontology: ${message}\n${HELP}`); return 2; };

  const flags = new Set();
  let target = DEFAULT_ROOT;
  let sawTarget = false;
  for (const arg of argv) {
    if (arg === '--help' || arg === '-h') { out(HELP); return 0; }
    if (arg === '--json' || arg === '--quiet') flags.add(arg);
    else if (arg.startsWith('-')) return usage(`unknown flag ${arg} (AGSC-E002)`);
    else if (sawTarget) return usage(`unexpected argument ${arg} (AGSC-E002)`);
    else { target = path.resolve(arg); sawTarget = true; }
  }
  const isFile = fs.existsSync(target) && fs.statSync(target).isFile();
  if (isFile && path.basename(target) !== 'agsc.ttl') return runSite(target, flags, out, err);
  const root = isFile ? path.resolve(path.dirname(target), '..') : target;
  const absolute = isFile ? target : path.join(target, 'ontology', 'agsc.ttl');
  // AGSC-09-90: "A validator MUST FAIL, with
  // `AGSC-E901`, when the inputs its contract names are absent". A failure is exit
  // 1 and the AGSC-09-11 envelope — not exit 2 and a usage block, which AGSC-09-08
  // reserves for an unknown verb, an unknown flag or a missing argument, and which
  // a caller reading the envelope cannot see at all.
  if (!fs.existsSync(absolute)) {
    const bad = envelopeOf([finding('AGSC-E901', 'ontology/agsc.ttl',
      `no ontology at ${absolute}: there is nothing to validate (AGSC-05-25)`)],
    specVersion(root), packageVersion(root));
    if (flags.has('--json')) out(`${canonicalize(bad)}\n`);
    else if (!flags.has('--quiet')) {
      for (const f of bad.findings) err(`${f.severity}: ${f.file}:${f.line}:${f.col} ${f.code} ${f.message}\n`);
      out(`validate-ontology: 0 input file(s) read, 0 terms, ${bad.counts.error} error, ${bad.counts.warn} warn\n`);
    }
    return 1;
  }
  const file = path.relative(root, absolute).split(path.sep).join('/');

  const findings = [];
  const raw = fs.readFileSync(absolute, 'utf8');
  if (raw.charCodeAt(0) === 0xfeff) findings.push(finding('AGSC-E108', file, 'byte-order mark (AGSC-01-14)'));
  if (raw.includes('\r')) findings.push(finding('AGSC-E108', file, 'CR or CRLF line endings (AGSC-01-14)'));
  if (!raw.endsWith('\n') || raw.endsWith('\n\n')) {
    findings.push(finding('AGSC-E108', file, 'the file must end with exactly one LF (AGSC-01-14)'));
  }
  if (raw.normalize('NFC') !== raw) findings.push(finding('AGSC-E108', file, 'the file is not NFC (AGSC-01-14)'));

  const { Parser } = require('n3');
  let quads;
  try { quads = new Parser({ format: 'text/turtle' }).parse(raw); } catch (e) {
    findings.push(finding('AGSC-E201', file, `not well-formed Turtle: ${e.message}`));
    const bad = envelopeOf(findings, specVersion(root), packageVersion(root));
    if (flags.has('--json')) out(`${canonicalize(bad)}\n`);
    else if (!flags.has('--quiet')) {
      for (const f of bad.findings) err(`${f.severity}: ${f.file}:${f.line}:${f.col} ${f.code} ${f.message}\n`);
      out(`validate-ontology: 1 input file(s) read, 0 terms, ${bad.counts.error} error, ${bad.counts.warn} warn\n`);
    }
    return 1;
  }

  // ---- index ---------------------------------------------------------------
  const types = new Map();          // subject -> Set of rdf:type objects
  const superClassOf = new Map();   // class -> Set of rdfs:subClassOf objects
  const superPropertyOf = new Map();
  const domainOf = new Map();
  const rangeOf = new Map();
  const deprecated = new Set();
  const replaced = new Set();
  const subjects = new Set();
  let versionIri = null;
  const add = (map, key, value) => { if (!map.has(key)) map.set(key, new Set()); map.get(key).add(value); };

  for (const quad of quads) {
    for (const term of [quad.subject, quad.predicate, quad.object]) {
      if (term.termType === 'BlankNode') {
        findings.push(finding('AGSC-E605', file, `blank node _:${term.value}: the dataset is blank-node-free (AGSC-05-08)`));
      }
    }
    const s = quad.subject.value;
    const p = quad.predicate.value;
    const o = quad.object.value;
    subjects.add(s);
    if (!ALLOWED_PREDICATES.has(p)) {
      findings.push(finding('AGSC-E203', file,
        `predicate <${p}> on <${s}> is outside the OWL 2 RL-safe vocabulary this ontology may use (AGSC-05-22)`));
    }
    if (p === `${RDF}type`) {
      add(types, s, o);
      if (!ALLOWED_TYPES.has(o)) {
        findings.push(finding('AGSC-E203', file,
          `<${s}> is declared a <${o}>, which is outside OWL 2 RL for a blank-node-free vocabulary (AGSC-05-22)`));
      }
    } else if (p === `${RDFS}subClassOf`) add(superClassOf, s, o);
    else if (p === `${RDFS}subPropertyOf`) add(superPropertyOf, s, o);
    else if (p === `${RDFS}domain`) add(domainOf, s, o);
    else if (p === `${RDFS}range`) add(rangeOf, s, o);
    else if (p === `${OWL}versionIRI`) versionIri = o;
    else if (p === `${OWL}deprecated` && o === 'true') deprecated.add(s);
    else if (p === `${DCTERMS}isReplacedBy`) replaced.add(s);
  }

  // ---- AGSC-05-22/05-25: datatypes and declarations ------------------------
  const declarations = new Set(profileFindings(quads, file, findings));

  // ---- AGSC-05-02: the persistent hash namespace --------------------------
  // A declaration of another vocabulary's entity that the file uses (AGSC-05-25)
  // is not a term of this vocabulary; anything else said about such an IRI is.
  const terms = [...subjects].filter((s) => s !== ONTOLOGY_IRI && !declarations.has(s)).sort(compareCodePoint);
  for (const term of terms) {
    if (!term.startsWith(NS)) {
      findings.push(finding('AGSC-E204', file,
        `<${term}> is described here and is not in the persistent namespace ${NS} (AGSC-05-02); `
        + 'of another vocabulary\'s entity the file only declares one it uses, by its type triple alone (AGSC-05-25)'));
    }
  }

  // ---- AGSC-05-13: there is no common superclass --------------------------
  if (subjects.has(`${NS}Item`)) {
    findings.push(finding('AGSC-E203', file, 'asc:Item MUST NOT be emitted: there is no common superclass for items (AGSC-05-13)'));
  }

  // ---- AGSC-05-25: version and deprecation --------------------------------
  if (!versionIri) {
    findings.push(finding('AGSC-E202', file, 'the ontology declares no owl:versionIRI (AGSC-05-25)'));
  }
  for (const term of [...deprecated].sort(compareCodePoint)) {
    if (!replaced.has(term)) {
      findings.push(finding('AGSC-E202', file,
        `<${term}> is owl:deprecated and carries no dcterms:isReplacedBy (AGSC-05-25)`));
    }
  }

  // ---- AGSC-05-26a: three properties carry no axioms at all ---------------
  for (const term of [...UNTYPED_PROPERTIES].sort(compareCodePoint)) {
    for (const [label, map] of [['rdfs:subPropertyOf', superPropertyOf], ['rdfs:domain', domainOf], ['rdfs:range', rangeOf]]) {
      if (map.has(term)) {
        findings.push(finding('AGSC-E201', file,
          `<${term}> carries ${label}; AGSC-05-26a forbids it, because skos:related is a sub-property of skos:semanticRelation (S19/S20) and the entailment re-creates the S37 contradiction`));
      }
    }
  }

  // ---- SKOS S19/S20, S32, S37 ---------------------------------------------
  const isConcept = (cls) => cls === `${SKOS}Concept` || ancestors(cls, superClassOf).has(`${SKOS}Concept`);
  const isCollection = (cls) => cls === `${SKOS}Collection` || ancestors(cls, superClassOf).has(`${SKOS}Collection`);
  const isScheme = (cls) => cls === `${SKOS}ConceptScheme` || ancestors(cls, superClassOf).has(`${SKOS}ConceptScheme`);

  for (const [property, supers] of [...superPropertyOf].sort((a, b) => compareCodePoint(a[0], b[0]))) {
    const semantic = [...supers].some((s) => SEMANTIC_RELATIONS.has(s));
    const member = [...supers].some((s) => s === `${SKOS}member`);
    if (semantic) {
      for (const [label, map] of [['domain', domainOf], ['range', rangeOf]]) {
        for (const cls of [...(map.get(property) || [])].sort(compareCodePoint)) {
          if (!isConcept(cls)) {
            findings.push(finding('AGSC-E201', file,
              `<${property}> is a sub-property of a SKOS semantic relation and declares the ${label} <${cls}>, which is not a skos:Concept (SKOS S19/S20, AGSC-05-20)`));
          }
        }
      }
    }
    if (member) {
      for (const cls of [...(rangeOf.get(property) || [])].sort(compareCodePoint)) {
        if (!isConcept(cls) && !isCollection(cls)) {
          findings.push(finding('AGSC-E201', file,
            `<${property}> is a sub-property of skos:member and declares the range <${cls}>, outside the union of skos:Concept and skos:Collection (SKOS S32, AGSC-05-18)`));
        }
      }
    }
  }
  for (const cls of [...(types.keys())].filter((s) => (types.get(s) || new Set()).has(`${OWL}Class`)).sort(compareCodePoint)) {
    if (isCollection(cls) && isConcept(cls)) {
      findings.push(finding('AGSC-E201', file,
        `<${cls}> is a sub-class of both skos:Collection and skos:Concept, which are disjoint (SKOS S37, AGSC-05-19)`));
    }
    if (isCollection(cls) && isScheme(cls)) {
      findings.push(finding('AGSC-E201', file,
        `<${cls}> is a sub-class of both skos:Collection and skos:ConceptScheme, which are disjoint (SKOS S37, AGSC-05-19)`));
    }
  }

  const classes = terms.filter((t) => (types.get(t) || new Set()).has(`${OWL}Class`)).length;
  const properties = terms.filter((t) => {
    const set = types.get(t) || new Set();
    return set.has(`${OWL}ObjectProperty`) || set.has(`${OWL}DatatypeProperty`);
  }).length;

  const envelope = envelopeOf(findings, specVersion(root), packageVersion(root));
  if (flags.has('--json')) {
    out(`${canonicalize(envelope)}\n`);
  } else if (!flags.has('--quiet')) {
    for (const f of envelope.findings) {
      err(`${f.severity}: ${f.file}:${f.line}:${f.col} ${f.code} ${f.message}\n`);
    }
    out(`validate-ontology: 1 input file(s) read, ${quads.length} triples, ${classes} classes, ${properties} properties, `
      + `${envelope.counts.error} error, ${envelope.counts.warn} warn\n`);
  }
  return envelope.status === 'pass' ? 0 : 1;
}

/* c8 ignore next */
if (require.main === module) process.exit(run(process.argv.slice(2)));

module.exports = { HELP, ancestors, canonicalize, compareCodePoint, run };
