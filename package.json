{
    "name": "agentic-system-core",
    "version": "1.0.0-rc.6",
    "description": "The reference engine and command line of AgenticSystemCore: publish a Markdown knowledge Bundle as a static node of the Agentic Knowledge Web — a wiki, an RDF graph, agent memory, skills, MCP and WebMCP tools and a discovery document. Ships the specification, the JSON Schemas, the ontology, the conformance vectors and the nine independent checkers.",
    "main": "index.js",
    "bin": {
        "agsc": "bin/agsc.js",
        "agentic-system-core": "bin/agentic-system-core"
    },
    "files": [
        "bin/",
        "src/",
        "tools/",
        "bench/",
        "index.js",
        "spec/",
        "schema/",
        "ontology/",
        "tests/vectors/",
        "features/",
        "docs/diagrams/",
        "docs/SPEC.md",
    "docs/PLUGINS.md",
    "docs/USING-WITH-ASSISTANTS.md",
    "docs/SECURITY-CONSIDERATIONS.md",
    "docs/BENCHMARKS.md",
    "docs/MEASUREMENTS.md",
    "examples/",
        "LICENSE",
        "LICENSE-CONTENT",
        "NOTICE",
        "CONTRIBUTOR-AGREEMENT",
        "CITATION.cff",
        "CHANGELOG.md",
        "CONTRIBUTING.md",
        "SECURITY.md",
        "README.md"
    ],
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "test": "node --test 'tests/**/*.test.js'",
        "test:coverage": "node --test --experimental-test-coverage 'tests/**/*.test.js'",
        "audit": "npm audit --audit-level=low"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/andreibesleaga/agentic-system-core.git"
    },
    "keywords": [
        "agentic",
        "multi-agent",
        "knowledge-web",
        "agentic-memory",
        "distributed-systems",
        "ontologies",
        "dynamic-system"
    ],
    "author": "Andrei N. Besleaga",
    "license": "Apache-2.0",
    "bugs": {
        "url": "https://github.com/andreibesleaga/agentic-system-core/issues"
    },
    "homepage": "https://agenticsystemcore.com",
    "dependencies": {
        "@modelcontextprotocol/sdk": "1.30.0",
        "@toon-format/toon": "4.1.1",
        "ajv": "8.20.0",
        "ajv-formats": "3.0.1",
        "commander": "15.0.0",
        "diff": "9.0.0",
        "dotenv": "18.0.0",
        "fast-xml-parser": "5.11.1",
        "json-canonicalize": "3.0.1",
        "markdown-it": "15.0.2",
        "n3": "2.7.12",
        "yaml": "2.9.1"
    },
    "devDependencies": {
        "fast-check": "4.10.1",
        "fflate": "0.8.3",
        "jsonld": "9.0.0"
    }
}
