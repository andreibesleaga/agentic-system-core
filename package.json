{
    "name": "agentic-system-core",
    "mcpName": "io.github.andreibesleaga/agentic-system-core",
    "version": "1.0.1",
    "description": "The reference engine and command line of AgenticSystemCore: publish a Markdown knowledge Bundle as a static node of the Agentic Knowledge Web — a wiki, an RDF graph, agent memory, skills, MCP and WebMCP tools and a discovery document. Ships the specification, the JSON Schemas, the ontology, the conformance vectors and the nine independent checkers.",
    "main": "index.js",
    "exports": {
        ".": "./index.js",
        "./bin/agsc.js": "./bin/agsc.js",
        "./package.json": "./package.json",
        "./schema/*": "./schema/*",
        "./ontology/*": "./ontology/*",
        "./spec/*": "./spec/*",
        "./tests/vectors/*": "./tests/vectors/*"
    },
    "bin": {
        "agsc": "bin/agsc.js",
        "agsc-host": "bin/agsc-host.js",
        "agentic-system-core": "bin/agentic-system-core"
    },
    "files": [
        "bin/",
        "src/",
        "tools/validate-spec",
        "tools/validate-schemas",
        "tools/validate-ontology",
        "tools/validate-vectors",
        "tools/validate-wellknown",
        "tools/validate-features",
        "tools/validate-diagrams",
        "tools/gen-spec-html",
        "tools/gen-ns",
        "tools/gen-dc-profile",
        "tools/gen-shapes",
        "tools/count-artifacts",
        "tools/bench",
        "bench/queries/",
        "index.js",
        "spec/",
        "schema/",
        "ontology/",
        "tests/vectors/",
        "tests/conformance/areas/",
        "tests/conformance/pending.json",
        "tests/knowledge/_graph-fixture.js",
        "tests/fixtures/minimal/",
        "features/",
        "docs/diagrams/",
        "docs/SPEC.md",
        "docs/PLUGINS.md",
        "docs/USING-WITH-ASSISTANTS.md",
        "docs/SECURITY-CONSIDERATIONS.md",
        "docs/BENCHMARKS.md",
        "docs/DUBLIN-CORE-PROFILE.md",
        "docs/SHACL-SHAPES.md",
        "docs/MEASUREMENTS.md",
        "docs/CONFORMANCE-STATEMENTS.md",
        "docs/ontology-questions.json",
        "docs/guides/",
        "examples/",
        "LICENSE",
        "LICENSES/",
        "REUSE.toml",
        "LICENSE-CONTENT",
        "NOTICE",
        "CONTRIBUTOR-AGREEMENT",
        "CITATION.cff",
        "CHANGELOG.md",
        "CONTRIBUTING.md",
        "SECURITY.md",
        "GOVERNANCE.md",
        "TRADEMARK-POLICY.md",
        "CODE_OF_CONDUCT.md",
        "README.md"
    ],
    "engines": {
        "node": ">=22.13.0"
    },
    "scripts": {
        "test": "node --test \"tests/**/*.test.js\"",
        "test:coverage": "node tests/_coverage-bar.js --test-coverage-include=\"src/**\" --test-coverage-lines=99.9 --test-coverage-functions=99 --test-coverage-branches=93 \"tests/**/*.test.js\"",
        "audit": "npm audit --audit-level=low",
        "test:acceptance": "node --test \"tests/acceptance/**/*.test.js\"",
        "test:standard": "node --test \"tests/standard/*.test.js\"",
        "test:e2e": "node --test \"tests/e2e/*.test.js\" \"tests/e2e/modes/*.test.js\"",
        "rule-coverage": "node tools/rule-coverage --check",
        "lint": "eslint --max-warnings 0 .",
        "format": "eslint --fix .",
        "arch": "depcruise --config .dependency-cruiser.js src src-ts bin index.js",
        "duplicates": "jscpd src bin index.js --format javascript --reporters console --threshold 2 --ignore \"src/distribution/vendor/**\"",
        "requirements": "node tools/requirements-matrix --check",
        "build:ts": "node tools/build-ts",
        "check:ts": "node tools/build-ts --check",
        "typecheck": "tsc --noEmit",
        "prepack": "npm run check:ts && npm run typecheck"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/andreibesleaga/agentic-system-core.git"
    },
    "keywords": [
        "agentic",
        "multi-agent",
        "knowledge-web",
        "agentic-memory",
        "distributed-systems",
        "ontologies",
        "dynamic-system",
        "mcp",
        "mcp-server",
        "model-context-protocol",
        "agent-skills",
        "claude-code",
        "llms-txt",
        "knowledge-graph"
    ],
    "author": "Andrei N. Besleaga",
    "license": "Apache-2.0 AND CC0-1.0",
    "bugs": {
        "url": "https://github.com/andreibesleaga/agentic-system-core/issues"
    },
    "homepage": "https://agenticsystemcore.com",
    "dependencies": {
        "@modelcontextprotocol/server": "2.4.0",
        "@toon-format/toon": "4.4.0",
        "@traqula/parser-sparql-1-1": "1.4.0",
        "ajv": "8.20.0",
        "ajv-formats": "3.0.1",
        "commander": "15.0.0",
        "diff": "9.0.0",
        "dotenv": "18.0.9",
        "fast-xml-parser": "5.11.2",
        "json-canonicalize": "3.0.1",
        "jsonld": "9.0.0",
        "markdown-it": "15.0.3",
        "n3": "2.7.12",
        "oxigraph": "0.5.13",
        "rdf-validate-shacl": "0.6.5",
        "yaml": "2.9.1"
    },
    "devDependencies": {
        "@cucumber/gherkin": "42.0.1",
        "@cucumber/messages": "34.2.1",
        "@eslint/js": "10.0.1",
        "@modelcontextprotocol/client": "2.4.0",
        "@stylistic/eslint-plugin": "5.10.0",
        "@types/node": "22.20.5",
        "dependency-cruiser": "18.7.0",
        "eslint": "10.14.0",
        "eslint-plugin-import-x": "4.17.1",
        "fast-check": "4.10.2",
        "fflate": "0.8.3",
        "globals": "17.13.0",
        "jscpd": "5.4.2",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.1"
    },
    "overrides": {
        "minimatch": "11.0.4"
    }
}
