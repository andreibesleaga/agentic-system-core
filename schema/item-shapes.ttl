# ------------------------------------------------------------
# Shapes from the relation table of AGSC-03-01 (AGSC-03-23, AGSC-03-25, AGSC-03-07, AGSC-03-08)

ascs:Link-broader-target
    a sh:PropertyShape ;
    sh:path skos:broader ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "AGSC-E315: the target of this key should belong to the same family as the item" ;
        sh:prefixes ascs:Prefixes ;
        sh:select """
        SELECT $this ?value WHERE {
          $this $PATH ?value .
          $this a ?from . ?value a ?to .
          FILTER (?from IN (asc:Concept, asc:Lesson, skos:Concept, asc:Cluster, skos:Collection, asc:Episode, asc:Procedure, asc:Gate) && ?to IN (asc:Concept, asc:Lesson, skos:Concept, asc:Cluster, skos:Collection, asc:Episode, asc:Procedure, asc:Gate))
          FILTER (!((?from IN (asc:Concept, asc:Lesson, skos:Concept) && ?to IN (asc:Concept, asc:Lesson, skos:Concept)) || (?from IN (asc:Cluster, skos:Collection) && ?to IN (asc:Cluster, skos:Collection)) || (?from IN (asc:Episode) && ?to IN (asc:Episode)) || (?from IN (asc:Procedure) && ?to IN (asc:Procedure)) || (?from IN (asc:Gate) && ?to IN (asc:Gate))))
        }
        """
    ] ;
    sh:message "the target of broader should belong to the family of the item (AGSC-03-25, AGSC-E315)" ;
    sh:severity sh:Warning .

ascs:Link-narrower-target
    a sh:PropertyShape ;
    sh:path skos:narrower ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "AGSC-E315: the target of this key should belong to the same family as the item" ;
        sh:prefixes ascs:Prefixes ;
        sh:select """
        SELECT $this ?value WHERE {
          $this $PATH ?value .
          $this a ?from . ?value a ?to .
          FILTER (?from IN (asc:Concept, asc:Lesson, skos:Concept, asc:Cluster, skos:Collection, asc:Episode, asc:Procedure, asc:Gate) && ?to IN (asc:Concept, asc:Lesson, skos:Concept, asc:Cluster, skos:Collection, asc:Episode, asc:Procedure, asc:Gate))
          FILTER (!((?from IN (asc:Concept, asc:Lesson, skos:Concept) && ?to IN (asc:Concept, asc:Lesson, skos:Concept)) || (?from IN (asc:Cluster, skos:Collection) && ?to IN (asc:Cluster, skos:Collection)) || (?from IN (asc:Episode) && ?to IN (asc:Episode)) || (?from IN (asc:Procedure) && ?to IN (asc:Procedure)) || (?from IN (asc:Gate) && ?to IN (asc:Gate))))
        }
        """
    ] ;
    sh:message "the target of narrower should belong to the family of the item (AGSC-03-25, AGSC-E315)" ;
    sh:severity sh:Warning .

ascs:Link-derived-from-target
    a sh:PropertyShape ;
    sh:path prov:wasDerivedFrom ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "AGSC-E315: the target of derived-from of a lesson should be an episode" ;
        sh:prefixes ascs:Prefixes ;
        sh:select """
        SELECT $this ?value WHERE {
          $this a asc:Lesson . $this $PATH ?value . ?value a ?class .
          FILTER NOT EXISTS { ?value a asc:Episode }
        }
        """
    ] ;
    sh:message "the target of derived-from of a lesson should be an episode (AGSC-03-25, AGSC-E315)" ;
    sh:severity sh:Warning .

ascs:Link-supersedes-target
    a sh:PropertyShape ;
    sh:path dcterms:replaces ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "AGSC-E315: the target of this key should have the same type as the item" ;
        sh:prefixes ascs:Prefixes ;
        sh:select """
        SELECT $this ?value WHERE {
          $this $PATH ?value .
          $this a ?from . ?value a ?to .
          FILTER (?from IN (asc:Concept, skos:Concept, asc:Lesson, asc:Episode, asc:Procedure, asc:Cluster, asc:Gate) && ?to IN (asc:Concept, skos:Concept, asc:Lesson, asc:Episode, asc:Procedure, asc:Cluster, asc:Gate))
          FILTER (!((?from IN (asc:Concept, skos:Concept) && ?to IN (asc:Concept, skos:Concept)) || (?from IN (asc:Lesson) && ?to IN (asc:Lesson)) || (?from IN (asc:Episode) && ?to IN (asc:Episode)) || (?from IN (asc:Procedure) && ?to IN (asc:Procedure)) || (?from IN (asc:Cluster) && ?to IN (asc:Cluster)) || (?from IN (asc:Gate) && ?to IN (asc:Gate))))
        }
        """
    ] ;
    sh:message "the target of supersedes should have the type of the item (AGSC-03-25, AGSC-E315)" ;
    sh:severity sh:Warning .

ascs:Link-implements-target
    a sh:PropertyShape ;
    sh:path asc:implements ;
    sh:node [ sh:class asc:Concept ; sh:property [ sh:path asc:kind ; sh:in ( "spec" "pattern" "architecture" ) ] ] ;
    sh:message "the target of implements should be a concept of kind spec or pattern or architecture (AGSC-03-25, AGSC-E315)" ;
    sh:severity sh:Warning .

ascs:Link-verifies-target
    a sh:PropertyShape ;
    sh:path asc:verifies ;
    sh:or ( [ sh:class asc:Concept ; sh:property [ sh:path asc:kind ; sh:in ( "spec" "task" ) ] ] [ sh:class asc:Procedure ] [ sh:class asc:Gate ] ) ;
    sh:message "the target of verifies should be a concept of kind spec or task, or a procedure, or a gate (AGSC-03-25, AGSC-E315)" ;
    sh:severity sh:Warning .

ascs:Link-blocked-by-target
    a sh:PropertyShape ;
    sh:path asc:blockedBy ;
    sh:node [ sh:class asc:Concept ; sh:property [ sh:path asc:kind ; sh:in ( "task" ) ] ] ;
    sh:message "the target of blocked-by should be a concept of kind task (AGSC-03-25, AGSC-E315)" ;
    sh:severity sh:Warning .

ascs:Link-decided-by-target
    a sh:PropertyShape ;
    sh:path asc:decidedBy ;
    sh:node [ sh:class asc:Concept ; sh:property [ sh:path asc:kind ; sh:in ( "decision" ) ] ] ;
    sh:message "the target of decided-by should be a concept of kind decision (AGSC-03-25, AGSC-E315)" ;
    sh:severity sh:Warning .

ascs:LinkTargetsShape
    a sh:NodeShape ;
    sh:targetSubjectsOf skos:broader ;
    sh:targetSubjectsOf skos:narrower ;
    sh:targetSubjectsOf prov:wasDerivedFrom ;
    sh:targetSubjectsOf dcterms:replaces ;
    sh:targetSubjectsOf asc:implements ;
    sh:targetSubjectsOf asc:verifies ;
    sh:targetSubjectsOf asc:blockedBy ;
    sh:targetSubjectsOf asc:decidedBy ;
    sh:property ascs:Link-broader-target ;
    sh:property ascs:Link-narrower-target ;
    sh:property ascs:Link-derived-from-target ;
    sh:property ascs:Link-supersedes-target ;
    sh:property ascs:Link-implements-target ;
    sh:property ascs:Link-verifies-target ;
    sh:property ascs:Link-blocked-by-target ;
    sh:property ascs:Link-decided-by-target .

ascs:SelfLinkShape
    a sh:NodeShape ;
    sh:targetSubjectsOf skos:related ;
    sh:targetSubjectsOf asc:uses ;
    sh:targetSubjectsOf asc:excludes ;
    sh:targetSubjectsOf prov:wasDerivedFrom ;
    sh:targetSubjectsOf asc:contradicts ;
    sh:targetSubjectsOf dcterms:replaces ;
    sh:targetSubjectsOf asc:implements ;
    sh:targetSubjectsOf asc:verifies ;
    sh:targetSubjectsOf asc:covers ;
    sh:targetSubjectsOf asc:blockedBy ;
    sh:targetSubjectsOf asc:decidedBy ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "AGSC-E313: an item should not list itself under a Link key" ;
        sh:prefixes ascs:Prefixes ;
        sh:select """
        SELECT $this ?path ?value WHERE {
          $this ?path ?value .
          FILTER (?path IN (skos:related, asc:uses, asc:excludes, prov:wasDerivedFrom, asc:contradicts, dcterms:replaces, asc:implements, asc:verifies, asc:covers, asc:blockedBy, asc:decidedBy) && ?value = $this)
        }
        """
    ] ;
    sh:severity sh:Warning .

ascs:NoCycle-broader
    a sh:NodeShape ;
    sh:targetSubjectsOf skos:broader ;
    sh:targetSubjectsOf skos:narrower ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "AGSC-E303: broader and narrower form a cycle" ;
        sh:prefixes ascs:Prefixes ;
        sh:select """
        SELECT $this WHERE {
          $this (skos:broader|^skos:narrower)+ $this .
        }
        """
    ] .

ascs:NoCycle-requires
    a sh:NodeShape ;
    sh:targetSubjectsOf dcterms:requires ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "AGSC-E302: requires forms a cycle" ;
        sh:prefixes ascs:Prefixes ;
        sh:select """
        SELECT $this WHERE {
          $this dcterms:requires+ $this .
        }
        """
    ] .

# ------------------------------------------------------------
# Shapes from the SKOS integrity rules AGSC-05-17 to AGSC-05-21

ascs:Concept-inScheme
    a sh:PropertyShape ;
    sh:path skos:inScheme ;
    sh:minCount 1 ;
    sh:or ( [ sh:class asc:Bundle ] [ sh:class skos:ConceptScheme ] ) ;
    sh:message "a concept is in the scheme of the Bundle: one skos:inScheme to the Bundle (AGSC-05-17)" .

ascs:Concept-prefLabel
    a sh:PropertyShape ;
    sh:path skos:prefLabel ;
    sh:datatype rdf:langString ;
    sh:minCount 1 ;
    sh:uniqueLang true ;
    sh:message "a concept has a skos:prefLabel, exactly one for each language tag (AGSC-05-17)" .

ascs:Concept-altLabel
    a sh:PropertyShape ;
    sh:path skos:altLabel ;
    sh:datatype rdf:langString ;
    sh:message "an alias is a skos:altLabel with a language tag (AGSC-05-17)" .

ascs:Concept-noMember
    a sh:PropertyShape ;
    sh:path skos:member ;
    sh:maxCount 0 ;
    sh:message "a concept is not a collection and has no skos:member (AGSC-05-18, SKOS S37)" .

ascs:ConceptSkosShape
    a sh:NodeShape ;
    sh:targetClass asc:Concept ;
    sh:targetClass asc:Lesson ;
    sh:targetClass skos:Concept ;
    sh:property ascs:Concept-inScheme ;
    sh:property ascs:Concept-prefLabel ;
    sh:property ascs:Concept-altLabel ;
    sh:property ascs:Concept-noMember .

ascs:Collection-noBroader
    a sh:PropertyShape ;
    sh:path skos:broader ;
    sh:maxCount 0 ;
    sh:message "a collection has no skos:broader; nesting is skos:member (AGSC-05-19, AGSC-05-20)" .

ascs:Collection-noNarrower
    a sh:PropertyShape ;
    sh:path skos:narrower ;
    sh:maxCount 0 ;
    sh:message "a collection has no skos:narrower; nesting is skos:member (AGSC-05-19, AGSC-05-20)" .

ascs:Collection-noRelated
    a sh:PropertyShape ;
    sh:path skos:related ;
    sh:maxCount 0 ;
    sh:message "a collection has no skos:related; nesting is skos:member (AGSC-05-19, AGSC-05-20)" .

ascs:CollectionSkosShape
    a sh:NodeShape ;
    sh:targetClass asc:Cluster ;
    sh:targetClass skos:Collection ;
    sh:property ascs:Collection-noBroader ;
    sh:property ascs:Collection-noNarrower ;
    sh:property ascs:Collection-noRelated .

ascs:Relation-broader
    a sh:PropertyShape ;
    sh:path skos:broader ;
    sh:not [ sh:or ( [ sh:class asc:Cluster ] [ sh:class skos:Collection ] ) ] ;
    sh:message "the object of skos:broader is a concept, never a collection (AGSC-05-20)" .

ascs:Relation-narrower
    a sh:PropertyShape ;
    sh:path skos:narrower ;
    sh:not [ sh:or ( [ sh:class asc:Cluster ] [ sh:class skos:Collection ] ) ] ;
    sh:message "the object of skos:narrower is a concept, never a collection (AGSC-05-20)" .

ascs:Relation-related
    a sh:PropertyShape ;
    sh:path skos:related ;
    sh:not [ sh:or ( [ sh:class asc:Cluster ] [ sh:class skos:Collection ] ) ] ;
    sh:message "the object of skos:related is a concept, never a collection (AGSC-05-20)" .

ascs:SemanticRelationShape
    a sh:NodeShape ;
    sh:targetSubjectsOf skos:broader ;
    sh:targetSubjectsOf skos:narrower ;
    sh:targetSubjectsOf skos:related ;
    sh:property ascs:Relation-broader ;
    sh:property ascs:Relation-narrower ;
    sh:property ascs:Relation-related .

ascs:Definition-required
    a sh:PropertyShape ;
    sh:path skos:definition ;
    sh:minCount 1 ;
    sh:message "AGSC-E408: a concept or cluster has a skos:definition (AGSC-05-21, missing definitions; AGSC-02-21)" ;
    sh:severity sh:Warning .

ascs:DefinitionShape
    a sh:NodeShape ;
    sh:targetClass asc:Concept ;
    sh:targetClass asc:Lesson ;
    sh:targetClass skos:Concept ;
    sh:targetClass asc:Cluster ;
    sh:targetClass skos:Collection ;
    sh:property ascs:Definition-required .

ascs:UndefinedResourceShape
    a sh:NodeShape ;
    sh:targetClass asc:Concept ;
    sh:targetClass asc:Lesson ;
    sh:targetClass asc:Episode ;
    sh:targetClass asc:Procedure ;
    sh:targetClass asc:Cluster ;
    sh:targetClass asc:Gate ;
    sh:targetClass skos:Concept ;
    sh:targetClass skos:Collection ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "AGSC-E301: a Link points at a resource the graph does not define (AGSC-05-21, undefined resources)" ;
        sh:prefixes ascs:Prefixes ;
        sh:select """
        SELECT $this ?path ?value WHERE {
          $this ?path ?value .
          FILTER (?path IN (skos:broader, skos:narrower, skos:related, skos:member, skos:inScheme, skos:related, skos:broader, skos:narrower, asc:uses, dcterms:requires, dcterms:isRequiredBy, asc:excludes, prov:wasDerivedFrom, asc:contradicts, dcterms:replaces, dcterms:isReplacedBy, asc:implements, asc:verifies, asc:covers, asc:blockedBy, asc:decidedBy))
          FILTER NOT EXISTS { ?value a ?type }
        }
        """
    ] .

ascs:OrphanShape
    a sh:NodeShape ;
    sh:targetClass asc:Concept ;
    sh:targetClass asc:Lesson ;
    sh:targetClass asc:Episode ;
    sh:targetClass asc:Procedure ;
    sh:targetClass asc:Gate ;
    sh:targetClass skos:Concept ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "AGSC-E305: no item or collection points at this item (AGSC-05-21, missing in-links; AGSC-03-10)" ;
        sh:prefixes ascs:Prefixes ;
        sh:select """
        SELECT $this WHERE {
          FILTER NOT EXISTS { ?other ?link $this . FILTER (?other != $this && ?link NOT IN (asc:mentions, skos:hasTopConcept)) }
        }
        """
    ] ;
    sh:severity sh:Warning .
