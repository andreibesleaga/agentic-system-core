ascs:Item-status
    a sh:PropertyShape ;
    sh:path asc:status ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:in ( "draft" "stable" "deprecated" "retired" ) ;
    sh:message "asc:status must be one of draft, stable, deprecated, retired, at most one (AGSC-05-26, schema/item.schema.json)" .

