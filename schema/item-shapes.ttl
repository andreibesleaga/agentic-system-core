# schema/item-shapes.ttl — SHACL shapes for the RDF graph of an AgenticSystemCore node.
# GENERATED by tools/gen-shapes from schema/item.schema.json, spec/03-links.md and spec/05-graph.md
# (AGSC-05-24). Do not edit by hand: run `node tools/gen-shapes`. `--check` fails when this file is stale.
#
# INFORMATIVE. The engine's checks (`agsc lint`) are the normative ones; nothing here runs at build.
# SHACL 1.0 Core and SHACL-SPARQL (W3C Recommendation, 20 July 2017), SPARQL 1.1. The graph to
# check is `graph.nq` or `graph.ttl` of a build, or `skos.ttl` of `export --skos`. A shape with
# severity sh:Warning stands for a warning of `agsc lint`. Overlapping labels (AGSC-05-21) need
# Unicode case folding, which SPARQL does not have, and stay with the lint. The IRIs of the shapes
# name results; they are not dereferenceable.
@prefix asc: <https://w3id.org/agentic-system-core/ns#> .
@prefix ascs: <https://w3id.org/agentic-system-core/shapes#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ascs:Prefixes
    sh:declare [ sh:prefix "asc" ; sh:namespace "https://w3id.org/agentic-system-core/ns#"^^xsd:anyURI ] ,
        [ sh:prefix "dcterms" ; sh:namespace "http://purl.org/dc/terms/"^^xsd:anyURI ] ,
        [ sh:prefix "prov" ; sh:namespace "http://www.w3.org/ns/prov#"^^xsd:anyURI ] ,
        [ sh:prefix "skos" ; sh:namespace "http://www.w3.org/2004/02/skos/core#"^^xsd:anyURI ] .

