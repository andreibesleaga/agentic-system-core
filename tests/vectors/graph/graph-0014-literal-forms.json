{
  "area": "graph",
  "description": "The three literal forms and no other: a language-tagged prefLabel (no datatype), a typed xsd:dateTime retiredAt, and a plain xsd:string status written bare in Turtle and with an explicit ^^xsd:string in N-Quads; asc:status appears only because status is authored.",
  "expected": {
    "forbidden": [
      "\"Lit\"@en^^",
      "\"retired\"^^xsd:string in Turtle",
      "an asc:status triple when status is not authored"
    ],
    "nquads_lines": [
      "<https://a.example/concepts/lit/> <https://w3id.org/agentic-system-core/ns#retiredAt> \"2026-09-01T00:00:00Z\"^^<http://www.w3.org/2001/XMLSchema#dateTime> <https://a.example/> .",
      "<https://a.example/concepts/lit/> <https://w3id.org/agentic-system-core/ns#status> \"retired\"^^<http://www.w3.org/2001/XMLSchema#string> <https://a.example/> .",
      "<https://a.example/concepts/lit/> <http://www.w3.org/2004/02/skos/core#prefLabel> \"Lit\"@en <https://a.example/> ."
    ],
    "turtle_lines": [
      "<https://a.example/concepts/lit/> asc:retiredAt \"2026-09-01T00:00:00Z\"^^xsd:dateTime ;",
      "    asc:status \"retired\" ;",
      "    skos:prefLabel \"Lit\"@en ;"
    ]
  },
