          "@type": "http://www.w3.org/2001/XMLSchema#string"
        },
        "prov": "http://www.w3.org/ns/prov#",
        "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
        "retiredAt": {
          "@id": "asc:retiredAt",
          "@type": "http://www.w3.org/2001/XMLSchema#dateTime"
        },
        "schema": "https://schema.org/",
        "seeAlso": {
