        "accepted": false,
        "exit": 1,
        "findings": [
          {
            "code": "AGSC-E201",
            "path": "site.query_page",
            "severity": "error"
          }
        ],
        "name": "query-page-wrong-type"
      },
      {
        "accepted": false,
        "exit": 1,
