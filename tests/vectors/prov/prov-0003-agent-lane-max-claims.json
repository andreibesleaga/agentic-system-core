{
  "area": "prov",
  "description": "The work-in-progress limit: an agent lane holds at most max_claims tasks in TASK_STATE_WORKING (AGSC-10-17; default 1). The worker already holds task-a; its Proposal claiming task-b is rejected with AGSC-E511 before any lint runs. A Proposal that first completes task-a and then claims task-b is accepted.",
  "expected": {
    "results": [
      {
        "accepted": false,
        "error": "AGSC-E511",
        "findings": [
          {
            "agent": "worker",
            "code": "AGSC-E511",
            "held": 1,
            "max_claims": 1,
            "severity": "error"
          }
        ],
        "id": "claim-second"
      },
      {
        "accepted": true,
        "held_after": 1,
        "id": "finish-then-claim"
      }
    ]
  },
  "id": "prov-0003",
