{
  "area": "discovery",
  "description": "A Level-0 publisher — a CMS or wiki export with no engine — publishes the same RFC 9264 link set with every digest and every agsc-* target attribute omitted: it has no ledger, no graph.nq and no build instant, and Level 0 does not ask for one. There is no structural difference between Levels: linkset is the sole top-level member everywhere (AGSC-06-08a). Without this, no CMS export could ever be Level 0 and the D50 promise would fail at its first artefact. Supersedes disc-0002.",
  "expected": {
    "attributes_omitted": [
      "agsc-bundle-hash",
      "agsc-counts",
      "agsc-generated-at",
      "agsc-ledger-head",
      "agsc-spec-version",
      "digest"
    ],
    "level": 0,
    "media_type": "application/linkset+json",
    "path": "/.well-known/agentic-knowledge",
    "profile": "https://w3id.org/agentic-system-core/profile/agentic-knowledge",
    "top_level_members": [
      "linkset"
    ],
    "valid": true
  },
  "id": "disc-0004",
  "input": {
    "base": "https://example.org",
    "wellknown": {
      "linkset": [
        {
          "alternate": [
            {
              "href": "https://example.org/llms.txt",
              "type": "text/plain"
            }
          ],
          "anchor": "https://example.org/",
          "describedby": [
            {
              "href": "https://example.org/graph.jsonld",
              "type": "application/ld+json"
            }
          ],
          "license": [
            {
              "href": "https://example.org/legal/"
            }
          ]
        }
      ]
    }
  },
  "level": "required",
  "options": {
    "spec_version": "1.0.0-rc.2"
  },
  "rule": "AGSC-06-08a"
}
