# Line endings: every text file is stored and checked out with LF on every
# operating system. Conformance vectors, hash pins and generated pages are
# compared byte for byte, so a checkout must never turn LF into CRLF.
* text=auto eol=lf

# Binary files: never converted, never diffed as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.tgz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
